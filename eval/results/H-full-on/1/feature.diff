+import { expect, test } from "@playwright/test";
+import type { Page } from "@playwright/test";
+
+const SCROLLER = '[data-scroll-restoration-id="clients-table"]';
+const ROW_HEIGHT = 48;
+
+const listRequests = (page: Page) =>
+  page.evaluate(() => (window.__mocks?.getRequestLog() ?? []).filter((request) => request.path === "/api/agent/clients"));
+
+const rowAt = (page: Page, rowIndex: number) => page.locator(`[role="row"][aria-rowindex="${String(rowIndex)}"]`);
+
+test("прокрутка догружает следующие порции, в DOM не больше 60 строк", async ({ page }) => {
+  await page.goto("/clients");
+  await expect(rowAt(page, 1)).toBeVisible();
+  const scroller = page.locator(SCROLLER);
+
+  await expect
+    .poll(
+      async () => {
+        await scroller.evaluate((element) => {
+          element.scrollTop = element.scrollHeight;
+        });
+        return (await listRequests(page)).some((request) => "cursor" in request.params);
+      },
+      { timeout: 15_000 },
+    )
+    .toBe(true);
+
+  await expect(page.locator('[role="row"]')).not.toHaveCount(0);
+  expect(await page.locator('[role="row"]').count()).toBeLessThanOrEqual(60);
+});
+
+test("переход в карточку и «Назад» восстанавливают фильтры, строки без запроса и позицию прокрутки", async ({ page }) => {
+  await page.goto("/clients?sort=commissionKopecks:asc");
+  const scroller = page.locator(SCROLLER);
+  await expect(rowAt(page, 1)).toBeVisible();
+
+  await scroller.evaluate((element, offset) => {
+    element.scrollTop = offset;
+  }, 40 * ROW_HEIGHT);
+  await expect(rowAt(page, 41)).toBeInViewport();
+
+  const requestsBefore = (await listRequests(page)).length;
+  await rowAt(page, 41).click();
+  await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+
+  await page.getByRole("button", { name: "Назад" }).click();
+  await expect(page).toHaveURL(/sort=commissionKopecks/);
+  await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+  await expect(rowAt(page, 41)).toBeInViewport();
+  expect((await listRequests(page)).length).toBe(requestsBefore);
+});
+
+test("после перезагрузки восстанавливаются фильтры и сортировка", async ({ page }) => {
+  await page.goto("/clients?status=LEAD&sort=fullName:asc&q=Иванов");
+  await page.reload();
+
+  await expect(page).toHaveURL(/status=LEAD/);
+  await expect(page.getByRole("textbox", { name: "Поиск по ФИО" })).toHaveValue("Иванов");
+  await expect(page.getByRole("columnheader", { name: "ФИО" })).toHaveAttribute("aria-sort", "ascending");
+});
+
+test("ссылка с параметрами открывает то же состояние списка", async ({ page }) => {
+  await page.goto("/clients?q=Иванов");
+  await expect(rowAt(page, 1)).toContainText("Иванов");
+});
+
+test("поиск, введённый посимвольно, отправляет один запрос с полным значением", async ({ page }) => {
+  await page.goto("/clients");
+  await expect(rowAt(page, 1)).toBeVisible();
+
+  const input = page.getByRole("textbox", { name: "Поиск по ФИО" });
+  await input.pressSequentially("Иванов", { delay: 50 });
+  await expect(input).toHaveValue("Иванов");
+
+  await expect
+    .poll(async () => (await listRequests(page)).filter((request) => request.params.q === "Иванов").length, {
+      timeout: 5_000,
+    })
+    .toBe(1);
+});
