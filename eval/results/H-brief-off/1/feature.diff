+    expect(await findTable()).toBeInTheDocument();
+    expect(router.state.location.search).toMatchObject({ q: "Иванов", sort: "fullName:asc" });
+    expect(getRequestLog()).toHaveLength(requestsBeforeBack);
+  });
+});
