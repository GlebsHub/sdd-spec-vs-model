+import { describe, expect, it } from "vitest";
+import { CLIENT_SORT_FIELD, SORT_DIRECTION } from "@/shared/api";
+import { nextSort, toClientListParams, validateClientsSearch } from "./params";
+
+describe("validateClientsSearch", () => {
+  it("пустой адрес даёт пустой поиск", () => {
+    expect(validateClientsSearch({})).toEqual({});
+  });
+
+  it("сортировка по умолчанию не попадает в адрес", () => {
+    expect(validateClientsSearch({ sort: "registeredAt:desc" })).toEqual({});
+  });
+
+  it("сохраняет корректные значения как есть", () => {
+    expect(
+      validateClientsSearch({ q: "Иванов", status: "LEAD,FUNDED", from: "2026-01-01", to: "2026-03-31", sort: "commissionKopecks:asc" }),
+    ).toEqual({ q: "Иванов", status: "LEAD,FUNDED", from: "2026-01-01", to: "2026-03-31", sort: "commissionKopecks:asc" });
+  });
+
+  it("обрезает пробелы в поиске и отбрасывает пустой поиск", () => {
+    expect(validateClientsSearch({ q: "  Иванов " }).q).toBe("Иванов");
+    expect(validateClientsSearch({ q: "   " }).q).toBeUndefined();
+  });
+
+  it("отбрасывает неизвестные статусы и дубликаты, сохраняя корректные", () => {
+    expect(validateClientsSearch({ status: "LEAD,UNKNOWN,LEAD" }).status).toBe("LEAD");
+    expect(validateClientsSearch({ status: "BOGUS" }).status).toBeUndefined();
+  });
+
+  it("отбрасывает даты, которых не существует или в другом формате", () => {
+    expect(validateClientsSearch({ from: "2026-02-30" }).from).toBeUndefined();
+    expect(validateClientsSearch({ to: "01.02.2026" }).to).toBeUndefined();
+  });
+
+  it("отбрасывает некорректную сортировку", () => {
+    expect(validateClientsSearch({ sort: "phoneMasked:asc" }).sort).toBeUndefined();
+    expect(validateClientsSearch({ sort: "fullName:up" }).sort).toBeUndefined();
+    expect(validateClientsSearch({ sort: "fullName:asc:extra" }).sort).toBeUndefined();
+  });
+
+  it("не падает на мусоре во входе", () => {
+    expect(validateClientsSearch(null)).toEqual({});
+    expect(validateClientsSearch("garbage")).toEqual({});
+  });
+
+  it("число в параметре трактуется как строка", () => {
+    expect(validateClientsSearch({ q: 2026 }).q).toBe("2026");
+  });
+});
+
+describe("toClientListParams", () => {
+  it("поиск короче двух символов в запрос не попадает", () => {
+    expect(toClientListParams({ q: "И" }).q).toBeUndefined();
+    expect(toClientListParams({ q: "Ив" }).q).toBe("Ив");
+  });
+
+  it("статусы превращаются в массив, сортировка по умолчанию", () => {
+    expect(toClientListParams({ status: "LEAD,FUNDED" })).toEqual({
+      q: undefined,
+      status: ["LEAD", "FUNDED"],
+      dateFrom: undefined,
+      dateTo: undefined,
+      sort: { field: CLIENT_SORT_FIELD.registeredAt, direction: SORT_DIRECTION.desc },
+    });
+  });
+
+  it("даты передаются как есть, без пересчёта часового пояса", () => {
+    const params = toClientListParams({ from: "2026-01-01", to: "2026-03-31" });
+    expect(params.dateFrom).toBe("2026-01-01");
+    expect(params.dateTo).toBe("2026-03-31");
+  });
+});
+
+describe("nextSort", () => {
+  const registered = { field: CLIENT_SORT_FIELD.registeredAt, direction: SORT_DIRECTION.desc };
+
+  it("новая колонка сортируется по убыванию", () => {
+    expect(nextSort(registered, CLIENT_SORT_FIELD.commissionKopecks)).toEqual({
+      field: CLIENT_SORT_FIELD.commissionKopecks,
+      direction: SORT_DIRECTION.desc,
+    });
+  });
+
+  it("цикл на той же колонке: desc → asc → desc", () => {
+    const asc = nextSort(registered, CLIENT_SORT_FIELD.registeredAt);
+    expect(asc.direction).toBe(SORT_DIRECTION.asc);
+    expect(nextSort(asc, CLIENT_SORT_FIELD.registeredAt).direction).toBe(SORT_DIRECTION.desc);
+  });
+});
diff --git a/src/entities/clients/params.ts b/src/entities/clients/params.ts
new file mode 100644
index 0000000..7cab134
--- /dev/null
+++ b/src/entities/clients/params.ts
@@ -0,0 +1,122 @@
+import { z } from "zod";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+
+export const MIN_QUERY_LENGTH = 2;
+
+export type ClientSort = { field: ClientSortField; direction: SortDirection };
+
+export const DEFAULT_CLIENT_SORT: ClientSort = { field: CLIENT_SORT_FIELD.registeredAt, direction: SORT_DIRECTION.desc };
+
+/** Поиск в адресной строке: все значения — строки в том виде, в каком они хранятся в URL. */
+export type ClientsSearch = {
+  q?: string;
+  status?: string;
+  from?: string;
+  to?: string;
+  sort?: string;
+};
+
+export type ClientListParams = {
+  q: string | undefined;
+  status: ClientStatus[] | undefined;
+  dateFrom: string | undefined;
+  dateTo: string | undefined;
+  sort: ClientSort;
+};
+
+const TextParam = z
+  .preprocess((value) => (typeof value === "number" ? String(value) : value), z.string())
+  .optional()
+  .catch(undefined);
+
+const RawSearchSchema = z
+  .object({
+    q: TextParam,
+    status: TextParam,
+    from: TextParam,
+    to: TextParam,
+    sort: TextParam,
+  })
+  .catch({});
+
+const isStatus = (value: string): value is ClientStatus => Object.hasOwn(CLIENT_STATUS, value);
+const isSortField = (value: string): value is ClientSortField => Object.hasOwn(CLIENT_SORT_FIELD, value);
+const isDirection = (value: string): value is SortDirection => Object.hasOwn(SORT_DIRECTION, value);
+
+const isCalendarDate = (value: string): boolean => {
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!match) {
+    return false;
+  }
+  const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
+  return date.toISOString().slice(0, 10) === value;
+};
+
+const isDefaultSort = (sort: ClientSort): boolean =>
+  sort.field === DEFAULT_CLIENT_SORT.field && sort.direction === DEFAULT_CLIENT_SORT.direction;
+
+export const parseStatuses = (raw: string): ClientStatus[] => {
+  const statuses = raw.split(",").map((part) => part.trim()).filter(isStatus);
+  return [...new Set(statuses)];
+};
+
+export const toStatusParam = (statuses: ClientStatus[]): string | undefined =>
+  statuses.length > 0 ? statuses.join(",") : undefined;
+
+const parseSort = (raw: string): ClientSort | undefined => {
+  const [field = "", direction = "", ...extra] = raw.split(":");
+  if (extra.length > 0 || !isSortField(field) || !isDirection(direction)) {
+    return undefined;
+  }
+  return { field, direction };
+};
+
+/**
+ * Приводит параметры адресной строки к каноническому виду. Некорректные значения отбрасываются,
+ * значения по умолчанию не пишутся.
+ */
+export const validateClientsSearch = (raw: unknown): ClientsSearch => {
+  const { q, status, from, to, sort } = RawSearchSchema.parse(raw);
+
+  const trimmedQ = q?.trim();
+  const statuses = status === undefined ? [] : parseStatuses(status);
+  const parsedSort = sort === undefined ? undefined : parseSort(sort);
+
+  return {
+    q: trimmedQ ? trimmedQ : undefined,
+    status: toStatusParam(statuses),
+    from: from !== undefined && isCalendarDate(from) ? from : undefined,
+    to: to !== undefined && isCalendarDate(to) ? to : undefined,
+    sort: parsedSort === undefined ? undefined : toSortSearch(parsedSort),
+  };
+};
+
+export const toSortParam = (sort: ClientSort): string => `${sort.field}:${sort.direction}`;
+
+/** Значение `sort` для адреса: сортировка по умолчанию адрес не меняет. */
+export const toSortSearch = (sort: ClientSort): string | undefined =>
+  isDefaultSort(sort) ? undefined : toSortParam(sort);
+
+export const getClientSort = (search: ClientsSearch): ClientSort =>
+  (search.sort === undefined ? undefined : parseSort(search.sort)) ?? DEFAULT_CLIENT_SORT;
+
+/** Параметры запроса списка. Поиск короче MIN_QUERY_LENGTH в API не передаётся. */
+export const toClientListParams = (search: ClientsSearch): ClientListParams => {
+  const q = search.q !== undefined && search.q.length >= MIN_QUERY_LENGTH ? search.q : undefined;
+  return {
+    q,
+    status: search.status === undefined ? undefined : parseStatuses(search.status),
+    dateFrom: search.from,
+    dateTo: search.to,
+    sort: getClientSort(search),
+  };
+};
+
+/** Цикл п. 6: новая колонка → desc, desc → asc, asc → desc. */
+export const nextSort = (current: ClientSort, field: ClientSortField): ClientSort => {
+  if (current.field !== field) {
+    return { field, direction: SORT_DIRECTION.desc };
+  }
+  return { field, direction: current.direction === SORT_DIRECTION.desc ? SORT_DIRECTION.asc : SORT_DIRECTION.desc };
+};
