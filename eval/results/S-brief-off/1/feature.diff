+import { Tag, theme } from "antd";
+import { CLIENT_STATUS_LABEL, CLIENT_STATUS_TOKEN } from "./statusMeta";
+import type { ClientStatus } from "./types";
+
+export type ClientStatusTagProps = {
+  status: ClientStatus;
+};
+
+export const ClientStatusTag = ({ status }: ClientStatusTagProps) => {
+  const { token } = theme.useToken();
+  const color = token[CLIENT_STATUS_TOKEN[status]];
+  return (
+    <Tag variant="outlined" style={{ color, borderColor: color, background: "transparent", marginInlineEnd: 0 }}>
+      {CLIENT_STATUS_LABEL[status]}
+    </Tag>
+  );
+};
