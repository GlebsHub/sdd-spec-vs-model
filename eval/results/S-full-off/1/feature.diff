+import type { QueryClient } from "@tanstack/react-query";
+import { clientQueries, parseClientsSearch, toListParams } from "@/entities/client";
+import type { ClientsSearch } from "@/entities/client";
+
+/** Параметры адресной строки раздела: мусор заменяется значениями по умолчанию. */
+export const validateClientsSearch = (raw: Record<string, unknown>): ClientsSearch => parseClientsSearch(raw);
