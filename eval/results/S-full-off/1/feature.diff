+.root {
+  flex: 1 1 auto;
+  min-height: 0;
+}
+
+.title {
+  margin: 0;
+}
+
+.count {
+  margin-inline-start: 0.5em;
+  font-weight: normal;
+}
+
+.scroller {
+  flex: 1 1 0;
+  min-height: 320px;
+  overflow: auto;
+}
+
+.table {
+  display: grid;
+  width: 100%;
+  border-collapse: collapse;
+}
+
+.head {
+  display: grid;
+  position: sticky;
+  top: 0;
+  z-index: 1;
+}
+
+.body {
+  display: grid;
+  position: relative;
+}
+
+.row {
+  display: grid;
+  width: 100%;
+}
+
+.virtualRow {
+  position: absolute;
+  top: 0;
+  left: 0;
+  cursor: pointer;
+}
+
+.virtualRow:hover {
+  background: color-mix(in srgb, currentColor 6%, transparent);
+}
+
+.virtualRow:focus-visible {
+  outline-offset: -2px;
+}
+
+.cell {
+  display: flex;
+  align-items: center;
+  min-width: 0;
+  overflow: hidden;
+  text-align: start;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.right {
+  justify-content: flex-end;
+  text-align: end;
+}
+
+.sortButton {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.5em;
+  padding: 0;
+  border: 0;
+  background: none;
+  color: inherit;
+  font: inherit;
+  cursor: pointer;
+}
+
+.sortable {
+  cursor: pointer;
+}
+
+.footer {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 1em;
+}
+
+.state {
+  flex: 1 1 0;
+  min-height: 320px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
diff --git a/src/widgets/clients-table/ClientsTable.test.tsx b/src/widgets/clients-table/ClientsTable.test.tsx
