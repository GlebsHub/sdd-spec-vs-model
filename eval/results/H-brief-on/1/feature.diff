+import { describe, expect, it } from "vitest";
+import { DEFAULT_COLUMN_SETTINGS, columnSettingsKey, readColumnSettings, writeColumnSettings } from "./columnSettings";
+
+const AGENT = "agent-1";
+
+describe("настройки колонок в localStorage", () => {
+  it("без записи возвращает значения по умолчанию", () => {
+    expect(readColumnSettings(AGENT)).toEqual(DEFAULT_COLUMN_SETTINGS);
+  });
+
+  it("сохраняет и читает скрытые колонки и порядок", () => {
+    const settings = {
+      order: ["commission", "fullName", "phone", "status", "registeredAt"],
+      hidden: ["phone"],
+    } as const;
+    writeColumnSettings(AGENT, { order: [...settings.order], hidden: [...settings.hidden] });
+    expect(readColumnSettings(AGENT)).toEqual(settings);
+  });
+
+  it("настройки разных агентов не пересекаются", () => {
+    writeColumnSettings("agent-2", { order: [...DEFAULT_COLUMN_SETTINGS.order], hidden: ["status"] });
+    expect(readColumnSettings(AGENT)).toEqual(DEFAULT_COLUMN_SETTINGS);
+  });
+
+  it.each([
+    ["не JSON", "{не json"],
+    ["неверная форма", JSON.stringify({ order: "fullName", hidden: [] })],
+    ["неизвестная колонка", JSON.stringify({ order: ["fullName", "secret"], hidden: [] })],
+    ["порядок без части колонок", JSON.stringify({ order: ["fullName"], hidden: [] })],
+    ["скрыты все колонки", JSON.stringify({ order: [...DEFAULT_COLUMN_SETTINGS.order], hidden: [...DEFAULT_COLUMN_SETTINGS.order] })],
+  ])("невалидное значение (%s) заменяется значением по умолчанию", (_, raw) => {
+    window.localStorage.setItem(columnSettingsKey(AGENT), raw);
+    expect(readColumnSettings(AGENT)).toEqual(DEFAULT_COLUMN_SETTINGS);
+  });
+
+  it("ключ содержит версию и агента", () => {
+    expect(columnSettingsKey(AGENT)).toBe("clients-table-columns:v1:agent-1");
+  });
+
+  it("ошибка доступа к хранилищу не ломает чтение и запись", () => {
+    const original = Object.getOwnPropertyDescriptor(window, "localStorage");
+    Object.defineProperty(window, "localStorage", {
+      configurable: true,
+      get: () => {
+        throw new DOMException("denied", "SecurityError");
+      },
+    });
+    try {
+      expect(readColumnSettings(AGENT)).toEqual(DEFAULT_COLUMN_SETTINGS);
+      expect(() => {
+        writeColumnSettings(AGENT, DEFAULT_COLUMN_SETTINGS);
+      }).not.toThrow();
+    } finally {
+      if (original) {
+        Object.defineProperty(window, "localStorage", original);
+      }
+    }
+  });
+});
