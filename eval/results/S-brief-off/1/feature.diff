diff --git a/src/features/client-filters/useClientsFilters.ts b/src/features/client-filters/useClientsFilters.ts
new file mode 100644
index 0000000..41c6628
--- /dev/null
+++ b/src/features/client-filters/useClientsFilters.ts
@@ -0,0 +1,53 @@
+import { getRouteApi } from "@tanstack/react-router";
+import { useCallback, useMemo } from "react";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/entities/client";
+import { toClientListParams } from "./params";
+import { DEFAULT_SORT_DIRECTION, DEFAULT_SORT_FIELD } from "./schema";
+import type { ClientsSearch } from "./types";
+
+const routeApi = getRouteApi("/clients");
+
+/** Фильтры и сортировка списка клиентов. Единственный источник истины — параметры URL. */
+export const useClientsFilters = () => {
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+
+  const params = useMemo(() => toClientListParams(search), [search]);
+
+  const update = useCallback(
+    (patch: Partial<ClientsSearch>, replace = false) => {
+      void navigate({ search: (prev) => ({ ...prev, ...patch }), replace });
+    },
+    [navigate],
+  );
+
+  const setQuery = useCallback((q: string) => {
+    update({ q }, true);
+  }, [update]);
+
+  const setStatuses = useCallback((status: ClientStatus[]) => {
+    update({ status });
+  }, [update]);
+
+  const setDateRange = useCallback((dateFrom: string | undefined, dateTo: string | undefined) => {
+    update({ dateFrom, dateTo });
+  }, [update]);
+
+  const setSort = useCallback((sort: ClientSortField, dir: SortDirection) => {
+    update({ sort, dir });
+  }, [update]);
+
+  const reset = useCallback(() => {
+    void navigate({ search: {} });
+  }, [navigate]);
+
+  const hasActiveFilters =
+    search.q !== "" ||
+    search.status.length > 0 ||
+    search.dateFrom !== undefined ||
+    search.dateTo !== undefined ||
+    search.sort !== DEFAULT_SORT_FIELD ||
+    search.dir !== DEFAULT_SORT_DIRECTION;
+
+  return { search, params, hasActiveFilters, setQuery, setStatuses, setDateRange, setSort, reset };
+};
