+import { z } from "zod";
+import { CLIENT_COLUMN_FIXED, CLIENT_COLUMN_ORDER, defaultColumnVisibility } from "./columns";
+import type { ClientColumnId, ColumnVisibility } from "./columns";
+
+const STORAGE_PREFIX = "agent-cabinet:clients-columns:v1";
+
+const StoredSchema = z.object({ columns: z.record(z.string(), z.boolean()) });
+
+const storageKey = (agentId: string): string => `${STORAGE_PREFIX}:${agentId}`;
+
+/** Неизвестные и скрытые-нельзя колонки игнорируются, отсутствующие берутся по умолчанию. */
+export const readColumnVisibility = (agentId: string): ColumnVisibility => {
+  const defaults = defaultColumnVisibility();
+  try {
+    const raw = window.localStorage.getItem(storageKey(agentId));
+    if (raw === null) {
+      return defaults;
+    }
+    const parsed = StoredSchema.safeParse(JSON.parse(raw));
+    if (!parsed.success) {
+      return defaults;
+    }
+    const stored = parsed.data.columns;
+    const result = { ...defaults };
+    for (const id of CLIENT_COLUMN_ORDER) {
+      const value = stored[id];
+      if (id !== CLIENT_COLUMN_FIXED && typeof value === "boolean") {
+        result[id] = value;
+      }
+    }
+    return result;
+  } catch {
+    return defaults;
+  }
+};
+
+export const writeColumnVisibility = (agentId: string, visibility: ColumnVisibility): void => {
+  const columns: Partial<Record<ClientColumnId, boolean>> = {};
+  for (const id of CLIENT_COLUMN_ORDER) {
+    columns[id] = visibility[id];
+  }
+  try {
+    window.localStorage.setItem(storageKey(agentId), JSON.stringify({ columns }));
+  } catch {
+    return;
+  }
+};
