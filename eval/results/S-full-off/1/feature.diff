+import { useEffect, useRef, useState } from "react";
+import { parseClientsSearch } from "@/entities/client";
+
+const DEBOUNCE_MS = 300;
+
+const normalize = (text: string): string | undefined => parseClientsSearch({ q: text }).q;
+
+/**
+ * Текст поля поиска до debounce — локальное состояние (conventions, п. 4.1).
+ * В URL уходит значение длиной от 2 символов после trim, через 300 мс после последнего изменения.
+ * Когда URL меняется извне (сброс, «назад»), текст в поле подстраивается под него.
+ */
+export const useSearchInput = (applied: string | undefined, commit: (q: string | undefined) => void) => {
+  const [text, setText] = useState(applied ?? "");
+  const [isPending, setIsPending] = useState(false);
+  const [seenApplied, setSeenApplied] = useState(applied);
+  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  const latestApplied = useRef(applied);
+
+  useEffect(() => {
+    latestApplied.current = applied;
+  }, [applied]);
+
+  useEffect(
+    () => () => {
+      clearTimeout(timer.current);
+    },
+    [],
+  );
+
+  if (applied !== seenApplied) {
+    setSeenApplied(applied);
+    if (!isPending && applied !== normalize(text)) {
+      setText(applied ?? "");
+    }
+  }
+
+  const change = (value: string) => {
+    setText(value);
+    setIsPending(true);
+    clearTimeout(timer.current);
+    timer.current = setTimeout(() => {
+      setIsPending(false);
+      const next = normalize(value);
+      // Пустая навигация сбросила бы прокрутку и перезапустила loader без смены параметров.
+      if (next !== latestApplied.current) {
+        commit(next);
+      }
+    }, DEBOUNCE_MS);
+  };
+
+  const clear = () => {
+    clearTimeout(timer.current);
+    setIsPending(false);
+    setText("");
+  };
+
+  return { text, change, clear };
+};
