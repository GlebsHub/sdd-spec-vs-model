--- /dev/null
+++ b/src/entities/client/search.ts
@@ -0,0 +1,85 @@
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+import type { ClientSort, ClientsFilters } from "./types";
+
+const DEFAULT_SORT: ClientSort = { field: CLIENT_SORT_FIELD.registeredAt, direction: SORT_DIRECTION.desc };
+const MIN_QUERY_LENGTH = 2;
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+/** Параметры адресной строки в каноническом виде. Значения по умолчанию отсутствуют. */
+export type ClientsSearch = {
+  q?: string;
+  status?: string;
+  from?: string;
+  to?: string;
+  sort?: string;
+};
+
+const isStatus = (value: string): value is ClientStatus => Object.hasOwn(CLIENT_STATUS, value);
+const isSortField = (value: string): value is ClientSortField => Object.hasOwn(CLIENT_SORT_FIELD, value);
+const isDirection = (value: string): value is SortDirection => Object.hasOwn(SORT_DIRECTION, value);
+
+const isCalendarDate = (value: string): boolean => {
+  if (!DATE_RE.test(value)) {
+    return false;
+  }
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+};
+
+const parseSort = (value: string): ClientSort | undefined => {
+  const [field = "", direction = "", ...extra] = value.split(":");
+  if (extra.length > 0 || !isSortField(field) || !isDirection(direction)) {
+    return undefined;
+  }
+  return { field, direction };
+};
+
+const readText = (raw: Record<string, unknown>, key: string): string | undefined => {
+  const value = raw[key];
+  return typeof value === "string" ? value : undefined;
+};
+
+const readDate = (raw: Record<string, unknown>, key: string): string | undefined => {
+  const value = readText(raw, key);
+  return value !== undefined && isCalendarDate(value) ? value : undefined;
+};
+
+/**
+ * Валидация и нормализация параметров адреса. Некорректные значения отбрасываются,
+ * значение по умолчанию не записывается в адрес.
+ */
+export const parseClientsSearch = (raw: Record<string, unknown>): ClientsSearch => {
+  const statuses = [...new Set((readText(raw, "status") ?? "").split(","))].filter(isStatus).sort();
+  const sortText = readText(raw, "sort");
+  const sort = sortText === undefined ? undefined : parseSort(sortText);
+  const isDefaultSort = sort?.field === DEFAULT_SORT.field && sort.direction === DEFAULT_SORT.direction;
+
+  // Все ключи заданы явно: иначе роутер сохраняет исходное значение ключа, которого нет в результате.
+  return {
+    q: readText(raw, "q")?.trim() || undefined,
+    status: statuses.length > 0 ? statuses.join(",") : undefined,
+    from: readDate(raw, "from"),
+    to: readDate(raw, "to"),
+    sort: sort === undefined || isDefaultSort ? undefined : `${sort.field}:${sort.direction}`,
+  };
+};
+
+/** Фильтры для запроса к API. Поиск короче 2 символов в запрос не попадает. */
+export const toClientsFilters = (search: Partial<ClientsSearch>): ClientsFilters => {
+  const sort = search.sort === undefined ? undefined : parseSort(search.sort);
+  const statuses = search.status?.split(",").filter(isStatus) ?? [];
+  return {
+    q: search.q !== undefined && search.q.length >= MIN_QUERY_LENGTH ? search.q : undefined,
+    status: statuses.length > 0 ? statuses : undefined,
+    dateFrom: search.from,
+    dateTo: search.to,
+    sort: sort ?? DEFAULT_SORT,
+  };
+};
+
+export const hasActiveFilters = (filters: ClientsFilters): boolean =>
+  filters.q !== undefined ||
+  (filters.status !== undefined && filters.status.length > 0) ||
+  filters.dateFrom !== undefined ||
+  filters.dateTo !== undefined;
