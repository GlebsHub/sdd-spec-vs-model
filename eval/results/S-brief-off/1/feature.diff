+import { describe, expect, it, vi } from "vitest";
+import { columnSettingsKey, defaultColumnSettings, readColumnSettings, writeColumnSettings } from "./storage";
+
+const IDS = ["a", "b", "c"] as const;
+const KEY = columnSettingsKey("test", "agent-1");
+
+describe("настройки колонок в localStorage", () => {
+  it("ключ содержит версию и пользователя", () => {
+    expect(KEY).toBe("agent-cabinet:test:columns:v1:agent-1");
+  });
+
+  it("без сохранённых данных — значения по умолчанию", () => {
+    expect(readColumnSettings(KEY, IDS)).toEqual(defaultColumnSettings(IDS));
+  });
+
+  it("читает сохранённые видимость и порядок", () => {
+    writeColumnSettings(KEY, { visibility: { a: true, b: false, c: true }, order: ["c", "a", "b"] });
+    expect(readColumnSettings(KEY, IDS)).toEqual({ visibility: { a: true, b: false, c: true }, order: ["c", "a", "b"] });
+  });
+
+  it("неизвестные колонки отбрасываются, новые добавляются в конец и видимы", () => {
+    window.localStorage.setItem(KEY, JSON.stringify({ visibility: { a: false, gone: true }, order: ["gone", "b", "a"] }));
+    expect(readColumnSettings(KEY, IDS)).toEqual({ visibility: { a: false, b: true, c: true }, order: ["b", "a", "c"] });
+  });
+
+  it("битый JSON и данные не по схеме дают значения по умолчанию", () => {
+    window.localStorage.setItem(KEY, "{oops");
+    expect(readColumnSettings(KEY, IDS)).toEqual(defaultColumnSettings(IDS));
+    window.localStorage.setItem(KEY, JSON.stringify({ visibility: { a: "yes" }, order: "abc" }));
+    expect(readColumnSettings(KEY, IDS)).toEqual(defaultColumnSettings(IDS));
+  });
+
+  it("если все колонки скрыты, возвращаются значения по умолчанию", () => {
+    window.localStorage.setItem(KEY, JSON.stringify({ visibility: { a: false, b: false, c: false }, order: ["a", "b", "c"] }));
+    expect(readColumnSettings(KEY, IDS)).toEqual(defaultColumnSettings(IDS));
+  });
+
+  it("ошибка доступа к хранилищу не ломает чтение и запись", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    expect(readColumnSettings(KEY, IDS)).toEqual(defaultColumnSettings(IDS));
+    expect(() => {
+      writeColumnSettings(KEY, defaultColumnSettings(IDS));
+    }).not.toThrow();
+  });
+});
diff --git a/src/features/column-settings/storage.ts b/src/features/column-settings/storage.ts
new file mode 100644
index 0000000..974ed91
--- /dev/null
+++ b/src/features/column-settings/storage.ts
@@ -0,0 +1,50 @@
+import { ColumnSettingsSchema } from "./schema";
+import type { ColumnSettings } from "./types";
+
+/** Версия в ключе: при смене формата старые данные просто перестают читаться. */
+const STORAGE_VERSION = "v1";
+
+export const columnSettingsKey = (scope: string, userId: string): string =>
+  `agent-cabinet:${scope}:columns:${STORAGE_VERSION}:${userId}`;
+
+export const defaultColumnSettings = (columnIds: readonly string[]): ColumnSettings => ({
+  visibility: Object.fromEntries(columnIds.map((id) => [id, true])),
+  order: [...columnIds],
+});
+
+/**
+ * Приводит сохранённые настройки к актуальному набору колонок: неизвестные id отбрасываются,
+ * новые колонки добавляются в конец и видимы. Если не осталось видимых колонок — настройки по умолчанию.
+ */
+export const normalizeColumnSettings = (stored: ColumnSettings, columnIds: readonly string[]): ColumnSettings => {
+  const known = new Set(columnIds);
+  const storedOrder = [...new Set(stored.order)].filter((id) => known.has(id));
+  const order = [...storedOrder, ...columnIds.filter((id) => !storedOrder.includes(id))];
+  const visibility = Object.fromEntries(columnIds.map((id) => [id, stored.visibility[id] ?? true]));
+  if (!Object.values(visibility).some(Boolean)) {
+    return defaultColumnSettings(columnIds);
+  }
+  return { visibility, order };
+};
+
+export const readColumnSettings = (key: string, columnIds: readonly string[]): ColumnSettings => {
+  try {
+    const raw = window.localStorage.getItem(key);
+    if (raw === null) {
+      return defaultColumnSettings(columnIds);
+    }
+    const parsed = ColumnSettingsSchema.safeParse(JSON.parse(raw));
+    return parsed.success ? normalizeColumnSettings(parsed.data, columnIds) : defaultColumnSettings(columnIds);
+  } catch {
+    // Недоступное хранилище или битый JSON: работаем с настройками по умолчанию.
+    return defaultColumnSettings(columnIds);
+  }
+};
+
+export const writeColumnSettings = (key: string, settings: ColumnSettings): void => {
+  try {
+    window.localStorage.setItem(key, JSON.stringify(settings));
+  } catch {
+    // Настройки не сохранятся, но таблица продолжит работать.
+  }
+};
