+import { screen, waitFor } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { getRequestLog } from "@/mocks";
+import { renderApp } from "@/test";
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+const requestsWithQuery = (q: string) => getRequestLog().filter((request) => request.params["q"] === q);
+
+beforeEach(() => {
+  vi.spyOn(Element.prototype, "clientHeight", "get").mockReturnValue(600);
+});
+
+describe("фильтры клиентов", () => {
+  it("подписи полей доступны", async () => {
+    await renderApp({ url: "/clients" });
+    expect(screen.getByRole("textbox", { name: "Поиск по ФИО" })).toBeInTheDocument();
+    expect(screen.getByRole("combobox", { name: "Статус" })).toBeInTheDocument();
+    expect(screen.getByRole("group", { name: "Период регистрации" })).toBeInTheDocument();
+  });
+
+  it("AC-04: при посимвольном вводе «Иванов» уходит ровно один запрос с q=Иванов", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await waitFor(() => expect(getRequestLog()).toHaveLength(1));
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "Иванов");
+    await waitFor(() => expect(requestsWithQuery("Иванов")).toHaveLength(1));
+    await sleep(400);
+
+    expect(getRequestLog().filter((request) => request.params["q"] !== undefined)).toHaveLength(1);
+    expect(router.state.location.search).toMatchObject({ q: "Иванов" });
+  });
+
+  it("AC-04: поиск короче двух символов в запрос не попадает", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "И");
+    await sleep(400);
+    expect(getRequestLog().some((request) => request.params["q"] !== undefined)).toBe(false);
+  });
+
+  it("AC-05: фильтр по статусу передаётся в запрос, сортировка сохраняется при сбросе", async () => {
+    const { user, router } = await renderApp({ url: "/clients?sort=fullName:asc" });
+    await user.click(screen.getByRole("combobox", { name: "Статус" }));
+    await user.click(await screen.findByRole("option", { name: "Пополнил счёт" }));
+    await waitFor(() => expect(getRequestLog().at(-1)?.params["status"]).toBe("FUNDED"));
+    expect(getRequestLog().at(-1)?.params["sort"]).toBe("fullName:asc");
+
+    await user.click(screen.getByRole("button", { name: "Сбросить фильтры" }));
+    await waitFor(() => expect(router.state.location.search).toEqual({ sort: "fullName:asc" }));
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).toBeNull();
+  });
+
+  it("AC-05: кнопка «Сбросить фильтры» не видна без фильтров", async () => {
+    await renderApp({ url: "/clients" });
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).toBeNull();
+  });
+});
