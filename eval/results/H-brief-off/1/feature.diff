new file mode 100644
index 0000000..a7f2c74
--- /dev/null
+++ b/src/entities/client/useClients.ts
@@ -0,0 +1,26 @@
+import { keepPreviousData, useInfiniteQuery } from "@tanstack/react-query";
+import { useMemo } from "react";
+import { clientQueries } from "./queries";
+import type { ClientListFilters } from "./listParams";
+
+export const useClients = (filters: ClientListFilters) => {
+  const query = useInfiniteQuery({
+    ...clientQueries.list(filters),
+    placeholderData: keepPreviousData,
+  });
+  const { data, isPending, isError, refetch, fetchNextPage, hasNextPage, isFetchingNextPage, isFetchNextPageError } =
+    query;
+  const clients = useMemo(() => data?.pages.flatMap((page) => page.items) ?? [], [data]);
+
+  return {
+    clients,
+    total: data?.pages[0]?.total,
+    isPending,
+    isLoadFailed: isError && data === undefined,
+    isNextPageFailed: isFetchNextPageError,
+    hasNextPage,
+    isFetchingNextPage,
+    refetch,
+    fetchNextPage,
+  };
+};
