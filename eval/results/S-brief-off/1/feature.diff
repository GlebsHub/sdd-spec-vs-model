index 0000000..dedc1b1
--- /dev/null
+++ b/src/widgets/clients-table/ClientsTable.tsx
@@ -0,0 +1,313 @@
+import { CaretDownOutlined, CaretUpOutlined } from "@ant-design/icons";
+import { useNavigate, useElementScrollRestoration } from "@tanstack/react-router";
+import { flexRender, getCoreRowModel, useReactTable } from "@tanstack/react-table";
+import type { OnChangeFn, SortingState } from "@tanstack/react-table";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import { Alert, Button, Empty, Flex, Result, Spin, Typography, theme } from "antd";
+import { useEffect, useMemo, useRef } from "react";
+import type { KeyboardEvent } from "react";
+import { CLIENT_SORT_FIELD, useClients } from "@/entities/client";
+import { ClientFiltersPanel, useClientsFilters } from "@/features/client-filters";
+import { ColumnSettings, useColumnSettings } from "@/features/column-settings";
+import { COLUMN_IDS, columns, getColumnLayout } from "./columns";
+import styles from "./ClientsTable.module.css";
+import { CLIENTS_TABLE_SCROLL_ID } from "./scrollId";
+
+const COLUMN_SETTINGS_SCOPE = "clients-table";
+const ROW_HEIGHT = 56;
+const OVERSCAN = 10;
+/** За сколько строк до конца загруженного списка запрашивается следующая страница. */
+const FETCH_AHEAD_ROWS = 15;
+/** Первая строка данных в ARIA: строка 1 — заголовок. */
+const FIRST_DATA_ARIA_ROW = 2;
+
+const ARIA_SORT = { asc: "ascending", desc: "descending" } as const;
+
+export const ClientsTable = () => {
+  const { token } = theme.useToken();
+  const navigate = useNavigate();
+  const { search, params, hasActiveFilters, setSort, reset } = useClientsFilters();
+  const {
+    clients,
+    total,
+    isPending,
+    isError,
+    isFetching,
+    isFetchingNextPage,
+    isPlaceholderData,
+    hasNextPage,
+    fetchNextPage,
+    refetch,
+  } = useClients(params);
+  const settings = useColumnSettings({ scope: COLUMN_SETTINGS_SCOPE, columnIds: COLUMN_IDS });
+
+  const sorting = useMemo<SortingState>(() => [{ id: search.sort, desc: search.dir === "desc" }], [search.sort, search.dir]);
+
+  const onSortingChange: OnChangeFn<SortingState> = (updater) => {
+    const next = typeof updater === "function" ? updater(sorting) : updater;
+    const first = next[0];
+    const field = Object.values(CLIENT_SORT_FIELD).find((value) => value === first?.id);
+    if (first && field) {
+      setSort(field, first.desc ? "desc" : "asc");
+    }
+  };
+
+  const table = useReactTable({
+    data: clients,
+    columns,
+    state: { sorting, columnVisibility: settings.columnVisibility, columnOrder: settings.columnOrder },
+    manualSorting: true,
+    manualFiltering: true,
+    enableSortingRemoval: false,
+    enableMultiSort: false,
+    getRowId: (client) => client.id,
+    getCoreRowModel: getCoreRowModel(),
+    onSortingChange,
+    onColumnVisibilityChange: settings.onColumnVisibilityChange,
+    onColumnOrderChange: settings.onColumnOrderChange,
+  });
+
+  const rows = table.getRowModel().rows;
+  const gridTemplateColumns = table
+    .getVisibleLeafColumns()
+    .map((column) => getColumnLayout(column.id).width)
+    .join(" ");
+
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const scrollEntry = useElementScrollRestoration({ id: CLIENTS_TABLE_SCROLL_ID });
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: OVERSCAN,
+    initialOffset: scrollEntry?.scrollY,
+  });
+  const virtualItems = virtualizer.getVirtualItems();
+  const lastVisibleIndex = virtualItems.at(-1)?.index;
+
+  useEffect(() => {
+    if (lastVisibleIndex === undefined) {
+      return;
+    }
+    const isNearEnd = lastVisibleIndex >= rows.length - FETCH_AHEAD_ROWS;
+    if (isNearEnd && hasNextPage && !isFetchingNextPage && !isError) {
+      void fetchNextPage();
+    }
+  }, [lastVisibleIndex, rows.length, hasNextPage, isFetchingNextPage, isError, fetchNextPage]);
+
+  const openClient = (clientId: string) => {
+    void navigate({ to: "/clients/$clientId", params: { clientId } });
+  };
+
+  const onRowKeyDown = (event: KeyboardEvent<HTMLDivElement>, clientId: string) => {
+    if (event.key === "Enter") {
+      openClient(clientId);
+    }
+  };
+
+  const hasRows = clients.length > 0;
+  const isLoading = isPending || (isPlaceholderData && !hasRows);
+  const isFailed = isError && !hasRows;
+  const isEmpty = !isLoading && !isFailed && !hasRows && !isFetching;
+
+  const columnItems = settings.columnOrder.map((id) => ({
+    id,
+    label: getColumnLayout(id).label,
+    visible: settings.columnVisibility[id] ?? true,
+  }));
+
+  const retryNextPage = () => {
+    if (hasNextPage) {
+      void fetchNextPage();
+    } else {
+      void refetch();
+    }
+  };
+
+  const renderState = () => {
+    if (isLoading) {
+      return (
+        <Flex vertical align="center" justify="center" gap="small" className={styles.state} role="status">
+          <Spin size="large" />
+          <Typography.Text type="secondary">Загрузка клиентов…</Typography.Text>
+        </Flex>
+      );
+    }
+    if (isFailed) {
+      return (
+        <Result
+          status="error"
+          title="Не удалось загрузить клиентов"
+          subTitle="Проверьте соединение и повторите попытку"
+          extra={
+            <Button
+              type="primary"
+              onClick={() => {
+                void refetch();
+              }}
+            >
+              Повторить
+            </Button>
+          }
+        />
+      );
+    }
+    if (isEmpty) {
+      return (
+        <Flex align="center" justify="center" className={styles.state}>
+          <Empty
+            description={hasActiveFilters ? "По заданным условиям клиентов не найдено" : "У вас пока нет клиентов"}
+          >
+            {hasActiveFilters && <Button onClick={reset}>Сбросить фильтры</Button>}
+          </Empty>
+        </Flex>
+      );
+    }
+    return undefined;
+  };
+
+  const stateView = renderState();
+
+  return (
+    <Flex vertical gap="middle" className={styles.root}>
+      <ClientFiltersPanel
+        extra={
+          <ColumnSettings
+            items={columnItems}
+            onToggle={settings.toggle}
+            onMove={settings.move}
+            onReset={settings.reset}
+          />
+        }
+      />
+      {!isLoading && !isFailed && (
+        <Typography.Text type="secondary">Найдено клиентов: {total}</Typography.Text>
+      )}
+      <div
+        ref={scrollRef}
+        data-scroll-restoration-id={CLIENTS_TABLE_SCROLL_ID}
+        className={styles.scroll}
+        style={{
+          background: token.colorBgContainer,
+          border: `${String(token.lineWidth)}px ${token.lineType} ${token.colorBorderSecondary}`,
+          borderRadius: token.borderRadiusLG,
+        }}
+      >
+        {stateView ?? (
+          <div
+            role="table"
+            aria-label="Клиенты"
+            aria-rowcount={total + 1}
+            aria-busy={isPlaceholderData}
+            className={styles.table}
+            style={{ opacity: isPlaceholderData ? token.opacityLoading : 1 }}
+          >
+            <div
+              role="rowgroup"
+              className={styles.head}
+              style={{ background: token.colorBgContainer, borderBottom: `${String(token.lineWidth)}px ${token.lineType} ${token.colorBorderSecondary}` }}
+            >
+              {table.getHeaderGroups().map((headerGroup) => (
+                <div
+                  key={headerGroup.id}
+                  role="row"
+                  aria-rowindex={1}
+                  className={styles.row}
+                  style={{ gridTemplateColumns, height: ROW_HEIGHT }}
+                >
+                  {headerGroup.headers.map((header) => {
+                    const { column } = header;
+                    const sortState = column.getIsSorted();
+                    const alignEnd = getColumnLayout(column.id).alignEnd;
+                    return (
+                      <div
+                        key={header.id}
+                        role="columnheader"
+                        aria-sort={column.getCanSort() ? (sortState ? ARIA_SORT[sortState] : "none") : undefined}
+                        className={alignEnd ? styles.headerEnd : undefined}
+                      >
+                        {column.getCanSort() ? (
+                          <Button type="text" onClick={column.getToggleSortingHandler()}>
+                            {flexRender(column.columnDef.header, header.getContext())}
+                            {sortState === "asc" && <CaretUpOutlined aria-hidden />}
+                            {sortState === "desc" && <CaretDownOutlined aria-hidden />}
+                          </Button>
+                        ) : (
+                          <Typography.Text strong>{flexRender(column.columnDef.header, header.getContext())}</Typography.Text>
+                        )}
+                      </div>
+                    );
+                  })}
+                </div>
+              ))}
+            </div>
+            <div role="rowgroup" className={styles.body} style={{ height: virtualizer.getTotalSize() }}>
+              {virtualItems.map((virtualItem) => {
+                const row = rows[virtualItem.index];
+                if (!row) {
+                  return null;
+                }
+                return (
+                  <div
+                    key={row.id}
+                    role="row"
+                    tabIndex={0}
+                    aria-rowindex={virtualItem.index + FIRST_DATA_ARIA_ROW}
+                    className={`${styles.row} ${styles.bodyRow}`}
+                    style={{
+                      gridTemplateColumns,
+                      height: ROW_HEIGHT,
+                      transform: `translateY(${String(virtualItem.start)}px)`,
+                      borderBottom: `${String(token.lineWidth)}px ${token.lineType} ${token.colorSplit}`,
+                    }}
+                    onClick={() => {
+                      openClient(row.original.id);
+                    }}
+                    onKeyDown={(event) => {
+                      onRowKeyDown(event, row.original.id);
+                    }}
+                  >
+                    {row.getVisibleCells().map((cell) => (
+                      <div
+                        key={cell.id}
+                        role="cell"
+                        className={`${styles.cell} ${getColumnLayout(cell.column.id).alignEnd ? styles.cellEnd : ""}`}
+                      >
+                        {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                      </div>
+                    ))}
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+        )}
+        {stateView === undefined && (
+          <Flex justify="center" align="center" gap="small" style={{ padding: token.paddingMD }}>
+            {isFetchingNextPage && (
+              <Flex align="center" gap="small" role="status">
+                <Spin size="small" />
+                <Typography.Text type="secondary">Загружаем ещё…</Typography.Text>
+              </Flex>
+            )}
+            {isError && hasRows && (
+              <Alert
+                type="error"
+                showIcon
+                title="Не удалось загрузить следующих клиентов"
+                action={
+                  <Button size="small" onClick={retryNextPage}>
+                    Повторить
+                  </Button>
+                }
+              />
+            )}
+            {!hasNextPage && !isError && !isPlaceholderData && !isFetchingNextPage && (
+              <Typography.Text type="secondary">Показаны все клиенты</Typography.Text>
+            )}
+          </Flex>
+        )}
+      </div>
+    </Flex>
+  );
+};
