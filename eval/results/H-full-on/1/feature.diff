@@ -0,0 +1,69 @@
+import type { VisibilityState } from "@tanstack/react-table";
+import { useState } from "react";
+import { z } from "zod";
+import { useCurrentAgent } from "@/shared/lib/session";
+
+export type ColumnVisibilityOption = {
+  id: string;
+  hideable: boolean;
+  defaultVisible: boolean;
+};
+
+const STORAGE_VERSION = "v1";
+const StoredVisibilitySchema = z.record(z.string(), z.boolean());
+
+const storageKey = (agentId: string): string => `clients-columns:${STORAGE_VERSION}:${agentId}`;
+
+const defaultVisibility = (columns: readonly ColumnVisibilityOption[]): VisibilityState =>
+  Object.fromEntries(columns.map((column) => [column.id, column.defaultVisible]));
+
+const readVisibility = (key: string, columns: readonly ColumnVisibilityOption[]): VisibilityState => {
+  const defaults = defaultVisibility(columns);
+  try {
+    const raw = window.localStorage.getItem(key);
+    if (raw === null) {
+      return defaults;
+    }
+    const stored = StoredVisibilitySchema.safeParse(JSON.parse(raw));
+    if (!stored.success) {
+      return defaults;
+    }
+    return Object.fromEntries(
+      columns.map((column) => {
+        const value = stored.data[column.id];
+        return [column.id, !column.hideable || value === undefined ? column.defaultVisible : value];
+      }),
+    );
+  } catch {
+    return defaults;
+  }
+};
+
+const writeVisibility = (key: string, visibility: VisibilityState): void => {
+  try {
+    window.localStorage.setItem(key, JSON.stringify(visibility));
+  } catch {
+    // Недоступное хранилище не должно ломать таблицу: настройка действует до перезагрузки.
+  }
+};
+
+/** Видимость колонок конкретного агента в localStorage. Колонки без права скрытия всегда видимы. */
+export const useColumnVisibility = (columns: readonly ColumnVisibilityOption[]) => {
+  const { id: agentId } = useCurrentAgent();
+  const key = storageKey(agentId);
+  const [visibility, setVisibility] = useState(() => readVisibility(key, columns));
+
+  const toggle = (columnId: string, visible: boolean): void => {
+    const next = { ...visibility, [columnId]: visible };
+    setVisibility(next);
+    writeVisibility(key, next);
+  };
+
+  const reset = (): void => {
+    const next = defaultVisibility(columns);
+    setVisibility(next);
+    writeVisibility(key, next);
+  };
+
+  return { visibility, toggle, reset };
+};
