+import { http } from "@/shared/api";
+import { ClientListResponseSchema } from "./schema";
+import type { ClientListParams } from "./types";
+
+export const CLIENTS_PAGE_SIZE = 50;
+
+type FetchClientsPageOptions = {
+  params: ClientListParams;
+  /** Курсор следующей страницы; для первой страницы не передаётся. */
+  cursor: string | undefined;
+  signal?: AbortSignal;
+};
+
+export const fetchClientsPage = ({ params, cursor, signal }: FetchClientsPageOptions) =>
+  http.get("/agent/clients", {
+    schema: ClientListResponseSchema,
+    signal,
