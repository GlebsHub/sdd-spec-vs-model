+import { useState } from "react";
+import { z } from "zod";
+import { useCurrentAgent } from "@/shared/lib/session";
+
+const STORAGE_VERSION = 1;
+
+const StoredSettingsSchema = z.object({ hidden: z.array(z.string()) });
+
+type UseColumnVisibilityOptions = {
+  /** Колонки, которые агент может скрыть. Остальные (например, «ФИО») всегда видны. */
+  columnIds: readonly string[];
+  defaultHidden: readonly string[];
+};
+
+const storageKey = (agentId: string): string => `clients-columns:v${String(STORAGE_VERSION)}:${agentId}`;
+
+const readHidden = (key: string, columnIds: readonly string[]): string[] | undefined => {
+  try {
+    const raw = window.localStorage.getItem(key);
+    if (raw === null) {
+      return undefined;
+    }
+    const parsed = StoredSettingsSchema.safeParse(JSON.parse(raw));
+    if (!parsed.success || !parsed.data.hidden.every((id) => columnIds.includes(id))) {
+      return undefined;
+    }
+    return parsed.data.hidden;
+  } catch {
+    return undefined;
+  }
+};
+
+const writeHidden = (key: string, hidden: readonly string[]): void => {
+  try {
+    window.localStorage.setItem(key, JSON.stringify({ hidden }));
+  } catch {
+    // Недоступное хранилище не должно ломать таблицу: настройка действует до перезагрузки.
+  }
+};
+
+const removeHidden = (key: string): void => {
+  try {
+    window.localStorage.removeItem(key);
+  } catch {
+    // См. writeHidden.
+  }
+};
+
+/** Скрытые колонки текущего агента на этом устройстве. Порядок колонок фиксирован. */
+export const useColumnVisibility = ({ columnIds, defaultHidden }: UseColumnVisibilityOptions) => {
+  const { id: agentId } = useCurrentAgent();
+  const key = storageKey(agentId);
+  const [hidden, setHidden] = useState<readonly string[]>(
+    () => readHidden(key, columnIds) ?? [...defaultHidden],
+  );
+
+  const setVisible = (id: string, visible: boolean): void => {
+    if (!columnIds.includes(id)) {
+      return;
+    }
+    const next = visible ? hidden.filter((hiddenId) => hiddenId !== id) : [...new Set([...hidden, id])];
+    setHidden(next);
+    writeHidden(key, next);
+  };
+
+  const reset = (): void => {
+    setHidden([...defaultHidden]);
+    removeHidden(key);
+  };
+
+  return { hidden, setVisible, reset };
+};
