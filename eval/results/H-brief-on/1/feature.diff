index 0000000..894b516
--- /dev/null
+++ b/src/features/client-filters/clientsSearch.ts
@@ -0,0 +1,80 @@
+import { z } from "zod";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+import type { ClientListParams } from "@/entities/client";
+
+export const MIN_SEARCH_LENGTH = 2;
+
+const DEFAULT_SORT_FIELD = CLIENT_SORT_FIELD.registeredAt;
+const DEFAULT_SORT_DIRECTION = SORT_DIRECTION.desc;
+
+export const clientsSearchDefaults = {
+  q: "",
+  status: "",
+  dateFrom: "",
+  dateTo: "",
+  sort: `${DEFAULT_SORT_FIELD}:${DEFAULT_SORT_DIRECTION}`,
+};
+
+const isClientStatus = (value: string): value is ClientStatus =>
+  (Object.values(CLIENT_STATUS) as string[]).includes(value);
+const isSortField = (value: string): value is ClientSortField =>
+  (Object.values(CLIENT_SORT_FIELD) as string[]).includes(value);
+const isSortDirection = (value: string): value is SortDirection =>
+  (Object.values(SORT_DIRECTION) as string[]).includes(value);
+
+const isCalendarDate = (value: string): boolean => {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    return false;
+  }
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+};
+
+const CalendarDateParamSchema = z.string().refine(isCalendarDate).optional().catch(undefined);
+
+/** Параметры URL. Некорректное значение становится отсутствующим, все поля необязательны, чтобы ссылки можно было строить без параметров. */
+const ClientsSearchSchema = z.object({
+  q: z.string().optional().catch(undefined),
+  status: z.string().optional().catch(undefined),
+  dateFrom: CalendarDateParamSchema,
+  dateTo: CalendarDateParamSchema,
+  sort: z.string().optional().catch(undefined),
+});
+
+export type ClientsSearch = z.infer<typeof ClientsSearchSchema>;
+
+export const parseStatusParam = (value: string): ClientStatus[] => [
+  ...new Set(value.split(",").filter(isClientStatus)),
+];
+
+export const parseSortParam = (value: string): { field: ClientSortField; direction: SortDirection } => {
+  const [field = "", direction = ""] = value.split(":");
+  if (isSortField(field) && isSortDirection(direction)) {
+    return { field, direction };
+  }
+  return { field: DEFAULT_SORT_FIELD, direction: DEFAULT_SORT_DIRECTION };
+};
+
+/** Приводит параметры адреса к допустимым значениям: мусор в статусах и сортировке отбрасывается. */
+export const validateClientsSearch = (search: Record<string, unknown>): ClientsSearch => {
+  const parsed = ClientsSearchSchema.parse(search);
+  const { field, direction } = parseSortParam(parsed.sort ?? "");
+  return {
+    ...parsed,
+    status: parseStatusParam(parsed.status ?? "").join(","),
+    sort: `${field}:${direction}`,
+  };
+};
+
+export const toClientListParams = (search: ClientsSearch): ClientListParams => {
+  const q = (search.q ?? "").trim();
+  const status = parseStatusParam(search.status ?? "");
+  return {
+    q: q.length >= MIN_SEARCH_LENGTH ? q : undefined,
+    status: status.length > 0 ? status : undefined,
+    dateFrom: search.dateFrom || undefined,
+    dateTo: search.dateTo || undefined,
+    sort: parseSortParam(search.sort ?? ""),
+  };
+};
