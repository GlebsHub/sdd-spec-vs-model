+import { screen, waitFor, within } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import { MOCK_SCENARIO, getRequestLog, setMockScenario } from "@/mocks";
+import { formatMoney } from "@/shared/lib/money";
+import { renderApp } from "@/test";
+
+/** В jsdom нет раскладки: задаём высоту скролл-контейнера, чтобы виртуализатор отрисовал строки. */
+const mockViewport = () => vi.spyOn(Element.prototype, "clientHeight", "get").mockReturnValue(480);
+
+const dataRows = () => screen.getAllByRole("row").filter((row) => row.hasAttribute("aria-rowindex"));
+
+const rowAt = (rowIndex: number) => dataRows().find((row) => row.getAttribute("aria-rowindex") === String(rowIndex));
+
+/** Строковый матчер Testing Library не нормализует неразрывные пробелы, поэтому приводим их к обычным. */
+const moneyText = (kopecks: number) => formatMoney(kopecks).replace(/\s/g, " ");
+
+describe("раздел «Мои клиенты»", () => {
+  it("загружает первые 50 клиентов по дате регистрации, показывает колонки и суммы", async () => {
+    mockViewport();
+    await renderApp();
+
+    expect(await screen.findByRole("heading", { name: "Мои клиенты" })).toBeInTheDocument();
+    expect(await screen.findByText("10000")).toBeInTheDocument();
+    const headers = screen.getAllByRole("columnheader").map((header) => header.textContent);
+    expect(headers).toEqual(["ФИО", "Телефон", "Статус", "Дата регистрации", "Комиссия"]);
+
+    expect(await screen.findByText(moneyText(1_234_567), undefined, { timeout: 5000 })).toBeInTheDocument();
+    expect(rowAt(2)).toHaveTextContent(moneyText(5));
+    expect(rowAt(3)).toHaveTextContent(moneyText(0));
+
+    expect(getRequestLog()[0]?.params).toMatchObject({ limit: "50", sort: "registeredAt:desc" });
+    expect(getRequestLog()[0]?.params).not.toHaveProperty("cursor");
+    expect(dataRows().length).toBeLessThanOrEqual(60);
+  }, 15_000);
+
+  it("поиск из двух символов и больше отправляет один запрос после ввода", async () => {
+    mockViewport();
+    const { user } = await renderApp();
+    await screen.findByRole("columnheader", { name: "ФИО" });
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "Иванов");
+
+    await waitFor(() => {
+      expect(getRequestLog().some((request) => request.params.q === "Иванов")).toBe(true);
+    });
+    expect(getRequestLog().filter((request) => request.params.q !== undefined)).toHaveLength(1);
+  });
+
+  it("фильтр по статусу уходит в запрос, «Сбросить фильтры» снимает фильтры и сохраняет сортировку", async () => {
+    mockViewport();
+    const { user } = await renderApp();
+    await screen.findByRole("columnheader", { name: "ФИО" });
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument();
+
+    await user.click(screen.getByRole("button", { name: "Комиссия" }));
+    await user.click(screen.getByRole("combobox", { name: "Статус" }));
+    await user.click(await screen.findByRole("option", { name: "Пополнил счёт" }));
+
+    await waitFor(() => {
+      expect(getRequestLog().at(-1)?.params).toMatchObject({ status: "FUNDED", sort: "commissionKopecks:desc" });
+    });
+
+    await user.click(screen.getByRole("button", { name: "Сбросить фильтры" }));
+
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument();
+    expect(screen.getByRole("combobox", { name: "Статус" })).not.toHaveTextContent("Пополнил счёт");
+    expect(screen.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "descending");
+  });
+
+  it("клик по заголовку переключает сортировку desc → asc и отражает её в aria-sort", async () => {
+    mockViewport();
+    const { user } = await renderApp();
+    await screen.findByRole("columnheader", { name: "ФИО" });
+
+    const commission = screen.getByRole("columnheader", { name: "Комиссия" });
+    await user.click(within(commission).getByRole("button", { name: "Комиссия" }));
+    expect(screen.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "descending");
+    await waitFor(() => {
+      expect(getRequestLog().at(-1)?.params).toMatchObject({ sort: "commissionKopecks:desc" });
+    });
+
+    await user.click(screen.getByRole("button", { name: "Комиссия" }));
+    expect(screen.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+    await waitFor(() => {
+      expect(getRequestLog().at(-1)?.params).toMatchObject({ sort: "commissionKopecks:asc" });
+    });
+  });
+
+  it("адрес с параметрами применяет фильтры и сортировку", async () => {
+    mockViewport();
+    await renderApp({ url: "/clients?q=Иванов&status=LEAD,FUNDED&sort=fullName:asc" });
+
+    expect(await screen.findByRole("textbox", { name: "Поиск по ФИО" })).toHaveValue("Иванов");
+    await waitFor(() => {
+      expect(getRequestLog()[0]?.params).toMatchObject({ q: "Иванов", status: "FUNDED,LEAD", sort: "fullName:asc" });
+    });
+  });
+
+  it("некорректные параметры адреса игнорируются, применяются значения по умолчанию", async () => {
+    mockViewport();
+    await renderApp({ url: "/clients?status=BOGUS&sort=bogus:asc&from=2026-02-30" });
+
+    await screen.findByRole("columnheader", { name: "ФИО" });
+    expect(getRequestLog()[0]?.params).toMatchObject({ sort: "registeredAt:desc" });
+    expect(getRequestLog()[0]?.params).not.toHaveProperty("status");
+    expect(getRequestLog()[0]?.params).not.toHaveProperty("dateFrom");
+  });
+
+  it("ошибка первой порции показывает сообщение, «Повторить» повторяет запрос", async () => {
+    mockViewport();
+    setMockScenario({ scenario: MOCK_SCENARIO.errorFirstPage, failTimes: 1 });
+    const { user } = await renderApp();
+
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    expect(await screen.findByRole("columnheader", { name: "ФИО" })).toBeInTheDocument();
+  });
+
+  it("пустой список без фильтров показывает приглашение поделиться ссылкой", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp();
+
+    expect(
+      await screen.findByText("У вас пока нет клиентов. Поделитесь реферальной ссылкой, чтобы пригласить первого"),
+    ).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument();
+  });
+
+  it("пустой результат с фильтрами показывает «Ничего не найдено» и сброс", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp({ url: "/clients?q=Иванов" });
+
+    expect(await screen.findByText("Ничего не найдено")).toBeInTheDocument();
+    expect(screen.getAllByRole("button", { name: "Сбросить фильтры" })).not.toHaveLength(0);
+  });
+
+  it("403 показывает состояние «Нет доступа»", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.forbidden });
+    await renderApp();
+
+    expect(
+      await screen.findByText("Раздел недоступен. Обратитесь к персональному менеджеру"),
+    ).toBeInTheDocument();
+  });
+
+  it("колонки скрываются, ФИО скрыть нельзя, настройка переживает перезагрузку, «По умолчанию» сбрасывает", async () => {
+    mockViewport();
+    const first = await renderApp();
+    await screen.findByRole("columnheader", { name: "ФИО" });
+
+    await first.user.click(screen.getByRole("button", { name: "Настроить колонки" }));
+    expect(await screen.findByRole("checkbox", { name: "ФИО" })).toBeDisabled();
+    await first.user.click(screen.getByRole("checkbox", { name: "Телефон" }));
+    expect(screen.queryByRole("columnheader", { name: "Телефон" })).not.toBeInTheDocument();
+    first.unmount();
+
+    const reloaded = await renderApp();
+    await screen.findByRole("columnheader", { name: "ФИО" });
+    expect(screen.queryByRole("columnheader", { name: "Телефон" })).not.toBeInTheDocument();
+
+    await reloaded.user.click(screen.getByRole("button", { name: "Настроить колонки" }));
+    await reloaded.user.click(await screen.findByRole("button", { name: "По умолчанию" }));
+    expect(await screen.findByRole("columnheader", { name: "Телефон" })).toBeInTheDocument();
+  });
+
+  it("Enter на строке в фокусе открывает карточку клиента", async () => {
+    mockViewport();
+    const { user, router } = await renderApp();
+    await screen.findByText(moneyText(1_234_567), undefined, { timeout: 5000 });
+
+    rowAt(1)?.focus();
+    await user.keyboard("{Enter}");
+
+    await waitFor(() => {
+      expect(router.state.location.pathname).toMatch(/^\/clients\/[0-9a-f-]{36}$/);
+    });
+    expect(await screen.findByRole("heading", { name: "Карточка клиента" })).toBeInTheDocument();
+  }, 15_000);
+});
