+import { Tag, theme } from "antd";
+import { CLIENT_STATUS_LABEL } from "@/entities/client";
+import type { ClientStatus } from "@/entities/client";
+import type { StatusTokens } from "@/shared/ui";
+
+const STATUS_COLOR_TOKEN = {
+  LEAD: "colorStatusNeutral",
+  ACCOUNT_OPENED: "colorStatusInfo",
+  FUNDED: "colorStatusSuccess",
+  INACTIVE: "colorStatusMuted",
+} as const satisfies Record<ClientStatus, keyof StatusTokens>;
+
+/** Статус передаётся текстом, цвет — дополнительный признак (п. 4.2). */
+export const StatusTag = ({ status }: { status: ClientStatus }) => {
+  const { token } = theme.useToken();
+  return <Tag color={token[STATUS_COLOR_TOKEN[status]]}>{CLIENT_STATUS_LABEL[status]}</Tag>;
+};
diff --git a/src/widgets/clients-table/columns.tsx b/src/widgets/clients-table/columns.tsx
