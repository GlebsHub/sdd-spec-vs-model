+import { z } from "zod";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+
+export const MIN_SEARCH_LENGTH = 2;
+
+const STATUSES: readonly ClientStatus[] = Object.values(CLIENT_STATUS);
+const SORT_FIELDS: readonly ClientSortField[] = Object.values(CLIENT_SORT_FIELD);
+const SORT_DIRECTIONS: readonly SortDirection[] = Object.values(SORT_DIRECTION);
+
+const DEFAULT_SORT_FIELD = CLIENT_SORT_FIELD.registeredAt;
+const DEFAULT_SORT_DIRECTION = SORT_DIRECTION.desc;
+export const DEFAULT_SORT = `${DEFAULT_SORT_FIELD}:${DEFAULT_SORT_DIRECTION}`;
+
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+const isCalendarDate = (value: string): boolean => {
+  if (!DATE_RE.test(value)) {
+    return false;
+  }
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+};
+
+const findOption = <T extends string>(options: readonly T[], value: string): T | undefined =>
+  options.find((option) => option === value);
+
+const parseSort = (raw: string): { field: ClientSortField; direction: SortDirection } | undefined => {
+  const parts = raw.split(":");
+  if (parts.length !== 2) {
+    return undefined;
+  }
+  const [field = "", direction = ""] = parts;
+  const sortField = findOption(SORT_FIELDS, field);
+  const sortDirection = findOption(SORT_DIRECTIONS, direction);
+  if (sortField === undefined || sortDirection === undefined) {
+    return undefined;
+  }
+  return { field: sortField, direction: sortDirection };
+};
+
+/** Неизвестные и повторные статусы отбрасываются, результат в каноническом порядке. */
+const normalizeStatuses = (raw: string): string => {
+  const requested = raw.split(",");
+  return STATUSES.filter((status) => requested.includes(status)).join(",");
+};
+
+const dateParam = z
+  .string()
+  .transform((value) => (isCalendarDate(value) ? value : ""))
+  .catch("");
+
+/** Параметры маршрута `/clients`. Некорректное значение заменяется значением по умолчанию. */
+export const clientsSearchSchema = z.object({
+  q: z.string().catch(""),
+  status: z.string().transform(normalizeStatuses).catch(""),
+  dateFrom: dateParam,
+  dateTo: dateParam,
+  sort: z
+    .string()
+    .transform((value) => (parseSort(value) ? value : DEFAULT_SORT))
+    .catch(DEFAULT_SORT),
+});
+
+export type ClientsSearch = z.output<typeof clientsSearchSchema>;
+
+export const CLIENTS_SEARCH_DEFAULTS: ClientsSearch = {
+  q: "",
+  status: "",
+  dateFrom: "",
+  dateTo: "",
+  sort: DEFAULT_SORT,
+};
+
+export type ClientListFilters = {
+  q: string | undefined;
+  status: ClientStatus[];
+  dateFrom: string | undefined;
+  dateTo: string | undefined;
+  sort: { field: ClientSortField; direction: SortDirection };
+};
+
+const DEFAULT_SORT_PARSED = { field: DEFAULT_SORT_FIELD, direction: DEFAULT_SORT_DIRECTION };
+
+/** Параметры запроса списка. Короткий поиск не отправляется: сервер отвечает на него 400. */
+export const toClientListParams = (search: ClientsSearch): ClientListFilters => {
+  const q = search.q.trim();
+  const requested = search.status.split(",");
+  return {
+    q: q.length >= MIN_SEARCH_LENGTH ? q : undefined,
+    status: STATUSES.filter((status) => requested.includes(status)),
+    dateFrom: search.dateFrom || undefined,
+    dateTo: search.dateTo || undefined,
+    sort: parseSort(search.sort) ?? DEFAULT_SORT_PARSED,
+  };
+};
