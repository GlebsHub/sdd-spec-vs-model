+import { createColumnHelper } from "@tanstack/react-table";
+import dayjs from "dayjs";
+import { ClientStatusTag } from "@/entities/client";
+import type { Client } from "@/entities/client";
+import { formatMoney } from "@/shared/lib/money";
+
+/** Стабильные id колонок: на них ссылаются URL (поле сортировки) и `localStorage`. Совпадают с полями API. */
+export const COLUMN_ID = {
+  fullName: "fullName",
+  phoneMasked: "phoneMasked",
+  status: "status",
+  registeredAt: "registeredAt",
+  commissionKopecks: "commissionKopecks",
+} as const;
+
+type ColumnId = (typeof COLUMN_ID)[keyof typeof COLUMN_ID];
+
+/** Id колонок в порядке по умолчанию. */
+export const COLUMN_IDS: readonly ColumnId[] = [
+  COLUMN_ID.fullName,
+  COLUMN_ID.phoneMasked,
+  COLUMN_ID.status,
+  COLUMN_ID.registeredAt,
+  COLUMN_ID.commissionKopecks,
+];
+
+type ColumnLayout = {
+  label: string;
+  /** Ширина колонки в `grid-template-columns`. */
+  width: string;
+  alignEnd: boolean;
+};
+
+const COLUMN_LAYOUT: Record<ColumnId, ColumnLayout> = {
+  [COLUMN_ID.fullName]: { label: "ФИО", width: "minmax(14rem, 3fr)", alignEnd: false },
+  [COLUMN_ID.phoneMasked]: { label: "Телефон", width: "minmax(10rem, 1.5fr)", alignEnd: false },
+  [COLUMN_ID.status]: { label: "Статус", width: "minmax(9rem, 1fr)", alignEnd: false },
+  [COLUMN_ID.registeredAt]: { label: "Дата регистрации", width: "minmax(9rem, 1fr)", alignEnd: false },
+  [COLUMN_ID.commissionKopecks]: { label: "Комиссия", width: "minmax(9rem, 1fr)", alignEnd: true },
+};
+
+const FALLBACK_LAYOUT: ColumnLayout = { label: "", width: "minmax(8rem, 1fr)", alignEnd: false };
+
+const isColumnId = (id: string): id is ColumnId => COLUMN_IDS.some((columnId) => columnId === id);
+
+export const getColumnLayout = (id: string): ColumnLayout =>
+  isColumnId(id) ? COLUMN_LAYOUT[id] : { ...FALLBACK_LAYOUT, label: id };
+
+const VIEW_DATE_FORMAT = "DD.MM.YYYY";
+
+const columnHelper = createColumnHelper<Client>();
+
+export const columns = [
+  columnHelper.accessor("fullName", {
+    id: COLUMN_ID.fullName,
+    header: COLUMN_LAYOUT.fullName.label,
+    sortDescFirst: false,
+  }),
+  columnHelper.accessor("phoneMasked", {
+    id: COLUMN_ID.phoneMasked,
+    header: COLUMN_LAYOUT.phoneMasked.label,
+    enableSorting: false,
+  }),
+  columnHelper.accessor("status", {
+    id: COLUMN_ID.status,
+    header: COLUMN_LAYOUT.status.label,
+    enableSorting: false,
+    cell: (info) => <ClientStatusTag status={info.getValue()} />,
+  }),
+  columnHelper.accessor("registeredAt", {
+    id: COLUMN_ID.registeredAt,
+    header: COLUMN_LAYOUT.registeredAt.label,
+    sortDescFirst: true,
+    cell: (info) => dayjs(info.getValue()).format(VIEW_DATE_FORMAT),
+  }),
+  columnHelper.accessor("commissionKopecks", {
+    id: COLUMN_ID.commissionKopecks,
+    header: COLUMN_LAYOUT.commissionKopecks.label,
+    sortDescFirst: true,
+    cell: (info) => formatMoney(info.getValue()),
+  }),
+];
