@@ -0,0 +1,63 @@
+import { createColumnHelper } from "@tanstack/react-table";
+import type { ColumnDef } from "@tanstack/react-table";
+import { Tag, theme } from "antd";
+import dayjs from "dayjs";
+import { CLIENT_STATUS_LABEL } from "@/entities/clients";
+import { CLIENT_COLUMN, CLIENT_COLUMN_LABEL } from "@/features/client-columns";
+import { CLIENT_SORT_FIELD } from "@/shared/api";
+import type { Client, ClientSortField, ClientStatus } from "@/shared/api";
+import { formatMoney } from "@/shared/lib/money";
+import type { StatusTokens } from "@/shared/ui";
+
+const STATUS_COLOR_TOKEN: Record<ClientStatus, keyof StatusTokens> = {
+  LEAD: "colorStatusNeutral",
+  ACCOUNT_OPENED: "colorStatusInfo",
+  FUNDED: "colorStatusSuccess",
+  INACTIVE: "colorStatusMuted",
+};
+
+/** Колонки, по которым сервер умеет сортировать (п. 4.1). */
+export const SORT_FIELD_BY_COLUMN: ReadonlyMap<string, ClientSortField> = new Map<string, ClientSortField>([
+  [CLIENT_COLUMN.fullName, CLIENT_SORT_FIELD.fullName],
+  [CLIENT_COLUMN.registeredAt, CLIENT_SORT_FIELD.registeredAt],
+  [CLIENT_COLUMN.commissionKopecks, CLIENT_SORT_FIELD.commissionKopecks],
+]);
+
+export const RIGHT_ALIGNED_COLUMNS: ReadonlySet<string> = new Set([CLIENT_COLUMN.commissionKopecks]);
+
+const StatusTag = ({ status }: { status: ClientStatus }) => {
+  const { token } = theme.useToken();
+  return <Tag color={token[STATUS_COLOR_TOKEN[status]]}>{CLIENT_STATUS_LABEL[status]}</Tag>;
+};
+
+const columnHelper = createColumnHelper<Client>();
+
+export const CLIENT_COLUMNS: ColumnDef<Client>[] = [
+  columnHelper.accessor("fullName", {
+    id: CLIENT_COLUMN.fullName,
+    header: CLIENT_COLUMN_LABEL.fullName,
+  }),
+  columnHelper.accessor("phoneMasked", {
+    id: CLIENT_COLUMN.phoneMasked,
+    header: CLIENT_COLUMN_LABEL.phoneMasked,
+  }),
+  columnHelper.accessor("status", {
+    id: CLIENT_COLUMN.status,
+    header: CLIENT_COLUMN_LABEL.status,
+    cell: (info) => <StatusTag status={info.getValue()} />,
+  }),
+  columnHelper.accessor("registeredAt", {
+    id: CLIENT_COLUMN.registeredAt,
+    header: CLIENT_COLUMN_LABEL.registeredAt,
+    cell: (info) => dayjs(info.getValue()).format("DD.MM.YYYY"),
+  }),
+  columnHelper.accessor("commissionKopecks", {
+    id: CLIENT_COLUMN.commissionKopecks,
+    header: CLIENT_COLUMN_LABEL.commissionKopecks,
+    cell: (info) => formatMoney(info.getValue()),
+  }),
+  columnHelper.accessor("productsCount", {
+    id: CLIENT_COLUMN.productsCount,
+    header: CLIENT_COLUMN_LABEL.productsCount,
+  }),
+];
