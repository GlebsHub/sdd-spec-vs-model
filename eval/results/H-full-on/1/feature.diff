+import { act, renderHook } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { setCurrentAgentId } from "@/shared/lib/session";
+import { useColumnVisibility } from "./useColumnVisibility";
+
+const COLUMNS = [
+  { id: "fullName", hideable: false, defaultVisible: true },
+  { id: "phoneMasked", hideable: true, defaultVisible: true },
+  { id: "productsCount", hideable: true, defaultVisible: false },
+];
+
+const STORAGE_KEY = "clients-columns:v1:agent-1";
+
+describe("useColumnVisibility", () => {
+  it("без сохранённых настроек берёт видимость по умолчанию", () => {
+    setCurrentAgentId("agent-1");
+    const { result } = renderHook(() => useColumnVisibility(COLUMNS));
+    expect(result.current.visibility).toEqual({ fullName: true, phoneMasked: true, productsCount: false });
+  });
+
+  it("повреждённое значение в localStorage игнорируется", () => {
+    setCurrentAgentId("agent-1");
+    window.localStorage.setItem(STORAGE_KEY, "{не json");
+    const { result } = renderHook(() => useColumnVisibility(COLUMNS));
+    expect(result.current.visibility).toEqual({ fullName: true, phoneMasked: true, productsCount: false });
+  });
+
+  it("колонка без права скрытия остаётся видимой даже при сохранённом false", () => {
+    setCurrentAgentId("agent-1");
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify({ fullName: false, phoneMasked: false }));
+    const { result } = renderHook(() => useColumnVisibility(COLUMNS));
+    expect(result.current.visibility).toEqual({ fullName: true, phoneMasked: false, productsCount: false });
+  });
+
+  it("настройка сохраняется отдельно для каждого агента", () => {
+    setCurrentAgentId("agent-1");
+    const { result } = renderHook(() => useColumnVisibility(COLUMNS));
+    act(() => {
+      result.current.toggle("phoneMasked", false);
+    });
+    expect(JSON.parse(window.localStorage.getItem(STORAGE_KEY) ?? "null")).toMatchObject({ phoneMasked: false });
+    expect(window.localStorage.getItem("clients-columns:v1:agent-2")).toBeNull();
+  });
+
+  it("«По умолчанию» возвращает исходную видимость", () => {
+    setCurrentAgentId("agent-1");
+    const { result } = renderHook(() => useColumnVisibility(COLUMNS));
+    act(() => {
+      result.current.toggle("productsCount", true);
+      result.current.toggle("phoneMasked", false);
+    });
+    act(() => {
+      result.current.reset();
+    });
+    expect(result.current.visibility).toEqual({ fullName: true, phoneMasked: true, productsCount: false });
+  });
+});
