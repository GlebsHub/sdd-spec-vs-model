+
+/**
+ * Предзагрузка первой порции. Намеренно не ждём ответ: переход не блокируется,
+ * а страница показывает скелетон и состояния ошибок сама.
+ */
+export const loadClients = (queryClient: QueryClient, search: ClientsSearch): void => {
+  void queryClient.prefetchInfiniteQuery(clientQueries.list(toListParams(search)));
+};
