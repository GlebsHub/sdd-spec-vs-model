@@ -0,0 +1,260 @@
+import { ArrowDownOutlined, ArrowUpOutlined } from "@ant-design/icons";
+import { getRouteApi, useElementScrollRestoration } from "@tanstack/react-router";
+import { flexRender, getCoreRowModel, useReactTable } from "@tanstack/react-table";
+import type { Header } from "@tanstack/react-table";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import { Alert, Button, Empty, Flex, Result, Spin, Typography, theme } from "antd";
+import { useEffect, useRef } from "react";
+import type { ReactNode } from "react";
+import { toClientListParams, useClients } from "@/entities/client";
+import { ClientColumnsSettings } from "@/features/client-columns-settings";
+import { ClientListFilters } from "@/features/client-list-filters";
+import { SORT_DIRECTION } from "@/shared/api";
+import type { Client } from "@/shared/api";
+import { useCurrentAgent } from "@/shared/lib/session";
+import { CLIENT_COLUMNS } from "./columns";
+import { CLIENTS_LIST_SCROLL_ID } from "./constants";
+import styles from "./ClientsTable.module.css";
+import { useColumnVisibility } from "./useColumnVisibility";
+
+const routeApi = getRouteApi("/clients");
+
+const ROW_HEIGHT = 56;
+const OVERSCAN = 10;
+const PREFETCH_THRESHOLD = 10;
+
+const ariaSort = (sorted: false | "asc" | "desc"): "ascending" | "descending" | undefined => {
+  if (sorted === "asc") {
+    return "ascending";
+  }
+  if (sorted === "desc") {
+    return "descending";
+  }
+  return undefined;
+};
+
+export const ClientsTable = () => {
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+  const { token } = theme.useToken();
+  const filters = toClientListParams(search);
+  const {
+    clients,
+    total,
+    isPending,
+    isLoadFailed,
+    isNextPageFailed,
+    hasNextPage,
+    isFetchingNextPage,
+    refetch,
+    fetchNextPage,
+  } = useClients(filters);
+  const { id: agentId } = useCurrentAgent();
+  const { columnVisibility, setColumnVisible } = useColumnVisibility(agentId);
+
+  const table = useReactTable({
+    data: clients,
+    columns: CLIENT_COLUMNS,
+    state: {
+      columnVisibility,
+      sorting: [{ id: filters.sort.field, desc: filters.sort.direction === SORT_DIRECTION.desc }],
+    },
+    manualSorting: true,
+    manualFiltering: true,
+    getCoreRowModel: getCoreRowModel(),
+  });
+
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const restoredScroll = useElementScrollRestoration({
+    id: CLIENTS_LIST_SCROLL_ID,
+    getElement: () => scrollRef.current,
+  });
+
+  const rows = table.getRowModel().rows;
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: OVERSCAN,
+    initialOffset: restoredScroll?.scrollY,
+  });
+  const lastVisibleIndex = virtualizer.getVirtualItems().at(-1)?.index;
+
+  useEffect(() => {
+    if (lastVisibleIndex === undefined || !hasNextPage || isFetchingNextPage || isNextPageFailed) {
+      return;
+    }
+    if (lastVisibleIndex >= rows.length - PREFETCH_THRESHOLD) {
+      void fetchNextPage();
+    }
+  }, [lastVisibleIndex, rows.length, hasNextPage, isFetchingNextPage, isNextPageFailed, fetchNextPage]);
+
+  const changeSort = (field: string) => {
+    const direction =
+      filters.sort.field === field && filters.sort.direction === SORT_DIRECTION.asc
+        ? SORT_DIRECTION.desc
+        : SORT_DIRECTION.asc;
+    void navigate({ search: (prev) => ({ ...prev, sort: `${field}:${direction}` }) });
+  };
+
+  const isFiltered = search.q !== "" || search.status !== "" || search.dateFrom !== "" || search.dateTo !== "";
+  const visibleColumns = table.getVisibleLeafColumns();
+  const gridTemplateColumns = visibleColumns.map((column) => `minmax(${String(column.getSize())}px, 1fr)`).join(" ");
+  const headers: Header<Client, unknown>[] = table.getHeaderGroups().at(-1)?.headers ?? [];
+  const settingsColumns = table.getAllLeafColumns().map((column) => ({
+    id: column.id,
+    label: typeof column.columnDef.header === "string" ? column.columnDef.header : column.id,
+    hideable: column.getCanHide(),
+    visible: column.getIsVisible(),
+  }));
+
+  const renderHeader = (header: Header<Client, unknown>): ReactNode => {
+    const { column } = header;
+    const content = flexRender(column.columnDef.header, header.getContext());
+    if (!column.getCanSort()) {
+      return content;
+    }
+    const sorted = column.getIsSorted();
+    return (
+      <Button
+        type="text"
+        className={styles.sortButton}
+        onClick={() => {
+          changeSort(column.id);
+        }}
+      >
+        {content}
+        {sorted === "asc" && <ArrowUpOutlined aria-hidden />}
+        {sorted === "desc" && <ArrowDownOutlined aria-hidden />}
+      </Button>
+    );
+  };
+
+  const renderBody = (): ReactNode => {
+    if (isPending) {
+      return (
+        <Flex justify="center" className={styles.state}>
+          <Spin />
+        </Flex>
+      );
+    }
+    if (isLoadFailed) {
+      return (
+        <Result
+          status="error"
+          title="Не удалось загрузить клиентов"
+          extra={
+            <Button
+              type="primary"
+              onClick={() => {
+                void refetch();
+              }}
+            >
+              Повторить
+            </Button>
+          }
+        />
+      );
+    }
+    if (clients.length === 0) {
+      return (
+        <Empty description={isFiltered ? "Ничего не найдено" : "Клиентов пока нет"} className={styles.state} />
+      );
+    }
+    return (
+      <div
+        className={styles.table}
+        role="table"
+        aria-label="Мои клиенты"
+        style={{ borderColor: token.colorBorderSecondary, background: token.colorBgContainer, borderRadius: token.borderRadiusLG }}
+      >
+        <div role="rowgroup">
+          <div
+            role="row"
+            className={styles.headerRow}
+            style={{ gridTemplateColumns, borderColor: token.colorBorderSecondary }}
+          >
+            {headers.map((header) => (
+              <div key={header.id} role="columnheader" aria-sort={ariaSort(header.column.getIsSorted())} className={styles.cell}>
+                {renderHeader(header)}
+              </div>
+            ))}
+          </div>
+        </div>
+        <div ref={scrollRef} className={styles.scroll} data-scroll-restoration-id={CLIENTS_LIST_SCROLL_ID} role="rowgroup">
+          <div style={{ height: virtualizer.getTotalSize(), position: "relative" }}>
+            {virtualizer.getVirtualItems().map((item) => {
+              const row = rows[item.index];
+              if (!row) {
+                return null;
+              }
+              return (
+                <div
+                  key={row.original.id}
+                  role="row"
+                  className={styles.row}
+                  style={{
+                    gridTemplateColumns,
+                    height: item.size,
+                    transform: `translateY(${String(item.start)}px)`,
+                    borderColor: token.colorBorderSecondary,
+                  }}
+                >
+                  {row.getVisibleCells().map((cell) => (
+                    <div key={cell.id} role="cell" className={styles.cell}>
+                      {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                    </div>
+                  ))}
+                </div>
+              );
+            })}
+          </div>
+        </div>
+        {isFetchingNextPage && (
+          <Flex justify="center" className={styles.footer}>
+            <Spin size="small" />
+          </Flex>
+        )}
+        {isNextPageFailed && (
+          <Alert
+            type="error"
+            showIcon
+            className={styles.footer}
+            message="Не удалось загрузить следующих клиентов"
+            action={
+              <Button
+                size="small"
+                onClick={() => {
+                  void fetchNextPage();
+                }}
+              >
+                Повторить
+              </Button>
+            }
+          />
+        )}
+        {!hasNextPage && !isNextPageFailed && (
+          <Typography.Text type="secondary" className={styles.footer}>
+            Это все клиенты
+          </Typography.Text>
+        )}
+      </div>
+    );
+  };
+
+  return (
+    <Flex vertical gap="middle" className={styles.root}>
+      <Flex wrap gap="middle" align="center" justify="space-between">
+        <ClientListFilters />
+        <ClientColumnsSettings
+          columns={settingsColumns}
+          onVisibilityChange={setColumnVisible}
+        />
+      </Flex>
+      {total !== undefined && !isPending && !isLoadFailed && (
+        <Typography.Text type="secondary">Клиентов: {total}</Typography.Text>
+      )}
+      {renderBody()}
+    </Flex>
+  );
+};
