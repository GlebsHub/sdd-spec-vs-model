+
+export type ColumnSettingsProps = {
+  /** Колонки в текущем порядке. */
+  items: readonly ColumnSettingsItem[];
+  onToggle: (id: string) => void;
+  onMove: (id: string, direction: -1 | 1) => void;
+  onReset: () => void;
+};
+
+export const ColumnSettings = ({ items, onToggle, onMove, onReset }: ColumnSettingsProps) => {
+  const visibleCount = items.filter((item) => item.visible).length;
+
+  const content = (
+    <Flex vertical gap="small">
+      {items.map((item, index) => (
+        <Flex key={item.id} align="center" justify="space-between" gap="middle">
+          <Checkbox
+            checked={item.visible}
+            disabled={item.visible && visibleCount === 1}
+            onChange={() => {
+              onToggle(item.id);
+            }}
+          >
+            {item.label}
+          </Checkbox>
+          <Flex gap="small">
+            <Button
+              size="small"
+              type="text"
+              icon={<ArrowUpOutlined aria-hidden />}
+              aria-label={`Переместить «${item.label}» выше`}
+              disabled={index === 0}
+              onClick={() => {
+                onMove(item.id, -1);
+              }}
+            />
+            <Button
+              size="small"
+              type="text"
+              icon={<ArrowDownOutlined aria-hidden />}
+              aria-label={`Переместить «${item.label}» ниже`}
+              disabled={index === items.length - 1}
+              onClick={() => {
+                onMove(item.id, 1);
+              }}
+            />
+          </Flex>
+        </Flex>
+      ))}
+      <Button size="small" onClick={onReset}>
+        По умолчанию
+      </Button>
+    </Flex>
+  );
+
+  return (
+    <Popover trigger="click" placement="bottomRight" title="Колонки таблицы" content={content}>
+      <Button icon={<SettingOutlined aria-hidden />}>Колонки</Button>
+    </Popover>
+  );
+};
