+import { createColumnHelper } from "@tanstack/react-table";
+import dayjs from "dayjs";
+import type { Client, ClientSortField } from "@/entities/client";
+import { formatMoney } from "@/shared/lib/money";
+import { ClientStatusTag } from "./ClientStatusTag";
+
+export type ClientColumnId = "fullName" | "phoneMasked" | "status" | "registeredAt" | "commissionKopecks" | "productsCount";
+
+export type ClientColumnOption = {
+  id: ClientColumnId;
+  title: string;
+  hideable: boolean;
+  defaultVisible: boolean;
+};
+
+const TITLE: Record<ClientColumnId, string> = {
+  fullName: "ФИО",
+  phoneMasked: "Телефон",
+  status: "Статус",
+  registeredAt: "Дата регистрации",
+  commissionKopecks: "Комиссия",
+  productsCount: "Продуктов",
+};
+
+/** Порядок и подписи колонок, видимость по умолчанию — спецификация, п. 4.1. */
+export const CLIENT_COLUMN_OPTIONS: readonly ClientColumnOption[] = [
+  { id: "fullName", title: TITLE.fullName, hideable: false, defaultVisible: true },
+  { id: "phoneMasked", title: TITLE.phoneMasked, hideable: true, defaultVisible: true },
+  { id: "status", title: TITLE.status, hideable: true, defaultVisible: true },
+  { id: "registeredAt", title: TITLE.registeredAt, hideable: true, defaultVisible: true },
+  { id: "commissionKopecks", title: TITLE.commissionKopecks, hideable: true, defaultVisible: true },
+  { id: "productsCount", title: TITLE.productsCount, hideable: true, defaultVisible: false },
+];
+
+/** Колонка сортируется на сервере по этому полю. */
+export const SORT_FIELD_BY_COLUMN: Partial<Record<ClientColumnId, ClientSortField>> = {
+  fullName: "fullName",
+  registeredAt: "registeredAt",
+  commissionKopecks: "commissionKopecks",
+};
+
+export const COLUMN_WIDTH: Record<ClientColumnId, string> = {
+  fullName: "minmax(220px, 2fr)",
+  phoneMasked: "minmax(150px, 1fr)",
+  status: "minmax(160px, 1fr)",
+  registeredAt: "minmax(150px, 1fr)",
+  commissionKopecks: "minmax(140px, 1fr)",
+  productsCount: "minmax(110px, 0.6fr)",
+};
+
+const columnHelper = createColumnHelper<Client>();
+
+export const clientColumns = [
+  columnHelper.accessor("fullName", {
+    header: TITLE.fullName,
+    enableHiding: false,
+    cell: (info) => info.getValue(),
+  }),
+  columnHelper.accessor("phoneMasked", {
+    header: TITLE.phoneMasked,
+    cell: (info) => info.getValue(),
+  }),
+  columnHelper.accessor("status", {
+    header: TITLE.status,
+    cell: (info) => <ClientStatusTag status={info.getValue()} />,
+  }),
+  columnHelper.accessor("registeredAt", {
+    header: TITLE.registeredAt,
+    cell: (info) => dayjs(info.getValue()).format("DD.MM.YYYY"),
+  }),
+  columnHelper.accessor("commissionKopecks", {
+    header: TITLE.commissionKopecks,
+    cell: (info) => formatMoney(info.getValue()),
+  }),
+  columnHelper.accessor("productsCount", {
+    header: TITLE.productsCount,
+    cell: (info) => info.getValue(),
+  }),
+];
