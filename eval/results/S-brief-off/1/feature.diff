+import { expect, test } from "@playwright/test";
+import type { Locator, Page } from "@playwright/test";
+
+const CLIENTS_API = "/api/agent/clients";
+const SCROLL_SELECTOR = '[data-scroll-restoration-id="clients-list"]';
+const ROW_HEIGHT = 56;
+
+const scrollContainer = (page: Page): Locator => page.locator(SCROLL_SELECTOR);
+
+const scrollTop = (page: Page): Promise<number> => scrollContainer(page).evaluate((element) => element.scrollTop);
+
+const scrollTo = (page: Page, top: number): Promise<void> =>
+  scrollContainer(page).evaluate((element, value) => {
+    element.scrollTop = value;
+  }, top);
+
+const clientRequests = (page: Page): string[] => {
+  const urls: string[] = [];
+  page.on("request", (request) => {
+    if (request.url().includes(CLIENTS_API)) {
+      urls.push(request.url());
+    }
+  });
+  return urls;
+};
+
+test("прокрутка догружает следующие страницы", async ({ page }) => {
+  const urls = clientRequests(page);
+  await page.goto("/clients");
+  await expect(page.getByRole("table", { name: "Клиенты" })).toBeVisible();
+  expect(urls.filter((url) => url.includes("cursor="))).toHaveLength(0);
+
+  await scrollTo(page, 50 * ROW_HEIGHT);
+  await expect.poll(() => urls.filter((url) => url.includes("cursor=")).length).toBeGreaterThan(0);
+
+  await scrollTo(page, 200 * ROW_HEIGHT);
+  await expect.poll(() => urls.filter((url) => url.includes("cursor=")).length).toBeGreaterThan(1);
+  await expect(page.getByRole("table", { name: "Клиенты" })).toHaveAttribute("aria-rowcount", "10001");
+});
+
+test("ссылка с параметрами открывает то же состояние", async ({ page }) => {
+  const urls = clientRequests(page);
+  await page.goto("/clients?q=Иванов&status=FUNDED&dateFrom=2025-01-01&sort=commissionKopecks&dir=asc");
+
+  await expect(page.getByRole("textbox", { name: "Поиск по ФИО" })).toHaveValue("Иванов");
+  await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+  await expect(page.getByText("Пополнил").first()).toBeVisible();
+  await expect(page.getByRole("table", { name: "Клиенты" })).toBeVisible();
+
+  const first = new URL(urls[0] ?? "", "http://localhost").searchParams;
+  expect(first.get("q")).toBe("Иванов");
+  expect(first.get("status")).toBe("FUNDED");
+  expect(first.get("dateFrom")).toBe("2025-01-01");
+  expect(first.get("sort")).toBe("commissionKopecks:asc");
+});
+
+test("переход на карточку и «Назад» восстанавливают фильтры, сортировку, строки и прокрутку", async ({ page }) => {
+  const urls = clientRequests(page);
+  await page.goto("/clients?status=FUNDED&sort=fullName&dir=asc");
+  await expect(page.getByRole("table", { name: "Клиенты" })).toBeVisible();
+
+  await scrollTo(page, 80 * ROW_HEIGHT);
+  await expect.poll(() => urls.filter((url) => url.includes("cursor=")).length).toBeGreaterThan(0);
+  await scrollTo(page, 80 * ROW_HEIGHT);
+  await page.waitForTimeout(500);
+  const savedTop = await scrollTop(page);
+  expect(savedTop).toBeGreaterThan(0);
+  const listUrl = page.url();
+
+  await page.getByRole("row").nth(3).click();
+  await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+
+  const requestsBeforeBack = urls.length;
+  await page.getByRole("button", { name: "Назад" }).click();
+
+  await expect(page.getByRole("table", { name: "Клиенты" })).toBeVisible();
+  expect(page.url()).toBe(listUrl);
+  await expect(page.getByRole("columnheader", { name: "ФИО" })).toHaveAttribute("aria-sort", "ascending");
+  await expect.poll(() => scrollTop(page)).toBeGreaterThan(savedTop - ROW_HEIGHT);
+  expect(Math.abs((await scrollTop(page)) - savedTop)).toBeLessThan(ROW_HEIGHT);
+  await expect(page.getByRole("row").nth(1)).toBeVisible();
+  expect(urls.length).toBe(requestsBeforeBack);
+});
+
+test("смена сортировки возвращает прокрутку в начало", async ({ page }) => {
+  await page.goto("/clients");
+  await expect(page.getByRole("table", { name: "Клиенты" })).toBeVisible();
+
+  await scrollTo(page, 30 * ROW_HEIGHT);
+  await expect.poll(() => scrollTop(page)).toBeGreaterThan(0);
+
+  await page.getByRole("button", { name: "ФИО" }).click();
+  await expect(page.getByRole("columnheader", { name: "ФИО" })).toHaveAttribute("aria-sort", "ascending");
+  await expect.poll(() => scrollTop(page)).toBe(0);
+});
