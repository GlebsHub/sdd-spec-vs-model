+import { SearchOutlined } from "@ant-design/icons";
+import { getRouteApi } from "@tanstack/react-router";
+import { Button, DatePicker, Flex, Input, Select } from "antd";
+import dayjs from "dayjs";
+import type { Dayjs } from "dayjs";
+import { useEffect, useState } from "react";
+import { CLIENTS_SEARCH_DEFAULTS, CLIENT_STATUS_LABEL } from "@/entities/client";
+import { CLIENT_STATUS } from "@/shared/api";
+import type { ClientStatus } from "@/shared/api";
+
+const routeApi = getRouteApi("/clients");
+
+const SEARCH_DEBOUNCE_MS = 300;
+const DATE_FORMAT = "YYYY-MM-DD";
+const DATE_DISPLAY_FORMAT = "DD.MM.YYYY";
+
+const STATUS_OPTIONS = Object.values(CLIENT_STATUS).map((status) => ({
+  value: status,
+  label: CLIENT_STATUS_LABEL[status],
+}));
+
+const parseDate = (value: string): Dayjs | null => (value === "" ? null : dayjs(value));
+
+export const ClientListFilters = () => {
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+  const [searchText, setSearchText] = useState(search.q);
+
+  useEffect(() => {
+    setSearchText(search.q);
+  }, [search.q]);
+
+  useEffect(() => {
+    if (searchText === search.q) {
+      return;
+    }
+    const timer = setTimeout(() => {
+      void navigate({ search: (prev) => ({ ...prev, q: searchText }), replace: true });
+    }, SEARCH_DEBOUNCE_MS);
+    return () => {
+      clearTimeout(timer);
+    };
+  }, [searchText, search.q, navigate]);
+
+  const selectedStatuses = STATUS_OPTIONS.map((option) => option.value).filter((status: ClientStatus) =>
+    search.status.split(",").includes(status),
+  );
+  const rangeValue: [Dayjs | null, Dayjs | null] | null =
+    search.dateFrom === "" && search.dateTo === "" ? null : [parseDate(search.dateFrom), parseDate(search.dateTo)];
+  const isFiltered =
+    search.q !== "" || search.status !== "" || search.dateFrom !== "" || search.dateTo !== "" || search.sort !== CLIENTS_SEARCH_DEFAULTS.sort;
+
+  const changeStatuses = (statuses: ClientStatus[]) => {
+    void navigate({ search: (prev) => ({ ...prev, status: statuses.join(",") }) });
+  };
+
+  const changeDates = (dates: (Dayjs | null)[] | null) => {
+    const [from = null, to = null] = dates ?? [];
+    void navigate({
+      search: (prev) => ({
+        ...prev,
+        dateFrom: from?.format(DATE_FORMAT) ?? "",
+        dateTo: to?.format(DATE_FORMAT) ?? "",
+      }),
+    });
+  };
+
+  const reset = () => {
+    setSearchText("");
+    void navigate({ search: CLIENTS_SEARCH_DEFAULTS });
+  };
+
+  return (
+    <Flex wrap gap="middle" align="center">
+      <Input
+        allowClear
+        prefix={<SearchOutlined aria-hidden />}
+        placeholder="Поиск по ФИО"
+        aria-label="Поиск по ФИО"
+        value={searchText}
+        onChange={(event) => {
+          setSearchText(event.target.value);
+        }}
+        style={{ width: 260 }}
+      />
+      <Select<ClientStatus[]>
+        mode="multiple"
+        allowClear
+        placeholder="Статус"
+        aria-label="Статус"
+        options={STATUS_OPTIONS}
+        value={selectedStatuses}
+        onChange={changeStatuses}
+        style={{ minWidth: 200 }}
+      />
+      <DatePicker.RangePicker
+        allowClear
+        format={DATE_DISPLAY_FORMAT}
+        placeholder={["Регистрация с", "по"]}
+        value={rangeValue}
+        onChange={changeDates}
+      />
+      <Button onClick={reset} disabled={!isFiltered}>
+        Сбросить
+      </Button>
+    </Flex>
+  );
+};
