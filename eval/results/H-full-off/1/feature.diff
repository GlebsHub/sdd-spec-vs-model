+import { expect, test } from "@playwright/test";
+
+const SCROLLER = '[data-scroll-restoration-id="clients-table"]';
+
+test("ссылка с параметрами открывает то же состояние", async ({ page }) => {
+  await page.goto("/clients?status=LEAD&sort=commissionKopecks:asc");
+  await expect(page.getByRole("columnheader", { name: /Комиссия/ })).toHaveAttribute("aria-sort", "ascending");
+  await expect(page.getByRole("button", { name: "Сбросить фильтры" })).toBeVisible();
+});
+
+test("после перезагрузки восстанавливаются фильтры", async ({ page }) => {
+  await page.goto("/clients?q=Иванов");
+  await page.reload();
+  await expect(page.getByLabel("Поиск по ФИО")).toHaveValue("Иванов");
+});
+
+test("прокрутка догружает страницы и держит в DOM не более 60 строк", async ({ page }) => {
+  await page.goto("/clients");
+  const table = page.getByRole("table", { name: "Список клиентов" });
+  await expect(table.getByRole("row").nth(1)).toBeVisible();
+  for (let step = 0; step < 40; step += 1) {
+    await page.locator(SCROLLER).evaluate((element) => {
+      element.scrollTop += 2000;
+    });
+  }
+  await expect.poll(async () => table.getByRole("row").count()).toBeGreaterThan(60);
+  expect(await table.getByRole("row").count()).toBeLessThanOrEqual(61);
+});
+
+test("переход в карточку и «назад» восстанавливает фильтры, строки и прокрутку", async ({ page }) => {
+  await page.goto("/clients?status=LEAD");
+  const table = page.getByRole("table", { name: "Список клиентов" });
+  await expect(table.getByRole("row").nth(1)).toBeVisible();
+  await page.locator(SCROLLER).evaluate((element) => {
+    element.scrollTop = 48 * 30;
+  });
+  const scrollBefore = await page.locator(SCROLLER).evaluate((element) => element.scrollTop);
+  await table.getByRole("row").nth(3).click();
+  await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+  await page.getByRole("button", { name: "Назад" }).click();
+  await expect(page).toHaveURL(/status=LEAD/);
+  await expect(table.getByRole("row").nth(1)).toBeVisible();
+  await expect.poll(async () => page.locator(SCROLLER).evaluate((element) => element.scrollTop)).toBeGreaterThan(scrollBefore - 100);
+});
