+const dataRows = async (): Promise<HTMLElement[]> => {
+  await waitFor(() => {
+    expect(screen.getAllByRole("row").length).toBeGreaterThan(1);
+  });
+  return screen.getAllByRole("row").slice(1);
+};
+
+const lastRequest = () => getRequestLog().at(-1)?.params ?? {};
+
+describe("раздел «Мои клиенты»: таблица", () => {
+  it("показывает колонки и строки клиентов с суммой в рублях", async () => {
+    await renderApp({ url: "/clients" });
+    const headers = await screen.findAllByRole("columnheader");
+    expect(headers.map((header) => header.textContent)).toEqual([
+      "ФИО",
+      "Телефон",
+      "Статус",
+      "Дата регистрации",
+      "Комиссия агента",
+    ]);
+    const [first] = await dataRows();
+    expect(first?.textContent).toContain(formatMoney(1_234_567));
+  });
+
+  it("до ответа показывает загрузку", async () => {
+    setMockScenario({ delayMs: 300 });
+    await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Загружаем клиентов…")).toBeInTheDocument();
+    await dataRows();
+    expect(screen.queryByText("Загружаем клиентов…")).not.toBeInTheDocument();
+  });
+
+  it("без клиентов показывает пустое состояние", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Клиентов пока нет")).toBeInTheDocument();
+  });
+
+  it("при фильтрах без совпадений показывает «Ничего не найдено»", async () => {
+    await renderApp({ url: "/clients?q=зззззз" });
+    expect(await screen.findByText("Ничего не найдено")).toBeInTheDocument();
+  });
+
+  it("ошибка первой страницы показывает повтор, который загружает данные", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorFirstPage, failTimes: 1 });
+    const { user } = await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    await dataRows();
+    expect(screen.queryByText("Не удалось загрузить клиентов")).not.toBeInTheDocument();
+  });
+
+  it("статус, даты и сортировка из адреса уходят в запрос", async () => {
+    await renderApp({ url: "/clients?status=FUNDED,LEAD&dateFrom=2025-01-01&sort=fullName:asc" });
+    await dataRows();
+    expect(lastRequest()).toMatchObject({ status: "FUNDED,LEAD", dateFrom: "2025-01-01", sort: "fullName:asc" });
+  });
+
+  it("поиск по ФИО отправляет q после паузы в наборе", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await dataRows();
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "Иванов");
+    await waitFor(() => {
+      expect(getRequestLog().some((request) => request.params["q"] === "Иванов")).toBe(true);
+    });
+  });
+
+  it("фильтр статуса отправляет выбранные статусы", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await dataRows();
+    await user.click(screen.getByRole("combobox", { name: "Статус" }));
+    await user.click(await screen.findByRole("option", { name: "Лид" }));
+    await waitFor(() => {
+      expect(lastRequest()["status"]).toBe("LEAD");
+    });
+  });
+
+  it("клик по заголовку сортирует на сервере", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await dataRows();
+    await user.click(screen.getByRole("button", { name: "Комиссия агента" }));
+    await waitFor(() => {
+      expect(lastRequest()["sort"]).toBe("commissionKopecks:asc");
+    });
+    expect(screen.getByRole("columnheader", { name: "Комиссия агента" })).toHaveAttribute("aria-sort", "ascending");
+  });
+
+  it("прокрутка до конца догружает следующую порцию", async () => {
+    await renderApp({ url: "/clients" });
+    await dataRows();
+    const scroller = document.querySelector<HTMLElement>(SCROLL_SELECTOR);
+    expect(scroller).not.toBeNull();
+    fireEvent.scroll(scroller as HTMLElement, { target: { scrollTop: 2500 } });
+    await waitFor(() => {
+      expect(getRequestLog().some((request) => request.params["cursor"] !== undefined)).toBe(true);
+    });
+  });
+
+  it("ошибка догрузки показывает повтор", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorNextPage, failTimes: 1 });
+    const { user } = await renderApp({ url: "/clients" });
+    await dataRows();
+    const scroller = document.querySelector<HTMLElement>(SCROLL_SELECTOR) as HTMLElement;
+    fireEvent.scroll(scroller, { target: { scrollTop: 2500 } });
+    expect(await screen.findByText("Не удалось загрузить следующих клиентов")).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    await waitFor(() => {
+      expect(screen.queryByText("Не удалось загрузить следующих клиентов")).not.toBeInTheDocument();
+    });
+  });
+
+  it("клик по клиенту открывает карточку", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    const [first] = await dataRows();
+    await user.click(within(first as HTMLElement).getAllByRole("button")[0] as HTMLElement);
+    expect(await screen.findByRole("heading", { name: "Карточка клиента" })).toBeInTheDocument();
+    expect(router.state.location.pathname).toMatch(/^\/clients\/[^/]+$/);
+  });
+});
+
+describe("настройка колонок", () => {
+  it("скрывает и переставляет колонки", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await dataRows();
+    await user.click(screen.getByRole("button", { name: "Колонки" }));
+    await user.click(screen.getByRole("checkbox", { name: "Телефон" }));
+    await user.click(screen.getByRole("button", { name: "Переместить вверх: Статус" }));
+    expect(screen.getAllByRole("columnheader").map((header) => header.textContent)).toEqual([
+      "ФИО",
+      "Статус",
+      "Дата регистрации",
+      "Комиссия агента",
+    ]);
+  });
+
+  it("настройки сохраняются после перемонтирования", async () => {
+    const first = await renderApp({ url: "/clients" });
+    await dataRows();
+    await first.user.click(screen.getByRole("button", { name: "Колонки" }));
+    await first.user.click(screen.getByRole("checkbox", { name: "Телефон" }));
+    first.unmount();
+
+    await renderApp({ url: "/clients" });
+    await dataRows();
+    expect(screen.queryByRole("columnheader", { name: "Телефон" })).not.toBeInTheDocument();
+  });
+});
