new file mode 100644
index 0000000..7c88249
--- /dev/null
+++ b/src/widgets/clients-table/ClientsTable.tsx
@@ -0,0 +1,205 @@
+import { CaretDownOutlined, CaretUpOutlined } from "@ant-design/icons";
+import { getCoreRowModel, flexRender, useReactTable } from "@tanstack/react-table";
+import { useElementScrollRestoration } from "@tanstack/react-router";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import { Button, Empty, Flex, Result, Spin, Typography, theme } from "antd";
+import { useEffect, useRef } from "react";
+import { CLIENT_COLUMN_TITLE, SORT_DIRECTION, useClients } from "@/entities/client";
+import type { ClientListParams, ClientSortField, SortDirection } from "@/entities/client";
+import { ColumnSettingsButton, useColumnSettings } from "@/features/client-columns";
+import { asClientColumnId, clientColumns, COLUMN_TRACK, SORT_FIELD_BY_COLUMN } from "./columns";
+import { CLIENTS_LIST_SCROLL_ID, LOAD_MORE_THRESHOLD, OVERSCAN, ROW_HEIGHT } from "./constants";
+import styles from "./ClientsTable.module.css";
+
+export type ClientsTableProps = {
+  params: ClientListParams;
+  onSortChange: (sort: { field: ClientSortField; direction: SortDirection }) => void;
+  onOpenClient: (clientId: string) => void;
+};
+
+export const ClientsTable = ({ params, onSortChange, onOpenClient }: ClientsTableProps) => {
+  const { token } = theme.useToken();
+  const columnSettings = useColumnSettings();
+  const {
+    clients,
+    total,
+    isPending,
+    isError,
+    hasNextPage,
+    isFetchingNextPage,
+    isFetchNextPageError,
+    fetchNextPage,
+    retry,
+  } = useClients(params);
+  const restoredScroll = useElementScrollRestoration({ id: CLIENTS_LIST_SCROLL_ID });
+  const scrollRef = useRef<HTMLDivElement>(null);
+
+  const table = useReactTable({
+    data: clients,
+    columns: clientColumns,
+    getRowId: (client) => client.id,
+    state: {
+      columnOrder: columnSettings.columnOrder,
+      columnVisibility: columnSettings.columnVisibility,
+    },
+    manualSorting: true,
+    manualFiltering: true,
+    getCoreRowModel: getCoreRowModel(),
+  });
+
+  const columns = table.getVisibleLeafColumns();
+  const gridTemplateColumns = columns.map((column) => COLUMN_TRACK[asClientColumnId(column.id)]).join(" ");
+  const rows = table.getRowModel().rows;
+  const hasFilters = Boolean(params.q || params.status || params.dateFrom || params.dateTo);
+
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: OVERSCAN,
+    initialOffset: restoredScroll?.scrollY,
+  });
+  const virtualItems = virtualizer.getVirtualItems();
+  const lastVisibleIndex = virtualItems.at(-1)?.index ?? -1;
+
+  useEffect(() => {
+    if (hasNextPage && !isFetchingNextPage && !isFetchNextPageError && lastVisibleIndex >= rows.length - LOAD_MORE_THRESHOLD) {
+      void fetchNextPage();
+    }
+  }, [lastVisibleIndex, rows.length, hasNextPage, isFetchingNextPage, isFetchNextPageError, fetchNextPage]);
+
+  const isEmpty = !isPending && !isError && rows.length === 0;
+  const showInitialError = isError && rows.length === 0;
+
+  return (
+    <Flex vertical gap="middle" className={styles.root}>
+      <Flex justify="space-between" align="center">
+        <Typography.Text type="secondary">{total === undefined ? " " : `Клиентов: ${String(total)}`}</Typography.Text>
+        <ColumnSettingsButton settings={columnSettings} />
+      </Flex>
+
+      <div
+        className={styles.table}
+        role="table"
+        aria-label="Мои клиенты"
+        aria-busy={isPending}
+        style={{ background: token.colorBgContainer, borderRadius: token.borderRadius }}
+      >
+        <div
+          role="row"
+          className={styles.row}
+          style={{ gridTemplateColumns, background: token.colorFillAlter, borderColor: token.colorSplit }}
+        >
+          {columns.map((column) => {
+            const id = asClientColumnId(column.id);
+            const sortField = SORT_FIELD_BY_COLUMN[id];
+            const isActive = sortField !== undefined && sortField === params.sort.field;
+            const isAsc = params.sort.direction === SORT_DIRECTION.asc;
+            const nextDirection = isActive && isAsc ? SORT_DIRECTION.desc : SORT_DIRECTION.asc;
+            const ariaSort = isActive ? (isAsc ? "ascending" : "descending") : "none";
+            return (
+              <div role="columnheader" key={column.id} aria-sort={sortField ? ariaSort : undefined}>
+                {sortField ? (
+                  <Button
+                    type="text"
+                    icon={isActive ? (isAsc ? <CaretUpOutlined aria-hidden /> : <CaretDownOutlined aria-hidden />) : undefined}
+                    iconPlacement="end"
+                    onClick={() => {
+                      onSortChange({ field: sortField, direction: nextDirection });
+                    }}
+                  >
+                    {CLIENT_COLUMN_TITLE[id]}
+                  </Button>
+                ) : (
+                  CLIENT_COLUMN_TITLE[id]
+                )}
+              </div>
+            );
+          })}
+        </div>
+
+        <div ref={scrollRef} className={styles.body} data-scroll-restoration-id={CLIENTS_LIST_SCROLL_ID}>
+          {isPending && (
+            <Flex justify="center" align="center" gap="small" className={styles.state}>
+              <Spin />
+              <Typography.Text>Загружаем клиентов…</Typography.Text>
+            </Flex>
+          )}
+          {showInitialError && (
+            <Result
+              status="error"
+              title="Не удалось загрузить клиентов"
+              extra={
+                <Button
+                  type="primary"
+                  onClick={() => {
+                    void retry();
+                  }}
+                >
+                  Повторить
+                </Button>
+              }
+            />
+          )}
+          {isEmpty && (
+            <Empty
+              className={styles.state}
+              description={hasFilters ? "Ничего не найдено" : "Клиентов пока нет"}
+            />
+          )}
+          {rows.length > 0 && (
+            <div style={{ height: virtualizer.getTotalSize(), position: "relative" }}>
+              {virtualItems.map((virtualRow) => {
+                const row = rows[virtualRow.index];
+                if (!row) {
+                  return null;
+                }
+                return (
+                  <div
+                    key={row.id}
+                    role="row"
+                    className={`${styles.row} ${styles.virtualRow}`}
+                    style={{
+                      gridTemplateColumns,
+                      borderColor: token.colorSplit,
+                      transform: `translateY(${String(virtualRow.start)}px)`,
+                      height: ROW_HEIGHT,
+                    }}
+                    onClick={() => {
+                      onOpenClient(row.original.id);
+                    }}
+                  >
+                    {row.getVisibleCells().map((cell) => (
+                      <div role="cell" key={cell.id} className={styles.cell}>
+                        {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                      </div>
+                    ))}
+                  </div>
+                );
+              })}
+            </div>
+          )}
+        </div>
+      </div>
+
+      <Flex justify="center" align="center" gap="small" className={styles.footer}>
+        {isFetchNextPageError ? (
+          <>
+            <Typography.Text type="danger">Не удалось загрузить следующих клиентов</Typography.Text>
+            <Button
+              onClick={() => {
+                void fetchNextPage();
+              }}
+            >
+              Повторить
+            </Button>
+          </>
+        ) : isFetchingNextPage ? (
+          <Typography.Text type="secondary">Загружаем ещё…</Typography.Text>
+        ) : !hasNextPage && rows.length > 0 ? (
+          <Typography.Text type="secondary">Больше клиентов нет</Typography.Text>
+        ) : null}
+      </Flex>
+    </Flex>
+  );
+};
diff --git a/src/widgets/clients-table/columns.tsx b/src/widgets/clients-table/columns.tsx
new file mode 100644
index 0000000..4710926
