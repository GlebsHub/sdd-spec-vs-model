@@ -0,0 +1,58 @@
+import { z } from "zod";
+import { CLIENT_COLUMN, CLIENT_COLUMN_IDS } from "@/entities/client";
+import type { ClientColumnId } from "@/entities/client";
+
+export type ColumnSettings = {
+  order: ClientColumnId[];
+  hidden: ClientColumnId[];
+};
+
+export const DEFAULT_COLUMN_SETTINGS: ColumnSettings = { order: [...CLIENT_COLUMN_IDS], hidden: [] };
+
+const ColumnIdSchema = z.enum(CLIENT_COLUMN);
+
+const isValidSettings = ({ order, hidden }: { order: ClientColumnId[]; hidden: ClientColumnId[] }): boolean =>
+  order.length === CLIENT_COLUMN_IDS.length &&
+  CLIENT_COLUMN_IDS.every((id) => order.includes(id)) &&
+  new Set(hidden).size === hidden.length &&
+  hidden.length < CLIENT_COLUMN_IDS.length;
+
+const ColumnSettingsSchema = z
+  .object({
+    order: z.array(ColumnIdSchema),
+    hidden: z.array(ColumnIdSchema),
+  })
+  .refine(isValidSettings);
+
+export const columnSettingsKey = (agentId: string): string => `clients-table-columns:v1:${agentId}`;
+
+const getStorage = (): Storage | undefined => {
+  try {
+    return window.localStorage;
+  } catch {
+    return undefined;
+  }
+};
+
+/** Невалидные данные и неизвестные колонки заменяются настройками по умолчанию. */
+export const readColumnSettings = (agentId: string): ColumnSettings => {
+  try {
+    const raw = getStorage()?.getItem(columnSettingsKey(agentId));
+    if (!raw) {
+      return DEFAULT_COLUMN_SETTINGS;
+    }
+    const result = ColumnSettingsSchema.safeParse(JSON.parse(raw));
+    return result.success ? result.data : DEFAULT_COLUMN_SETTINGS;
+  } catch {
+    return DEFAULT_COLUMN_SETTINGS;
+  }
+};
+
+/** Сбой записи (хранилище отключено или переполнено) не должен ломать таблицу: настройки остаются в памяти. */
+export const writeColumnSettings = (agentId: string, settings: ColumnSettings): void => {
+  try {
+    getStorage()?.setItem(columnSettingsKey(agentId), JSON.stringify(settings));
+  } catch {
+    return;
+  }
+};
