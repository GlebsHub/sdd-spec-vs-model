+import { describe, expect, it } from "vitest";
+import { parseClientsSearch } from "@/entities/client";
+import { parseSearch, stringifySearch } from "./searchParams";
+
+describe("сериализация адресной строки (AC-10)", () => {
+  it("пишет статусы через запятую и сортировку с двоеточием без экранирования", () => {
+    expect(stringifySearch({ status: ["LEAD", "FUNDED"], sort: "commissionKopecks:asc" })).toBe(
+      "?status=LEAD,FUNDED&sort=commissionKopecks:asc",
+    );
+  });
+
+  it("не пишет незаданные и пустые значения", () => {
+    expect(stringifySearch({ q: undefined, status: [], from: "" })).toBe("");
+  });
+
+  it("кодирует кириллицу и обратно разбирает её", () => {
+    const search = stringifySearch({ q: "Иванов Пётр" });
+    expect(search).toBe(`?q=${encodeURIComponent("Иванов Пётр")}`);
+    expect(parseSearch(search)).toEqual({ q: "Иванов Пётр" });
+  });
+
+  it("значения остаются строками: «123» не превращается в число", () => {
+    expect(parseSearch("?q=123&from=2026-01-01")).toEqual({ q: "123", from: "2026-01-01" });
+  });
+
+  it("круговой проход: адрес → параметры → адрес", () => {
+    const url = "?q=Иванов&status=LEAD,FUNDED&from=2026-01-01&to=2026-03-31&sort=fullName:asc";
+    const search = parseClientsSearch(parseSearch(url));
+    expect(search).toEqual({
+      q: "Иванов",
+      status: ["LEAD", "FUNDED"],
+      from: "2026-01-01",
+      to: "2026-03-31",
+      sort: "fullName:asc",
+    });
+    expect(parseSearch(stringifySearch(search))).toEqual(parseSearch(url));
+  });
+});
