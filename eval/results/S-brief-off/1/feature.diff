+import { SearchOutlined } from "@ant-design/icons";
+import { Button, DatePicker, Flex, Input, Select, Typography } from "antd";
+import dayjs from "dayjs";
+import { useEffect, useRef, useState } from "react";
+import type { ReactNode } from "react";
+import { CLIENT_STATUS_LABEL, CLIENT_STATUS_ORDER, MIN_QUERY_LENGTH } from "@/entities/client";
+import styles from "./ClientFiltersPanel.module.css";
+import { useClientsFilters } from "./useClientsFilters";
+
+const SEARCH_DEBOUNCE_MS = 300;
+const URL_DATE_FORMAT = "YYYY-MM-DD";
+const VIEW_DATE_FORMAT = "DD.MM.YYYY";
+
+const STATUS_OPTIONS = CLIENT_STATUS_ORDER.map((status) => ({ value: status, label: CLIENT_STATUS_LABEL[status] }));
+
+export type ClientFiltersPanelProps = {
+  /** Дополнительные элементы справа от фильтров. */
+  extra?: ReactNode;
+};
+
+export const ClientFiltersPanel = ({ extra }: ClientFiltersPanelProps) => {
+  const { search, hasActiveFilters, setQuery, setStatuses, setDateRange, reset } = useClientsFilters();
+
+  // Текст в поле живёт отдельно от URL до debounce; lastCommitted отличает свой же коммит от внешней смены URL.
+  const [draft, setDraft] = useState(search.q);
+  const lastCommitted = useRef(search.q);
+
+  useEffect(() => {
+    if (search.q !== lastCommitted.current) {
+      setDraft(search.q);
+    }
+    lastCommitted.current = search.q;
+  }, [search.q]);
+
+  useEffect(() => {
+    const trimmed = draft.trim();
+    const isCommittable = trimmed === "" || trimmed.length >= MIN_QUERY_LENGTH;
+    if (!isCommittable || trimmed === lastCommitted.current) {
+      return;
+    }
+    const timer = setTimeout(() => {
+      lastCommitted.current = trimmed;
+      setQuery(trimmed);
+    }, SEARCH_DEBOUNCE_MS);
+    return () => {
+      clearTimeout(timer);
+    };
+  }, [draft, setQuery]);
+
+  const isQueryTooShort = draft.trim().length > 0 && draft.trim().length < MIN_QUERY_LENGTH;
+
+  return (
+    <Flex wrap gap="small" align="flex-start">
+      <Flex vertical gap="small" className={styles.search}>
+        <Input
+          allowClear
+          prefix={<SearchOutlined aria-hidden />}
+          placeholder="Поиск по ФИО"
+          aria-label="Поиск по ФИО"
+          status={isQueryTooShort ? "warning" : undefined}
+          value={draft}
+          onChange={(event) => {
+            setDraft(event.target.value);
+          }}
+        />
+        {isQueryTooShort && (
+          <Typography.Text type="secondary">Введите минимум {MIN_QUERY_LENGTH} символа</Typography.Text>
+        )}
+      </Flex>
+      <Select
+        mode="multiple"
+        allowClear
+        className={styles.status}
+        placeholder="Статус"
+        aria-label="Статус"
+        maxTagCount="responsive"
+        options={STATUS_OPTIONS}
+        value={search.status}
+        onChange={setStatuses}
+      />
+      <DatePicker.RangePicker
+        className={styles.dates}
+        allowEmpty={[true, true]}
+        format={VIEW_DATE_FORMAT}
+        placeholder={["Регистрация с", "по"]}
+        value={[
+          search.dateFrom === undefined ? null : dayjs(search.dateFrom, URL_DATE_FORMAT),
+          search.dateTo === undefined ? null : dayjs(search.dateTo, URL_DATE_FORMAT),
+        ]}
+        onChange={(range) => {
+          setDateRange(range?.[0]?.format(URL_DATE_FORMAT), range?.[1]?.format(URL_DATE_FORMAT));
+        }}
+      />
+      <Button onClick={reset} disabled={!hasActiveFilters}>
+        Сбросить
+      </Button>
+      {extra}
+    </Flex>
+  );
+};
