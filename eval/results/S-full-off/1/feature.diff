+import { infiniteQueryOptions, keepPreviousData } from "@tanstack/react-query";
+import { clientKeys } from "@/shared/api";
+import { fetchClients } from "./api";
+import { CLIENTS_GC_TIME_MS, CLIENTS_STALE_TIME_MS } from "./constants";
+import type { ClientListParams } from "./types";
+
+const FIRST_PAGE_CURSOR: string | undefined = undefined;
+
+export const clientQueries = {
+  list: (params: ClientListParams) =>
+    infiniteQueryOptions({
+      queryKey: clientKeys.list(params),
+      queryFn: ({ pageParam, signal }) => fetchClients({ params, cursor: pageParam, signal }),
+      initialPageParam: FIRST_PAGE_CURSOR,
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+      staleTime: CLIENTS_STALE_TIME_MS,
+      gcTime: CLIENTS_GC_TIME_MS,
+      placeholderData: keepPreviousData,
+      // Ошибку предзагрузки в loader показывает страница; повтор запускает пользователь.
+      retryOnMount: false,
+    }),
+};
diff --git a/src/entities/client/schema.ts b/src/entities/client/schema.ts
new file mode 100644
index 0000000..03fc880
--- /dev/null
+++ b/src/entities/client/schema.ts
@@ -0,0 +1,83 @@
+import { z } from "zod";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, ClientStatusSchema, SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+import { CLIENT_STATUS_ORDER, DEFAULT_SORT } from "./constants";
+
+export {
+  CLIENT_SORT_FIELD,
+  CLIENT_STATUS,
+  ClientListResponseSchema,
+  ClientSchema,
+  ClientStatusSchema,
+  SORT_DIRECTION,
+} from "@/shared/api";
+
+const MIN_QUERY_LENGTH = 2;
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+const isCalendarDate = (value: string): boolean => {
+  if (!DATE_RE.test(value)) {
+    return false;
+  }
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+};
+
+const isStatus = (value: string): value is ClientStatus => Object.hasOwn(CLIENT_STATUS, value);
+const isSortField = (value: string): value is ClientSortField => Object.hasOwn(CLIENT_SORT_FIELD, value);
+const isDirection = (value: string): value is SortDirection => Object.hasOwn(SORT_DIRECTION, value);
+
+export const toSortParam = (field: ClientSortField, direction: SortDirection): `${ClientSortField}:${SortDirection}` =>
+  `${field}:${direction}`;
+
+/** Любое значение, не прошедшее проверку, превращается в `undefined`: параметр считается незаданным. */
+const parseQ = (value: unknown): string | undefined => {
+  if (typeof value !== "string") {
+    return undefined;
+  }
+  const trimmed = value.trim();
+  return trimmed.length >= MIN_QUERY_LENGTH ? trimmed : undefined;
+};
+
+const parseStatuses = (value: unknown): ClientStatus[] | undefined => {
+  const parts: unknown[] = Array.isArray(value) ? value : typeof value === "string" ? value.split(",") : [];
+  const selected = new Set(parts.filter((part): part is string => typeof part === "string").filter(isStatus));
+  const ordered = CLIENT_STATUS_ORDER.filter((status) => selected.has(status));
+  return ordered.length > 0 ? ordered : undefined;
+};
+
+const parseDate = (value: unknown): string | undefined =>
+  typeof value === "string" && isCalendarDate(value) ? value : undefined;
+
+const parseSort = (value: unknown): `${ClientSortField}:${SortDirection}` | undefined => {
+  if (typeof value !== "string") {
+    return undefined;
+  }
+  const [field = "", direction = "", ...extra] = value.split(":");
+  if (!isSortField(field) || !isDirection(direction) || extra.length > 0) {
+    return undefined;
+  }
+  const isDefault = field === DEFAULT_SORT.field && direction === DEFAULT_SORT.direction;
+  return isDefault ? undefined : toSortParam(field, direction);
+};
+
+/**
+ * Параметры адресной строки раздела (спецификация, п. 9.1).
+ * Некорректное значение превращается в «не задано», значения по умолчанию в URL не пишутся.
+ */
+export const ClientsSearchSchema = z.object({
+  q: z.unknown().transform(parseQ).optional(),
+  status: z.unknown().transform(parseStatuses).optional(),
+  from: z.unknown().transform(parseDate).optional(),
+  to: z.unknown().transform(parseDate).optional(),
+  sort: z.unknown().transform(parseSort).optional(),
+});
+
+/** Параметры запроса списка, от которых зависит ответ API (без курсора и размера порции). */
+export const ClientListParamsSchema = z.object({
+  q: z.string().optional(),
+  status: z.array(ClientStatusSchema).optional(),
+  dateFrom: z.string().optional(),
+  dateTo: z.string().optional(),
+  sort: z.string().optional(),
+});
