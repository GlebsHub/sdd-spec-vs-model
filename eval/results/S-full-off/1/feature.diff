index 0000000..3379a21
--- /dev/null
+++ b/src/widgets/clients-table/ClientsTable.test.tsx
@@ -0,0 +1,481 @@
+import { configure, screen, waitFor, within } from "@testing-library/react";
+import { beforeAll, describe, expect, it, vi } from "vitest";
+import {
+  MOCK_SCENARIO,
+  getClientsDb,
+  getRequestLog,
+  parseClientsQuery,
+  selectClients,
+  setMockScenario,
+} from "@/mocks";
+import { formatMoney } from "@/shared/lib/money";
+import { renderApp } from "@/test";
+import { ROW_HEIGHT } from "./constants";
+
+const COLUMN_TITLES_BY_DEFAULT = ["ФИО", "Телефон", "Статус", "Дата регистрации", "Комиссия"];
+const ERROR_TEXT = "Не удалось загрузить клиентов";
+
+beforeAll(() => {
+  configure({ asyncUtilTimeout: 5000 });
+  vi.setConfig({ testTimeout: 20_000 });
+});
+
+/** Ждёт, пока скелетон сменится строками, и возвращает строки данных без заголовка. */
+const loadedRows = async (): Promise<[HTMLElement, ...HTMLElement[]]> => {
+  await waitFor(() => {
+    expect(screen.queryAllByTestId("clients-skeleton-row")).toHaveLength(0);
+    expect(screen.getAllByRole("row").length).toBeGreaterThan(1);
+  });
+  const [first, ...rest] = screen.getAllByRole("row").slice(1);
+  if (!first) {
+    throw new Error("Нет строк данных");
+  }
+  return [first, ...rest];
+};
+
+const listRequests = () => getRequestLog().filter((request) => request.path === "/api/agent/clients");
+const sleep = (ms: number) =>
+  new Promise<void>((resolve) => {
+    setTimeout(resolve, ms);
+  });
+
+/** У jsdom нет раскладки: «растягиваем» контейнер, чтобы виртуализатор видел 60 строк. */
+const mockTallViewport = () => {
+  vi.spyOn(Element.prototype, "clientHeight", "get").mockReturnValue(ROW_HEIGHT * 60);
+};
+
+describe("загрузка и отображение (AC-01, AC-02, AC-03)", () => {
+  it("сначала скелетон на 10 строк с доступной панелью фильтров, затем первые 50 клиентов", async () => {
+    setMockScenario({ delayMs: 200 });
+    await renderApp();
+
+    expect(screen.getAllByTestId("clients-skeleton-row")).toHaveLength(10);
+    expect(screen.getByRole("textbox", { name: "Поиск по ФИО" })).toBeEnabled();
+
+    await loadedRows();
+    const [first] = listRequests();
+    expect(first?.params).toEqual({ limit: "50" });
+    expect(screen.getByRole("heading", { name: "Мои клиенты" })).toHaveTextContent(/10\s000/);
+  });
+
+  it("колонки, порядок и форматы соответствуют спецификации; «Продуктов» скрыта", async () => {
+    await renderApp();
+    const rows = await loadedRows();
+
+    expect(screen.getAllByRole("columnheader").map((header) => header.textContent)).toEqual(COLUMN_TITLES_BY_DEFAULT);
+    expect(screen.queryByRole("columnheader", { name: "Продуктов" })).not.toBeInTheDocument();
+
+    const expected = selectClients(getClientsDb(), parseClientsQuery(new URLSearchParams("limit=50")))[0];
+    const cells = within(rows[0]).getAllByRole("cell");
+    expect(cells).toHaveLength(5);
+    expect(cells[0]).toHaveTextContent(expected?.fullName ?? "");
+    expect(cells[1]).toHaveTextContent(expected?.phoneMasked ?? "");
+
+    const date = new Date(expected?.registeredAt ?? "");
+    const day = String(date.getDate()).padStart(2, "0");
+    const month = String(date.getMonth() + 1).padStart(2, "0");
+    expect(cells[3]).toHaveTextContent(`${day}.${month}.${String(date.getFullYear())}`);
+  });
+
+  it("статус передаётся текстом", async () => {
+    await renderApp();
+    const rows = await loadedRows();
+    const labels = ["Зарегистрирован", "Открыл счёт", "Пополнил счёт", "Неактивен"];
+    const statusCell = within(rows[0]).getAllByRole("cell")[2];
+    expect(labels.some((label) => statusCell?.textContent === label)).toBe(true);
+  });
+
+  it("комиссия форматируется через formatMoney, включая 5 и 0 копеек", async () => {
+    await renderApp();
+    const rows = await loadedRows();
+    const commissions = rows.slice(0, 3).map((row) => within(row).getAllByRole("cell")[4]);
+
+    expect(commissions.map((cell) => cell?.textContent)).toEqual([
+      formatMoney(1_234_567),
+      formatMoney(5),
+      formatMoney(0),
+    ]);
+    expect(commissions[0]).toHaveTextContent("12 345,67 ₽");
+    expect(commissions[1]).toHaveTextContent("0,05 ₽");
+    expect(commissions[2]).toHaveTextContent("0,00 ₽");
+  });
+
+  it("по умолчанию отсортировано по дате регистрации по убыванию", async () => {
+    await renderApp();
+    await loadedRows();
+    expect(screen.getByRole("columnheader", { name: "Дата регистрации" })).toHaveAttribute("aria-sort", "descending");
+  });
+});
+
+describe("поиск (AC-04)", () => {
+  it("посимвольный ввод «Иванов» отправляет ровно один запрос с q=Иванов", async () => {
+    const { user, router } = await renderApp();
+    await loadedRows();
+    const before = listRequests().length;
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "Иванов");
+    await waitFor(() => {
+      expect(listRequests()).toHaveLength(before + 1);
+    });
+    await sleep(500);
+
+    const added = listRequests().slice(before);
+    expect(added).toHaveLength(1);
+    expect(added[0]?.params["q"]).toBe("Иванов");
+    expect(router.state.location.searchStr).toBe(`?q=${encodeURIComponent("Иванов")}`);
+  });
+
+  it("при длине 0–1 символ параметр q не передаётся", async () => {
+    const { user } = await renderApp();
+    await loadedRows();
+    const before = listRequests().length;
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), " и ");
+    await sleep(500);
+
+    expect(listRequests()).toHaveLength(before);
+  });
+});
+
+describe("фильтры (AC-05, AC-06, AC-10)", () => {
+  it("статус и период из адреса уходят в запрос", async () => {
+    await renderApp({ url: "/clients?status=LEAD,FUNDED&from=2026-01-01&to=2026-03-31" });
+    await loadedRows();
+
+    expect(listRequests()[0]?.params).toEqual({
+      limit: "50",
+      status: "LEAD,FUNDED",
+      dateFrom: "2026-01-01",
+      dateTo: "2026-03-31",
+    });
+  });
+
+  it("можно задать только начало или только конец периода", async () => {
+    await renderApp({ url: "/clients?from=2026-01-01" });
+    await loadedRows();
+    expect(listRequests()[0]?.params).toEqual({ limit: "50", dateFrom: "2026-01-01" });
+  });
+
+  it("выбор статуса пишет его в адрес и запрашивает первую порцию", async () => {
+    const { user, router } = await renderApp();
+    await loadedRows();
+
+    await user.click(screen.getByRole("combobox", { name: "Статус" }));
+    await user.click(await screen.findByTitle("Открыл счёт"));
+
+    await waitFor(() => {
+      expect(listRequests().at(-1)?.params["status"]).toBe("ACCOUNT_OPENED");
+    });
+    expect(listRequests().at(-1)?.params["cursor"]).toBeUndefined();
+    expect(router.state.location.searchStr).toBe("?status=ACCOUNT_OPENED");
+  });
+
+  it("кнопка «Сбросить фильтры» видна только при заданных фильтрах и не сбрасывает сортировку", async () => {
+    const { user, router } = await renderApp({ url: "/clients?status=LEAD&sort=commissionKopecks:asc" });
+    await loadedRows();
+
+    await user.click(screen.getByRole("button", { name: "Сбросить фильтры" }));
+
+    await waitFor(() => {
+      expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument();
+    });
+    expect(router.state.location.searchStr).toBe("?sort=commissionKopecks:asc");
+    await waitFor(() => {
+      expect(listRequests().at(-1)?.params).toEqual({ limit: "50", sort: "commissionKopecks:asc" });
+    });
+  });
+
+  it("без фильтров кнопки сброса нет; сортировка фильтром не считается", async () => {
+    await renderApp({ url: "/clients?sort=fullName:asc" });
+    await loadedRows();
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument();
+  });
+
+  it("сброс очищает и поле поиска", async () => {
