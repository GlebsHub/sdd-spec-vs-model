+import { SearchOutlined } from "@ant-design/icons";
+import { Button, DatePicker, Flex, Input, Select } from "antd";
+import dayjs from "dayjs";
+import type { Dayjs } from "dayjs";
+import { useEffect, useState } from "react";
+import { CLIENT_STATUS, CLIENT_STATUS_TITLE } from "@/entities/client";
+import type { ClientStatus } from "@/entities/client";
+import { parseStatusParam } from "./clientsSearch";
+import type { ClientsSearch } from "./clientsSearch";
+
+const SEARCH_DEBOUNCE_MS = 300;
+const STATUS_OPTIONS = Object.values(CLIENT_STATUS).map((status) => ({
+  value: status,
+  label: CLIENT_STATUS_TITLE[status],
+}));
+
+export type ClientFiltersProps = {
+  search: ClientsSearch;
+  onChange: (patch: Partial<ClientsSearch>, options?: { replace?: boolean }) => void;
+};
+
+const toDateParam = (date: Dayjs | null): string => (date ? date.format("YYYY-MM-DD") : "");
+const dateValue = (param: string): Dayjs => dayjs(param);
+
+export const ClientFilters = ({ search, onChange }: ClientFiltersProps) => {
+  const q = search.q ?? "";
+  const [text, setText] = useState(q);
+
+  useEffect(() => {
+    setText(q);
+  }, [q]);
+
+  useEffect(() => {
+    if (text === q) {
+      return;
+    }
+    const timer = setTimeout(() => {
+      onChange({ q: text }, { replace: true });
+    }, SEARCH_DEBOUNCE_MS);
+    return () => {
+      clearTimeout(timer);
+    };
+  }, [text, q, onChange]);
+
+  const hasFilters = Boolean(text || search.status || search.dateFrom || search.dateTo);
+
+  return (
+    <Flex wrap gap="middle" align="center">
+      <Input
+        allowClear
+        prefix={<SearchOutlined aria-hidden />}
+        placeholder="Поиск по ФИО"
+        aria-label="Поиск по ФИО"
+        value={text}
+        onChange={(event) => {
+          setText(event.target.value);
+        }}
+        style={{ width: 260 }}
+      />
+      <Select
+        mode="multiple"
+        virtual={false}
+        allowClear
+        placeholder="Статус"
+        aria-label="Статус"
+        options={STATUS_OPTIONS}
+        value={parseStatusParam(search.status ?? "")}
+        onChange={(values: ClientStatus[]) => {
+          onChange({ status: values.join(",") });
+        }}
+        style={{ minWidth: 220 }}
+      />
+      <DatePicker
+        placeholder="Зарегистрирован с"
+        aria-label="Зарегистрирован с"
+        value={search.dateFrom ? dateValue(search.dateFrom) : null}
+        onChange={(date: Dayjs | null) => {
+          onChange({ dateFrom: toDateParam(date) });
+        }}
+      />
+      <DatePicker
+        placeholder="Зарегистрирован по"
+        aria-label="Зарегистрирован по"
+        value={search.dateTo ? dateValue(search.dateTo) : null}
+        onChange={(date: Dayjs | null) => {
+          onChange({ dateTo: toDateParam(date) });
+        }}
+      />
+      <Button
+        disabled={!hasFilters}
+        onClick={() => {
+          setText("");
+          onChange({ q: "", status: "", dateFrom: "", dateTo: "" });
+        }}
+      >
+        Сбросить
+      </Button>
+    </Flex>
+  );
+};
