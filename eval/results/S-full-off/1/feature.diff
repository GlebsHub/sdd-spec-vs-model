+import { z } from "zod";
+import { CLIENT_COLUMN_META, CLIENT_COLUMN_ORDER } from "@/entities/client";
+
+/** Видимость колонок по id. Тип совместим с `columnVisibility` TanStack Table. */
+export type ColumnVisibility = Record<string, boolean>;
+
+const STORAGE_KEY_PREFIX = "agent-cabinet:clients:columns:v1";
+
+const StoredVisibilitySchema = z.record(z.string(), z.boolean());
+
+export const columnsStorageKey = (agentId: string): string => `${STORAGE_KEY_PREFIX}:${agentId}`;
+
+/** Неизвестные колонки отбрасываются, недостающие берутся по умолчанию, колонку, которую нельзя скрыть, показываем всегда. */
+const resolveVisibility = (stored: ColumnVisibility): ColumnVisibility => {
+  const result: ColumnVisibility = {};
+  for (const id of CLIENT_COLUMN_ORDER) {
+    const meta = CLIENT_COLUMN_META[id];
+    result[id] = !meta.hideable || (stored[id] ?? meta.visibleByDefault);
+  }
+  return result;
+};
+
+export const defaultColumnVisibility = (): ColumnVisibility => resolveVisibility({});
+
+/** Читает настройки агента. Невалидные данные и ошибки доступа к хранилищу дают значения по умолчанию. */
+export const readColumnVisibility = (agentId: string): ColumnVisibility => {
+  try {
+    const raw = window.localStorage.getItem(columnsStorageKey(agentId));
+    if (raw === null) {
+      return defaultColumnVisibility();
+    }
+    const parsed = StoredVisibilitySchema.safeParse(JSON.parse(raw));
+    return parsed.success ? resolveVisibility(parsed.data) : defaultColumnVisibility();
+  } catch {
+    return defaultColumnVisibility();
+  }
+};
+
+export const writeColumnVisibility = (agentId: string, visibility: ColumnVisibility): void => {
+  try {
+    window.localStorage.setItem(columnsStorageKey(agentId), JSON.stringify(visibility));
+  } catch {
+    // Хранилище недоступно или переполнено: настройка действует до перезагрузки, таблица продолжает работать.
+  }
+};
+
+export const clearColumnVisibility = (agentId: string): void => {
+  try {
+    window.localStorage.removeItem(columnsStorageKey(agentId));
+  } catch {
+    // См. writeColumnVisibility.
+  }
+};
