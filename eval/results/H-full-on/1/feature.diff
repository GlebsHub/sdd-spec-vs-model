+++ b/src/widgets/clients-table/ClientsTable.tsx
@@ -0,0 +1,161 @@
+import { ArrowDownOutlined, ArrowUpOutlined } from "@ant-design/icons";
+import { useElementScrollRestoration } from "@tanstack/react-router";
+import { flexRender, getCoreRowModel, useReactTable } from "@tanstack/react-table";
+import type { VisibilityState } from "@tanstack/react-table";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import { Button, Skeleton, Typography, theme } from "antd";
+import { useEffect, useRef } from "react";
+import type { Client, ClientSort, ClientSortField } from "@/entities/client";
+import { SORT_DIRECTION } from "@/entities/client";
+import { COLUMN_WIDTH, SORT_FIELD_BY_COLUMN, clientColumns } from "./columns";
+import type { ClientColumnId } from "./columns";
+import { CLIENTS_TABLE_SCROLL_ID, OVERSCAN, PREFETCH_THRESHOLD, ROW_HEIGHT, SKELETON_ROWS } from "./constants";
+import styles from "./ClientsTable.module.css";
+
+export type ClientsTableProps = {
+  clients: Client[];
+  isPending: boolean;
+  columnVisibility: VisibilityState;
+  sort: ClientSort;
+  hasNextPage: boolean;
+  isFetchingNextPage: boolean;
+  isNextPageError: boolean;
+  onSortChange: (field: ClientSortField) => void;
+  onLoadNextPage: () => void;
+  onOpenClient: (clientId: string) => void;
+};
+
+export const ClientsTable = ({
+  clients,
+  isPending,
+  columnVisibility,
+  sort,
+  hasNextPage,
+  isFetchingNextPage,
+  isNextPageError,
+  onSortChange,
+  onLoadNextPage,
+  onOpenClient,
+}: ClientsTableProps) => {
+  const { token } = theme.useToken();
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const scrollEntry = useElementScrollRestoration({ id: CLIENTS_TABLE_SCROLL_ID });
+
+  const table = useReactTable({
+    data: clients,
+    columns: clientColumns,
+    getCoreRowModel: getCoreRowModel(),
+    getRowId: (client) => client.id,
+    manualSorting: true,
+    manualFiltering: true,
+    state: { columnVisibility },
+  });
+  const rows = table.getRowModel().rows;
+  const headers = table.getFlatHeaders();
+  const gridTemplateColumns = headers.map((header) => COLUMN_WIDTH[header.column.id as ClientColumnId]).join(" ");
+
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: OVERSCAN,
+    initialOffset: scrollEntry?.scrollY,
+  });
+  const virtualItems = virtualizer.getVirtualItems();
+  const lastVisibleIndex = virtualizer.range?.endIndex ?? -1;
+
+  useEffect(() => {
+    if (hasNextPage && !isFetchingNextPage && !isNextPageError && lastVisibleIndex >= rows.length - PREFETCH_THRESHOLD) {
+      onLoadNextPage();
+    }
+  }, [hasNextPage, isFetchingNextPage, isNextPageError, lastVisibleIndex, rows.length, onLoadNextPage]);
+
+  return (
+    <div role="table" aria-label="Мои клиенты" aria-busy={isPending}>
+      <div role="row" className={styles.row} style={{ gridTemplateColumns, borderBottom: `1px solid ${token.colorBorderSecondary}`, color: token.colorTextSecondary }}>
+        {headers.map((header) => {
+          const sortField = SORT_FIELD_BY_COLUMN[header.column.id as ClientColumnId];
+          const isSorted = sortField !== undefined && sort.field === sortField;
+          const title = flexRender(header.column.columnDef.header, header.getContext());
+          return (
+            <div
+              key={header.id}
+              role="columnheader"
+              aria-sort={isSorted ? (sort.direction === SORT_DIRECTION.asc ? "ascending" : "descending") : undefined}
+              className={styles.cell}
+            >
+              {sortField === undefined ? (
+                title
+              ) : (
+                <button type="button" className={styles.sortButton} onClick={() => onSortChange(sortField)}>
+                  {title}
+                  {isSorted && (sort.direction === SORT_DIRECTION.asc ? <ArrowUpOutlined aria-hidden /> : <ArrowDownOutlined aria-hidden />)}
+                </button>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {isPending ? (
+        Array.from({ length: SKELETON_ROWS }, (_, index) => (
+          <div key={index} role="row" className={styles.row} style={{ gridTemplateColumns, borderBottom: `1px solid ${token.colorBorderSecondary}` }}>
+            <Skeleton active paragraph={false} title={{ width: "100%" }} />
+          </div>
+        ))
+      ) : (
+        <div ref={scrollRef} className={styles.scroll} data-scroll-restoration-id={CLIENTS_TABLE_SCROLL_ID}>
+          <div style={{ height: virtualizer.getTotalSize(), position: "relative" }}>
+            {virtualItems.map((virtualRow) => {
+              const row = rows[virtualRow.index];
+              if (!row) {
+                return null;
+              }
+              return (
+                <div
+                  key={row.id}
+                  role="row"
+                  tabIndex={0}
+                  aria-rowindex={virtualRow.index + 1}
+                  className={styles.row}
+                  style={{
+                    gridTemplateColumns,
+                    height: ROW_HEIGHT,
+                    transform: `translateY(${String(virtualRow.start)}px)`,
+                    borderBottom: `1px solid ${token.colorBorderSecondary}`,
+                  }}
+                  onClick={() => onOpenClient(row.original.id)}
+                  onKeyDown={(event) => {
+                    if (event.key === "Enter") {
+                      onOpenClient(row.original.id);
+                    }
+                  }}
+                >
+                  {row.getVisibleCells().map((cell) => (
+                    <div key={cell.id} role="cell" className={styles.cell}>
+                      {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                    </div>
+                  ))}
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      )}
+
+      {!isPending && isFetchingNextPage && (
+        <Typography.Text role="status" type="secondary" className={styles.footer}>
+          Загружаем ещё…
+        </Typography.Text>
+      )}
+      {!isPending && isNextPageError && (
+        <div className={styles.footer}>
+          <Typography.Text type="danger">Не удалось загрузить клиентов</Typography.Text>{" "}
+          <Button type="link" onClick={onLoadNextPage}>
+            Повторить
+          </Button>
+        </div>
+      )}
+    </div>
+  );
+};
