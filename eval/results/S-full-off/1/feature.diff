+import { createColumnHelper } from "@tanstack/react-table";
+import { CLIENT_COLUMN, CLIENT_COLUMN_META, ClientStatusTag, formatRegisteredAt } from "@/entities/client";
+import type { Client } from "@/entities/client";
+import { formatMoney } from "@/shared/lib/money";
+
+const helper = createColumnHelper<Client>();
+
+/** Порядок колонок фиксированный (спецификация, п. 4.1). `size` — минимальная ширина в пикселях и вес при растяжении. */
+export const columns = [
+  helper.accessor("fullName", {
+    id: CLIENT_COLUMN.fullName,
+    header: CLIENT_COLUMN_META.fullName.title,
+    size: 280,
+    enableSorting: true,
+  }),
+  helper.accessor("phoneMasked", {
+    id: CLIENT_COLUMN.phoneMasked,
+    header: CLIENT_COLUMN_META.phoneMasked.title,
+    size: 180,
+    enableSorting: false,
+  }),
+  helper.accessor("status", {
+    id: CLIENT_COLUMN.status,
+    header: CLIENT_COLUMN_META.status.title,
+    size: 170,
+    enableSorting: false,
+    cell: (info) => <ClientStatusTag status={info.getValue()} />,
+  }),
+  helper.accessor("registeredAt", {
+    id: CLIENT_COLUMN.registeredAt,
+    header: CLIENT_COLUMN_META.registeredAt.title,
+    size: 170,
+    enableSorting: true,
+    cell: (info) => formatRegisteredAt(info.getValue()),
+  }),
+  helper.accessor("commissionKopecks", {
+    id: CLIENT_COLUMN.commissionKopecks,
+    header: CLIENT_COLUMN_META.commissionKopecks.title,
+    size: 160,
+    enableSorting: true,
+    cell: (info) => formatMoney(info.getValue()),
+  }),
+  helper.accessor("productsCount", {
+    id: CLIENT_COLUMN.productsCount,
+    header: CLIENT_COLUMN_META.productsCount.title,
+    size: 120,
+    enableSorting: false,
+    cell: (info) => String(info.getValue()),
+  }),
+];
+
+/** Суммы выравниваются по правому краю (спецификация, п. 4.3). */
+export const RIGHT_ALIGNED_COLUMNS: ReadonlySet<string> = new Set([CLIENT_COLUMN.commissionKopecks]);
