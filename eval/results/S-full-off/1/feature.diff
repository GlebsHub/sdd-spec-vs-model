+import { useNavigate } from "@tanstack/react-router";
+import { Button, Empty, Flex, Result, Typography } from "antd";
+import { useClients } from "@/entities/client";
+import { ColumnSettings, useColumnVisibility } from "@/features/column-settings";
+import { ClientsFilters, useClientsSearch } from "@/features/clients-filters";
+import { useCurrentAgent } from "@/shared/lib/session";
+import { ClientsGrid } from "./ClientsGrid";
+import styles from "./ClientsTable.module.css";
+
+const formatCount = (total: number): string => new Intl.NumberFormat("ru-RU").format(total);
+
+/** Раздел «Мои клиенты»: заголовок со счётчиком, фильтры, настройка колонок и таблица со всеми состояниями. */
+export const ClientsTable = () => {
+  const agent = useCurrentAgent();
+  const navigate = useNavigate();
+  const { params, sort, hasFilters, toggleSort, resetFilters } = useClientsSearch();
+  const {
+    clients,
+    total,
+    isPending,
+    isError,
+    isForbidden,
+    isPlaceholderData,
+    isFetchingNextPage,
+    isNextPageError,
+    hasNextPage,
+    loadMore,
+    retry,
+  } = useClients(params);
+  const { columnVisibility, setColumnVisible, resetColumns } = useColumnVisibility(agent.id);
+
+  const heading = (
+    <Typography.Title level={2} className={styles.title} aria-label="Мои клиенты">
+      Мои клиенты
+      {total === undefined ? null : (
+        <Typography.Text type="secondary" className={styles.count}>
+          {formatCount(total)}
+        </Typography.Text>
+      )}
+    </Typography.Title>
+  );
+
+  if (isForbidden) {
+    return (
+      <Flex vertical gap="middle" className={styles.root}>
+        {heading}
+        <Result status="403" title="Раздел недоступен. Обратитесь к персональному менеджеру" />
+      </Flex>
+    );
+  }
+
+  // Прежний пустой список, пока грузится новый, не показываем как «пусто».
+  const isLoading = isPending || (isPlaceholderData && clients?.length === 0);
+  const isEmpty = !isLoading && !isError && clients?.length === 0;
+  const isEmptyWithFilters = isEmpty && hasFilters;
+
+  const renderBody = () => {
+    if (isError) {
+      return (
+        <div className={styles.state}>
+          <Result
+            status="error"
+            title="Не удалось загрузить клиентов"
+            extra={<Button onClick={retry}>Повторить</Button>}
+          />
+        </div>
+      );
+    }
+    if (isEmpty) {
+      return (
+        <div className={styles.state}>
+          {hasFilters ? (
+            <Empty description="Ничего не найдено">
+              <Button onClick={resetFilters}>Сбросить фильтры</Button>
+            </Empty>
+          ) : (
+            <Empty description="У вас пока нет клиентов. Поделитесь реферальной ссылкой, чтобы пригласить первого" />
+          )}
+        </div>
+      );
+    }
+    return (
+      <ClientsGrid
+        clients={isLoading ? undefined : clients}
+        columnVisibility={columnVisibility}
+        sort={sort}
+        isStale={isPlaceholderData}
+        hasNextPage={hasNextPage}
+        isFetchingNextPage={isFetchingNextPage}
+        isNextPageError={isNextPageError}
+        onSort={toggleSort}
+        onLoadMore={loadMore}
+        onOpen={(clientId) => {
+          void navigate({ to: "/clients/$clientId", params: { clientId } });
+        }}
+      />
+    );
+  };
+
+  return (
+    <Flex vertical gap="middle" className={styles.root}>
+      {heading}
+      <Flex justify="space-between" align="flex-end" gap="middle" wrap>
+        <ClientsFilters showReset={!isEmptyWithFilters} />
+        <ColumnSettings columnVisibility={columnVisibility} onToggle={setColumnVisible} onReset={resetColumns} />
+      </Flex>
+      {renderBody()}
+    </Flex>
+  );
+};
