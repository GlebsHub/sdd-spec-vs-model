+import { SettingOutlined } from "@ant-design/icons";
+import { Button, Checkbox, Flex, Popover } from "antd";
+import { CLIENT_COLUMN_FIXED, CLIENT_COLUMN_LABEL, CLIENT_COLUMN_ORDER } from "./columns";
+import type { ClientColumnId, ColumnVisibility } from "./columns";
+
+export type ColumnSettingsButtonProps = {
+  visibility: ColumnVisibility;
+  onVisibleChange: (id: ClientColumnId, visible: boolean) => void;
+  onReset: () => void;
+};
+
+export const ColumnSettingsButton = ({ visibility, onVisibleChange, onReset }: ColumnSettingsButtonProps) => {
+  const content = (
+    <Flex vertical gap="small">
+      {CLIENT_COLUMN_ORDER.map((id) => (
+        <Checkbox
+          key={id}
+          checked={visibility[id]}
+          disabled={id === CLIENT_COLUMN_FIXED}
+          onChange={(event) => {
+            onVisibleChange(id, event.target.checked);
+          }}
+        >
+          {CLIENT_COLUMN_LABEL[id]}
+        </Checkbox>
+      ))}
+      <Button onClick={onReset}>По умолчанию</Button>
+    </Flex>
+  );
+
+  return (
+    <Popover trigger="click" placement="bottomRight" title="Колонки" content={content}>
+      <Button icon={<SettingOutlined aria-hidden />}>Настроить колонки</Button>
+    </Popover>
+  );
+};
