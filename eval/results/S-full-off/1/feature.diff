+import { describe, expect, it, vi } from "vitest";
+import {
+  clearColumnVisibility,
+  columnsStorageKey,
+  defaultColumnVisibility,
+  readColumnVisibility,
+  writeColumnVisibility,
+} from "./storage";
+
+describe("настройки колонок в localStorage (AC-13)", () => {
+  it("по умолчанию «Продуктов» скрыта, остальные видимы", () => {
+    expect(defaultColumnVisibility()).toEqual({
+      fullName: true,
+      phoneMasked: true,
+      status: true,
+      registeredAt: true,
+      commissionKopecks: true,
+      productsCount: false,
+    });
+    expect(readColumnVisibility("agent-1")).toEqual(defaultColumnVisibility());
+  });
+
+  it("сохранённое значение читается обратно, отдельно для каждого агента", () => {
+    writeColumnVisibility("agent-1", { ...defaultColumnVisibility(), phoneMasked: false });
+    expect(readColumnVisibility("agent-1").phoneMasked).toBe(false);
+    expect(readColumnVisibility("agent-2").phoneMasked).toBe(true);
+  });
+
+  it("«ФИО» скрыть нельзя, даже если в хранилище записано иное", () => {
+    window.localStorage.setItem(columnsStorageKey("agent-1"), JSON.stringify({ fullName: false, status: false }));
+    const visibility = readColumnVisibility("agent-1");
+    expect(visibility.fullName).toBe(true);
+    expect(visibility.status).toBe(false);
+  });
+
+  it("неизвестные колонки игнорируются, недостающие берутся по умолчанию", () => {
+    window.localStorage.setItem(columnsStorageKey("agent-1"), JSON.stringify({ ghost: true, productsCount: true }));
+    const visibility = readColumnVisibility("agent-1");
+    expect(visibility).not.toHaveProperty("ghost");
+    expect(visibility.productsCount).toBe(true);
+    expect(visibility.phoneMasked).toBe(true);
+  });
+
+  it("невалидные данные дают значения по умолчанию", () => {
+    for (const raw of ["не json", "[1,2]", '{"status":"no"}', "null"]) {
+      window.localStorage.setItem(columnsStorageKey("agent-1"), raw);
+      expect(readColumnVisibility("agent-1")).toEqual(defaultColumnVisibility());
+    }
+  });
+
+  it("ошибка доступа к хранилищу не ломает чтение и запись", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    vi.spyOn(Storage.prototype, "removeItem").mockImplementation(() => {
+      throw new Error("denied");
+    });
+    expect(readColumnVisibility("agent-1")).toEqual(defaultColumnVisibility());
+    expect(() => {
+      writeColumnVisibility("agent-1", defaultColumnVisibility());
+      clearColumnVisibility("agent-1");
+    }).not.toThrow();
+  });
+
+  it("сброс удаляет настройки агента", () => {
+    writeColumnVisibility("agent-1", { ...defaultColumnVisibility(), status: false });
+    clearColumnVisibility("agent-1");
+    expect(window.localStorage.getItem(columnsStorageKey("agent-1"))).toBeNull();
+    expect(readColumnVisibility("agent-1")).toEqual(defaultColumnVisibility());
+  });
+});
