diff --git a/src/shared/lib/scroll-restoration/scrollRestorationKey.ts b/src/shared/lib/scroll-restoration/scrollRestorationKey.ts
new file mode 100644
index 0000000..0b1d8c7
--- /dev/null
+++ b/src/shared/lib/scroll-restoration/scrollRestorationKey.ts
@@ -0,0 +1,12 @@
+import type { ParsedLocation } from "@tanstack/react-router";
+
+/**
+ * Префикс создаётся один раз при загрузке документа. После перезагрузки страницы он другой,
+ * поэтому позиции прокрутки прежнего документа не находятся и прокрутка не восстанавливается
+ * (спецификация, п. 9.2). Без префикса виртуализатор получил бы `initialOffset` при пустом списке.
+ */
+const DOCUMENT_PREFIX = Math.random().toString(36).slice(2);
+
+/** Ключ записи истории для восстановления прокрутки. Одна и та же функция нужна роутеру и `useElementScrollRestoration`. */
+export const getScrollRestorationKey = (location: ParsedLocation): string =>
+  `${DOCUMENT_PREFIX}:${location.state.__TSR_key ?? location.href}`;
diff --git a/src/widgets/clients-table/ClientsGrid.tsx b/src/widgets/clients-table/ClientsGrid.tsx
new file mode 100644
index 0000000..9990af0
--- /dev/null
+++ b/src/widgets/clients-table/ClientsGrid.tsx
@@ -0,0 +1,256 @@
+import { CaretDownOutlined, CaretUpOutlined, LoadingOutlined } from "@ant-design/icons";
+import { useElementScrollRestoration } from "@tanstack/react-router";
+import { flexRender, getCoreRowModel, useReactTable } from "@tanstack/react-table";
+import type { SortingState } from "@tanstack/react-table";
+import { observeElementRect, useVirtualizer } from "@tanstack/react-virtual";
+import type { Rect, Virtualizer } from "@tanstack/react-virtual";
+import { Button, Skeleton, Typography, theme } from "antd";
+import { useRef } from "react";
+import { CLIENT_SORT_FIELD } from "@/entities/client";
+import type { Client, ClientSortField, ResolvedSort } from "@/entities/client";
+import type { ColumnVisibility } from "@/features/column-settings";
+import { getScrollRestorationKey } from "@/shared/lib/scroll-restoration";
+import { columns, RIGHT_ALIGNED_COLUMNS } from "./columns";
+import styles from "./ClientsTable.module.css";
+import {
+  CLIENTS_SCROLL_ID,
+  FALLBACK_VIEWPORT_ROWS,
+  HEADER_HEIGHT,
+  OVERSCAN,
+  ROW_HEIGHT,
+  SKELETON_ROWS,
+} from "./constants";
+import { useLoadMore } from "./useLoadMore";
+
+const NO_CLIENTS: Client[] = [];
+const ARIA_SORT = { asc: "ascending", desc: "descending" } as const;
+
+const isSortField = (id: string): id is ClientSortField => Object.hasOwn(CLIENT_SORT_FIELD, id);
+
+/** Без раскладки (jsdom) высота контейнера нулевая, и виртуализатор не отрисовал бы ни одной строки. */
+const observeRectWithFallback = (instance: Virtualizer<HTMLDivElement, Element>, onRect: (rect: Rect) => void) =>
+  observeElementRect(instance, (rect) => {
+    onRect(rect.height > 0 ? rect : { ...rect, height: ROW_HEIGHT * FALLBACK_VIEWPORT_ROWS });
+  });
+
+export type ClientsGridProps = {
+  /** `undefined` — данных ещё нет, показывается скелетон. */
+  clients: Client[] | undefined;
+  columnVisibility: ColumnVisibility;
+  sort: ResolvedSort;
+  /** Список относится к прежним фильтрам, пока грузятся новые. */
+  isStale: boolean;
+  hasNextPage: boolean;
+  isFetchingNextPage: boolean;
+  isNextPageError: boolean;
+  onSort: (field: ClientSortField) => void;
+  onLoadMore: () => void;
+  onOpen: (clientId: string) => void;
+};
+
+export const ClientsGrid = ({
+  clients,
+  columnVisibility,
+  sort,
+  isStale,
+  hasNextPage,
+  isFetchingNextPage,
+  isNextPageError,
+  onSort,
+  onLoadMore,
+  onOpen,
+}: ClientsGridProps) => {
+  const { token } = theme.useToken();
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const restored = useElementScrollRestoration({ id: CLIENTS_SCROLL_ID, getKey: getScrollRestorationKey });
+
+  const sorting: SortingState = [{ id: sort.field, desc: sort.direction === "desc" }];
+  const table = useReactTable({
+    data: clients ?? NO_CLIENTS,
+    columns,
+    state: { sorting, columnVisibility },
+    getCoreRowModel: getCoreRowModel(),
+    manualSorting: true,
+    manualFiltering: true,
+    getRowId: (client) => client.id,
+  });
+
+  const rows = table.getRowModel().rows;
+  const visibleColumns = table.getVisibleLeafColumns();
+  const gridTemplateColumns = visibleColumns
+    .map((column) => `minmax(${String(column.getSize())}px, ${String(column.getSize())}fr)`)
+    .join(" ");
+  const minWidth = visibleColumns.reduce((sum, column) => sum + column.getSize(), 0);
+
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: OVERSCAN,
+    scrollMargin: HEADER_HEIGHT,
+    initialOffset: restored?.scrollY,
+    getItemKey: (index) => rows[index]?.id ?? index,
+    observeElementRect: observeRectWithFallback,
+  });
+  const virtualItems = virtualizer.getVirtualItems();
+
+  useLoadMore({
+    lastVisibleIndex: virtualizer.range?.endIndex ?? -1,
+    rowCount: rows.length,
+    hasNextPage,
+    isFetchingNextPage,
+    isNextPageError,
+    isStale,
+    onLoadMore,
+  });
+
+  const paddingInline = { paddingInline: token.paddingSM };
+  const rowBorder = `${String(token.lineWidth)}px ${token.lineType} ${token.colorSplit}`;
+
+  return (
+    <div
+      ref={scrollRef}
+      data-scroll-restoration-id={CLIENTS_SCROLL_ID}
+      className={styles.scroller}
+      style={{
+        background: token.colorBgContainer,
+        border: `${String(token.lineWidth)}px ${token.lineType} ${token.colorBorderSecondary}`,
+        borderRadius: token.borderRadiusLG,
+      }}
+    >
+      <table
+        role="table"
+        className={styles.table}
+        aria-rowcount={rows.length + 1}
+        aria-busy={clients === undefined || isStale}
+        style={{ minWidth }}
+      >
+        <thead role="rowgroup" className={styles.head} style={{ background: token.colorBgContainer }}>
+          {table.getHeaderGroups().map((headerGroup) => (
+            <tr
+              key={headerGroup.id}
+              role="row"
+              aria-rowindex={1}
+              className={styles.row}
+              style={{ gridTemplateColumns, height: HEADER_HEIGHT, borderBottom: rowBorder }}
+            >
+              {headerGroup.headers.map((header) => {
+                const columnId = header.column.id;
+                const sortField = header.column.getCanSort() && isSortField(columnId) ? columnId : undefined;
+                const direction = header.column.getIsSorted();
+                const content = flexRender(header.column.columnDef.header, header.getContext());
+                const alignment = RIGHT_ALIGNED_COLUMNS.has(columnId) ? styles.right : "";
+                return (
+                  <th
+                    key={header.id}
+                    role="columnheader"
+                    scope="col"
+                    aria-sort={direction ? ARIA_SORT[direction] : undefined}
+                    className={`${styles.cell} ${alignment} ${sortField ? styles.sortable : ""}`}
+                    style={{ ...paddingInline, fontWeight: token.fontWeightStrong }}
+                    onClick={
+                      sortField
+                        ? () => {
+                            onSort(sortField);
+                          }
+                        : undefined
+                    }
+                  >
+                    {sortField ? (
+                      <button type="button" className={styles.sortButton}>
+                        {content}
+                        {direction === "asc" ? <CaretUpOutlined aria-hidden /> : null}
+                        {direction === "desc" ? <CaretDownOutlined aria-hidden /> : null}
+                      </button>
+                    ) : (
+                      content
+                    )}
+                  </th>
+                );
+              })}
+            </tr>
+          ))}
+        </thead>
+        {clients === undefined ? (
+          <tbody role="rowgroup" className={styles.body}>
+            {Array.from({ length: SKELETON_ROWS }, (_, index) => (
+              <tr
+                key={index}
+                role="row"
+                data-testid="clients-skeleton-row"
+                className={styles.row}
+                style={{ gridTemplateColumns, height: ROW_HEIGHT, borderBottom: rowBorder }}
+              >
+                {visibleColumns.map((column) => (
+                  <td key={column.id} role="cell" className={styles.cell} style={paddingInline}>
+                    <Skeleton.Input active size="small" block />
+                  </td>
+                ))}
+              </tr>
+            ))}
+          </tbody>
+        ) : (
+          <tbody role="rowgroup" className={styles.body} style={{ height: virtualizer.getTotalSize() }}>
+            {virtualItems.map((item) => {
+              const row = rows[item.index];
+              if (!row) {
+                return null;
+              }
+              return (
+                <tr
+                  key={row.id}
+                  role="row"
+                  tabIndex={0}
+                  aria-rowindex={item.index + 2}
+                  className={`${styles.row} ${styles.virtualRow}`}
+                  style={{
+                    gridTemplateColumns,
+                    height: ROW_HEIGHT,
+                    transform: `translateY(${String(item.start - HEADER_HEIGHT)}px)`,
+                    borderBottom: rowBorder,
+                  }}
+                  onClick={() => {
+                    onOpen(row.original.id);
+                  }}
+                  onKeyDown={(event) => {
+                    if (event.key === "Enter" && event.target === event.currentTarget) {
+                      onOpen(row.original.id);
+                    }
+                  }}
+                >
+                  {row.getVisibleCells().map((cell) => (
+                    <td
+                      key={cell.id}
+                      role="cell"
+                      className={`${styles.cell} ${RIGHT_ALIGNED_COLUMNS.has(cell.column.id) ? styles.right : ""}`}
+                      style={paddingInline}
+                    >
+                      {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                    </td>
+                  ))}
+                </tr>
+              );
+            })}
+          </tbody>
+        )}
+      </table>
+      {isFetchingNextPage ? (
+        <div role="status" className={styles.footer} style={{ padding: token.paddingSM }}>
+          <LoadingOutlined aria-hidden />
+          Загружаем ещё…
+        </div>
+      ) : null}
+      {isNextPageError && !isFetchingNextPage ? (
+        <div className={styles.footer} style={{ padding: token.paddingSM }}>
+          <Typography.Text type="danger">Не удалось загрузить клиентов</Typography.Text>
+          <Button onClick={onLoadMore}>Повторить</Button>
+        </div>
+      ) : null}
+      {clients !== undefined && clients.length > 0 && !hasNextPage ? (
+        <div className={styles.footer} style={{ padding: token.paddingSM }}>
+          <Typography.Text type="secondary">Больше клиентов нет</Typography.Text>
+        </div>
+      ) : null}
+    </div>
+  );
+};
