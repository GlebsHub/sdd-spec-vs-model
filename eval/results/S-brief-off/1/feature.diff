+import { useInfiniteQuery } from "@tanstack/react-query";
+import type { InfiniteData } from "@tanstack/react-query";
+import { clientQueries } from "./queries";
+import type { Client, ClientListParams, ClientListResponse } from "./types";
+
+const NO_CLIENTS: Client[] = [];
+
+/** Модульная константа: select не пересчитывается без смены данных. */
+const selectClients = (data: InfiniteData<ClientListResponse, string | undefined>) => ({
+  clients: data.pages.flatMap((page) => page.items),
+  total: data.pages.at(-1)?.total ?? 0,
+});
+
+export const useClients = (params: ClientListParams) => {
+  const { data, isPending, isError, isFetching, isFetchingNextPage, isPlaceholderData, hasNextPage, fetchNextPage, refetch } =
+    useInfiniteQuery({ ...clientQueries.list(params), select: selectClients });
+
+  return {
+    clients: data?.clients ?? NO_CLIENTS,
+    total: data?.total ?? 0,
+    isPending,
+    isError,
+    isFetching,
+    isFetchingNextPage,
+    isPlaceholderData,
+    hasNextPage,
+    fetchNextPage,
+    refetch,
+  };
+};
