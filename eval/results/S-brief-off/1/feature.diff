+/** Параметры URL после проверки: все значения заданы (кроме дат). */
+export type ClientsSearch = z.infer<typeof ClientsSearchSchema>;
+
+/** Параметры URL на входе (ссылки, `navigate`): все необязательны. */
+export type ClientsSearchInput = {
