+import { expect, test } from "@playwright/test";
+import type { Locator, Page } from "@playwright/test";
+
+const CLIENTS_API = "/api/agent/clients";
+const SCROLLER = '[data-scroll-restoration-id="clients-list"]';
+
+const scrollerOf = (page: Page): Locator => page.locator(SCROLLER);
+
+const scrollTopOf = (page: Page): Promise<number> =>
+  scrollerOf(page).evaluate((element) => element.scrollTop);
+
+const firstVisibleRowIndex = async (page: Page): Promise<number> => {
+  const scrollerBox = await scrollerOf(page).boundingBox();
+  const rows = page.getByRole("row");
+  const count = await rows.count();
+  for (let index = 1; index < count; index += 1) {
+    const box = await rows.nth(index).boundingBox();
+    if (scrollerBox && box && box.y >= scrollerBox.y && box.y + box.height <= scrollerBox.y + scrollerBox.height) {
+      return index;
+    }
+  }
+  throw new Error("No data row is fully visible in the list");
+};
+
+test("прокрутка догружает следующую порцию", async ({ page }) => {
+  await page.goto("/clients");
+  await expect(page.getByRole("row").nth(1)).toBeVisible();
+
+  const nextPage = page.waitForRequest((request) => request.url().includes(CLIENTS_API) && request.url().includes("cursor="));
+  await scrollerOf(page).evaluate((element) => {
+    element.scrollTop = element.scrollHeight;
+  });
+  await nextPage;
+});
+
+test("карточка и «назад» восстанавливают фильтры, строки и позицию прокрутки", async ({ page }) => {
+  const firstPageRequests: string[] = [];
+  page.on("request", (request) => {
+    if (request.url().includes(CLIENTS_API) && !request.url().includes("cursor=")) {
+      firstPageRequests.push(request.url());
+    }
+  });
+
+  await page.goto("/clients?status=FUNDED&sort=fullName:asc");
+  await expect(page.getByRole("row").nth(1)).toBeVisible();
+
+  const loadedMore = page.waitForRequest((request) => request.url().includes("cursor="));
+  await scrollerOf(page).evaluate((element) => {
+    element.scrollTop = element.scrollHeight;
+  });
+  await loadedMore;
+  await expect.poll(() => scrollerOf(page).evaluate((element) => element.scrollHeight)).toBeGreaterThan(2800);
+  await scrollerOf(page).evaluate((element) => {
+    element.scrollTop = element.scrollHeight / 2;
+  });
+
+  const listUrl = page.url();
+  const scrollBefore = await scrollTopOf(page);
+  const requestsBefore = firstPageRequests.length;
+
+  const index = await firstVisibleRowIndex(page);
+  const openButton = page.getByRole("row").nth(index).getByRole("button").first();
+  await openButton.click();
+  await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+
+  await page.getByRole("button", { name: "Назад" }).click();
+  await expect(page).toHaveURL(listUrl);
+  await expect(page.getByRole("row").nth(1)).toBeVisible();
+  await expect.poll(async () => Math.abs((await scrollTopOf(page)) - scrollBefore)).toBeLessThan(2);
+  expect(firstPageRequests.length).toBe(requestsBefore);
+});
+
+test("ссылка с параметрами открывает то же состояние", async ({ page }) => {
+  await page.goto("/clients?status=FUNDED&sort=commissionKopecks:asc&q=Иванов");
+  await expect(page.getByRole("textbox", { name: "Поиск по ФИО" })).toHaveValue("Иванов");
+  await expect(page.getByText("Финансирован", { exact: true }).first()).toBeVisible();
+  await expect(page.getByRole("columnheader", { name: "Комиссия агента" })).toHaveAttribute("aria-sort", "ascending");
+  await expect(page.getByRole("row").nth(1)).toBeVisible();
+});
