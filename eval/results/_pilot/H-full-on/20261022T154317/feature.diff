--- /dev/null
+++ b/src/entities/client/useClients.ts
@@ -0,0 +1,23 @@
+import { useInfiniteQuery } from "@tanstack/react-query";
+import { useMemo } from "react";
+import { clientQueries } from "./queries";
+import type { ClientListFilters } from "./searchParams";
+
+export const useClients = (filters: ClientListFilters) => {
+  const query = useInfiniteQuery(clientQueries.list(filters));
+  const { data, error, isError, isPending, isFetchNextPageError, isFetchingNextPage, hasNextPage } = query;
+  const clients = useMemo(() => data?.pages.flatMap((page) => page.items) ?? [], [data]);
+
+  return {
+    clients,
+    total: data?.pages[0]?.total,
+    isPending,
+    isFirstPageError: isError && data === undefined,
+    isFetchNextPageError,
+    error,
+    hasNextPage,
+    isFetchingNextPage,
+    loadNextPage: query.fetchNextPage,
+    retry: query.refetch,
+  };
+};
