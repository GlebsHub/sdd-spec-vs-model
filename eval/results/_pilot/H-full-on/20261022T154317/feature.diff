+++ b/src/widgets/clients-table/columns.tsx
@@ -0,0 +1,55 @@
+import type { ColumnDef } from "@tanstack/react-table";
+import dayjs from "dayjs";
+import type { ReactNode } from "react";
+import type { Client, ClientSortField } from "@/entities/client";
+import { formatMoney } from "@/shared/lib/money";
+import { StatusTag } from "./StatusTag";
+
+export type ClientColumnId = "fullName" | "phoneMasked" | "status" | "registeredAt" | "commissionKopecks" | "productsCount";
+
+export type ClientColumn = {
+  id: ClientColumnId;
+  label: string;
+  hideable: boolean;
+  sortField?: ClientSortField;
+  align?: "right";
+  render: (client: Client) => ReactNode;
+};
+
+/** Порядок колонок фиксирован (п. 4.1). */
+export const CLIENT_COLUMNS: readonly ClientColumn[] = [
+  { id: "fullName", label: "ФИО", hideable: false, sortField: "fullName", render: (client) => client.fullName },
+  { id: "phoneMasked", label: "Телефон", hideable: true, render: (client) => client.phoneMasked },
+  { id: "status", label: "Статус", hideable: true, render: (client) => <StatusTag status={client.status} /> },
+  {
+    id: "registeredAt",
+    label: "Дата регистрации",
+    hideable: true,
+    sortField: "registeredAt",
+    render: (client) => dayjs(client.registeredAt).format("DD.MM.YYYY"),
+  },
+  {
+    id: "commissionKopecks",
+    label: "Комиссия",
+    hideable: true,
+    sortField: "commissionKopecks",
+    align: "right",
+    render: (client) => formatMoney(client.commissionKopecks),
+  },
+  { id: "productsCount", label: "Продуктов", hideable: true, render: (client) => client.productsCount },
+];
+
+export const CLIENT_COLUMN_IDS = CLIENT_COLUMNS.map((column) => column.id);
+
+export const HIDEABLE_COLUMNS = CLIENT_COLUMNS.filter((column) => column.hideable).map(({ id, label }) => ({ id, label }));
+
+export const DEFAULT_HIDDEN_COLUMN_IDS: readonly ClientColumnId[] = ["productsCount"];
+
+export const findClientColumn = (id: string): ClientColumn | undefined => CLIENT_COLUMNS.find((column) => column.id === id);
+
+export const CLIENT_TABLE_COLUMNS: ColumnDef<Client>[] = CLIENT_COLUMNS.map((column) => ({
+  id: column.id,
+  enableHiding: column.hideable,
+  enableSorting: false,
+  cell: ({ row }) => column.render(row.original),
+}));
