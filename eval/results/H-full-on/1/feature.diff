@@ -0,0 +1,24 @@
+import { keepPreviousData, useInfiniteQuery } from "@tanstack/react-query";
+import { clientQueries } from "./queries";
+import type { ClientsFilters } from "./types";
+
+export const useClients = (filters: ClientsFilters) => {
+  const { data, error, isError, isPending, isFetchingNextPage, isFetchNextPageError, hasNextPage, fetchNextPage, refetch } =
+    useInfiniteQuery({
+      ...clientQueries.list(filters),
+      placeholderData: keepPreviousData,
+    });
+
+  return {
+    clients: data?.pages.flatMap((page) => page.items) ?? [],
+    total: data?.pages[0]?.total,
+    error,
+    isPending,
+    isFirstPageError: isError && data === undefined,
+    isNextPageError: isFetchNextPageError,
+    isFetchingNextPage,
+    hasNextPage,
+    fetchNextPage,
+    retry: refetch,
+  };
+};
