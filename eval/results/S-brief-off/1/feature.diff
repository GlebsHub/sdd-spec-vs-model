--- /dev/null
+++ b/src/features/column-settings/useColumnSettings.ts
@@ -0,0 +1,68 @@
+import { functionalUpdate } from "@tanstack/react-table";
+import type { ColumnOrderState, OnChangeFn, VisibilityState } from "@tanstack/react-table";
+import { useState } from "react";
+import { useCurrentAgent } from "@/shared/lib/session";
+import { columnSettingsKey, defaultColumnSettings, normalizeColumnSettings, readColumnSettings, writeColumnSettings } from "./storage";
+import type { ColumnSettings } from "./types";
+
+type UseColumnSettingsOptions = {
+  /** Имя таблицы в ключе `localStorage`. */
+  scope: string;
+  /** Id всех колонок в порядке по умолчанию. */
+  columnIds: readonly string[];
+};
+
+/** Видимость и порядок колонок: состояние TanStack Table, синхронизированное с `localStorage` агента. */
+export const useColumnSettings = ({ scope, columnIds }: UseColumnSettingsOptions) => {
+  const agent = useCurrentAgent();
+  const storageKey = columnSettingsKey(scope, agent.id);
+  const [settings, setSettings] = useState(() => readColumnSettings(storageKey, columnIds));
+
+  const commit = (next: ColumnSettings) => {
+    // Скрыть все колонки нельзя: такое изменение игнорируется.
+    if (!Object.values(next.visibility).some(Boolean)) {
+      return;
+    }
+    const normalized = normalizeColumnSettings(next, columnIds);
+    setSettings(normalized);
+    writeColumnSettings(storageKey, normalized);
+  };
+
+  const onColumnVisibilityChange: OnChangeFn<VisibilityState> = (updater) => {
+    commit({ ...settings, visibility: { ...settings.visibility, ...functionalUpdate(updater, settings.visibility) } });
+  };
+
+  const onColumnOrderChange: OnChangeFn<ColumnOrderState> = (updater) => {
+    commit({ ...settings, order: functionalUpdate(updater, settings.order) });
+  };
+
+  const toggle = (id: string) => {
+    commit({ ...settings, visibility: { ...settings.visibility, [id]: !(settings.visibility[id] ?? true) } });
+  };
+
+  const move = (id: string, direction: -1 | 1) => {
+    const index = settings.order.indexOf(id);
+    const target = index + direction;
+    if (index === -1 || target < 0 || target >= settings.order.length) {
+      return;
+    }
+    const order = [...settings.order];
+    order.splice(index, 1);
+    order.splice(target, 0, id);
+    commit({ ...settings, order });
+  };
+
+  const reset = () => {
+    commit(defaultColumnSettings(columnIds));
+  };
+
+  return {
+    columnVisibility: settings.visibility,
+    columnOrder: settings.order,
+    onColumnVisibilityChange,
+    onColumnOrderChange,
+    toggle,
+    move,
+    reset,
+  };
+};
