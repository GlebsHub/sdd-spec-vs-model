+
+/** Высота строки фиксированная (спецификация, п. 8). */
+export const ROW_HEIGHT = 48;
+export const HEADER_HEIGHT = ROW_HEIGHT;
+
+/** Запас строк сверху и снизу от видимой области: не более 10 (спецификация, п. 8). */
+export const OVERSCAN = 10;
