+import { useCallback } from "react";
+import { getRouteApi } from "@tanstack/react-router";
+import type { ClientsSearch } from "@/entities/clients";
+
+const routeApi = getRouteApi("/clients");
+
+type UpdateOptions = { replace?: boolean };
+
+/** Единственный доступ к фильтрам и сортировке: они живут в адресной строке (п. 9.1). */
+export const useClientsSearchState = () => {
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+
+  const updateSearch = useCallback(
+    (patch: ClientsSearch, { replace = false }: UpdateOptions = {}) => {
+      void navigate({
+        search: (prev) => ({ ...prev, ...patch }),
+        replace,
+      });
+    },
+    [navigate],
+  );
+
+  const resetFilters = useCallback(() => {
+    updateSearch({ q: undefined, status: undefined, from: undefined, to: undefined });
+  }, [updateSearch]);
+
+  const hasFilters = Boolean(search.q || search.status || search.from || search.to);
+
+  return { search, updateSearch, resetFilters, hasFilters };
+};
