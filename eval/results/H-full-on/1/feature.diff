+import { Button, Checkbox, Flex, Popover } from "antd";
+import { useState } from "react";
+import type { ColumnVisibilityOption } from "./useColumnVisibility";
+
+export type ColumnsSettingsProps = {
+  columns: readonly (ColumnVisibilityOption & { title: string })[];
+  visibility: Record<string, boolean | undefined>;
+  onToggle: (columnId: string, visible: boolean) => void;
+  onReset: () => void;
+};
+
+export const ColumnsSettings = ({ columns, visibility, onToggle, onReset }: ColumnsSettingsProps) => {
+  const [open, setOpen] = useState(false);
+
+  const content = (
+    <Flex vertical gap="small">
+      {columns.map((column) => (
+        <Checkbox
+          key={column.id}
+          checked={visibility[column.id] ?? column.defaultVisible}
+          disabled={!column.hideable}
+          onChange={(event) => {
+            onToggle(column.id, event.target.checked);
+          }}
+        >
+          {column.title}
+        </Checkbox>
+      ))}
+      <Button type="link" onClick={onReset}>
+        По умолчанию
+      </Button>
+    </Flex>
+  );
+
+  return (
+    <Popover content={content} trigger="click" open={open} onOpenChange={setOpen} placement="bottomRight">
+      <Button>Настроить колонки</Button>
+    </Popover>
+  );
+};
