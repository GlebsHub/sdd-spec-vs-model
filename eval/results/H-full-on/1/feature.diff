+import { infiniteQueryOptions } from "@tanstack/react-query";
+import { clientKeys } from "@/shared/api";
+import { fetchClients } from "./api";
+import type { ClientsFilters } from "./types";
+
+/** Список свежий 60 с: возврат из карточки в этом окне берёт кэш без запроса (спецификация, п. 9.2). */
+const LIST_STALE_TIME_MS = 60_000;
+
+export const clientQueries = {
+  list: (filters: ClientsFilters) =>
+    infiniteQueryOptions({
+      queryKey: clientKeys.list(filters),
+      queryFn: ({ pageParam, signal }) => fetchClients(filters, pageParam, signal),
+      // null — первая порция без курсора; приведение безопасно, потому что nextCursor имеет тип string | null.
+      initialPageParam: null as string | null,
+      getNextPageParam: (lastPage) => lastPage.nextCursor,
+      staleTime: LIST_STALE_TIME_MS,
+    }),
+};
