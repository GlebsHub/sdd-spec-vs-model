@@ -0,0 +1,392 @@
+import { screen, waitFor, within } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import {
+  MOCK_SCENARIO,
+  getClientsDb,
+  getRequestLog,
+  parseClientsQuery,
+  selectClients,
+  setMockScenario,
+} from "@/mocks";
+import { renderApp } from "@/test";
+
+const STORAGE_KEY = "agent-cabinet:clients-table:columns:v1:agent-1";
+const ALL_HEADERS = ["ФИО", "Телефон", "Статус", "Дата регистрации", "Комиссия"];
+
+const lastRequestParams = () => getRequestLog().at(-1)?.params;
+
+const rowAt = (index: number): HTMLElement => {
+  const row = screen.getAllByRole("row")[index];
+  if (!row) {
+    throw new Error(`В таблице нет строки ${String(index)}`);
+  }
+  return row;
+};
+
+/** Параметры адреса в виде раскодированных строк: не зависит от внутреннего представления роутера. */
+const urlSearch = (router: { state: { location: { href: string } } }) =>
+  Object.fromEntries(new URL(router.state.location.href, "http://localhost").searchParams);
+
+const findTable = () => screen.findByRole("table", { name: "Клиенты" });
+
+const headerTexts = () => screen.getAllByRole("columnheader").map((header) => header.textContent);
+
+const openColumnSettings = async (user: Awaited<ReturnType<typeof renderApp>>["user"]) => {
+  await user.click(screen.getByRole("button", { name: "Колонки" }));
+};
+
+describe("таблица клиентов: данные", () => {
+  it("показывает колонки и строки в порядке по умолчанию (новые сверху)", async () => {
+    await renderApp({ url: "/clients" });
+    await findTable();
+
+    expect(headerTexts()).toEqual(ALL_HEADERS);
+    const [first, second, third] = [rowAt(1), rowAt(2), rowAt(3)];
+    expect(first).toHaveTextContent("Пополнил");
+    expect(first).toHaveTextContent(/12\s345,67\s₽/);
+    expect(second).toHaveTextContent("Счёт открыт");
+    expect(second).toHaveTextContent(/0,05\s₽/);
+    expect(third).toHaveTextContent("Лид");
+    expect(third).toHaveTextContent(/0,00\s₽/);
+    expect(within(first).getAllByRole("cell")).toHaveLength(ALL_HEADERS.length);
+  });
+
+  it("запрашивает первую страницу с сортировкой по умолчанию и без фильтров", async () => {
+    await renderApp({ url: "/clients" });
+    await findTable();
+    expect(lastRequestParams()).toEqual({ limit: "50", sort: "registeredAt:desc" });
+  });
+
+  it("показывает общее число найденных клиентов", async () => {
+    await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Найдено клиентов: 10000")).toBeInTheDocument();
+  });
+
+  it("клик по строке открывает карточку клиента", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await findTable();
+    await user.click(rowAt(1));
+    expect(await screen.findByRole("heading", { name: "Карточка клиента" })).toBeInTheDocument();
+    expect(router.state.location.pathname).toMatch(/^\/clients\/[0-9a-f-]{36}$/);
+  });
+
+  it("Enter на строке открывает карточку клиента", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await findTable();
+    rowAt(1).focus();
+    await user.keyboard("{Enter}");
+    expect(await screen.findByRole("heading", { name: "Карточка клиента" })).toBeInTheDocument();
+  });
+});
+
+describe("таблица клиентов: состояния", () => {
+  it("первая загрузка: индикатор до прихода данных", async () => {
+    setMockScenario({ delayMs: 200 });
+    await renderApp({ url: "/clients" });
+    expect(screen.getByText("Загрузка клиентов…")).toBeInTheDocument();
+    await findTable();
+    expect(screen.queryByText("Загрузка клиентов…")).not.toBeInTheDocument();
+  });
+
+  it("пустой список у агента", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp({ url: "/clients" });
+    expect(await screen.findByText("У вас пока нет клиентов")).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument();
+  });
+
+  it("пустой результат при фильтрах: можно сбросить фильтры", async () => {
+    const { user, router } = await renderApp({ url: "/clients?q=ЯЯЯЯЯЯЯЯ" });
+    expect(await screen.findByText("По заданным условиям клиентов не найдено")).toBeInTheDocument();
+
+    await user.click(screen.getByRole("button", { name: "Сбросить фильтры" }));
+    await findTable();
+    expect(urlSearch(router)).toEqual({});
+  });
+
+  it("ошибка первой загрузки: можно повторить", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorFirstPage, failTimes: 1 });
+    const { user } = await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    await findTable();
+    expect(screen.queryByText("Не удалось загрузить клиентов")).not.toBeInTheDocument();
+  });
+
+  it("ответ не по контракту показывается как ошибка", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.malformed });
+    await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+  });
+
+  it("конец списка: все клиенты загружены", async () => {
+    const [client] = getClientsDb();
+    if (!client) {
+      throw new Error("Мок-бэкенд вернул пустую базу");
+    }
+    const expectedTotal = selectClients(getClientsDb(), parseClientsQuery(new URLSearchParams({ limit: "1", q: client.fullName }))).length;
+    await renderApp({ url: `/clients?q=${encodeURIComponent(client.fullName)}` });
+    expect(await screen.findByText("Показаны все клиенты")).toBeInTheDocument();
+    expect(screen.getByText(`Найдено клиентов: ${String(expectedTotal)}`)).toBeInTheDocument();
+  });
+
+  it("пока есть следующие страницы, надписи о конце списка нет", async () => {
+    await renderApp({ url: "/clients" });
+    await findTable();
+    expect(screen.queryByText("Показаны все клиенты")).not.toBeInTheDocument();
+  });
+});
+
+describe("таблица клиентов: поиск, фильтры, сортировка", () => {
+  it("поиск по ФИО: запрос уходит с debounce, запись в истории заменяется", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await findTable();
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "Иванов");
+
+    await waitFor(() => {
+      expect(lastRequestParams()).toMatchObject({ q: "Иванов" });
+    });
