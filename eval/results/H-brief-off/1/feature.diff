+import { expect, test } from "@playwright/test";
+
+const LIST_SELECTOR = '[data-scroll-restoration-id="clients-list"]';
+
+test("прокрутка догружает следующие страницы", async ({ page }) => {
+  await page.goto("/clients");
+  const list = page.locator(LIST_SELECTOR);
+  await expect(list.getByRole("row").first()).toBeVisible();
+
+  await list.evaluate((el) => {
+    el.scrollTop = el.scrollHeight;
+  });
+
+  await page.waitForFunction(() => window.__mocks?.getRequestLog().some((request) => "cursor" in request.params));
+});
+
+test("карточка и «назад» восстанавливают фильтры, сортировку, строки и прокрутку", async ({ page }) => {
+  await page.goto("/clients?sort=fullName:asc");
+  const list = page.locator(LIST_SELECTOR);
+  await expect(list.getByRole("row").first()).toBeVisible();
+
+  await list.evaluate((el) => {
+    el.scrollTop = 1400;
+  });
+  await expect.poll(() => list.evaluate((el) => el.scrollTop)).toBeGreaterThan(1000);
+  const scrollBefore = await list.evaluate((el) => el.scrollTop);
+  const requestsBefore = await page.evaluate(() => window.__mocks?.getRequestLog().length);
+
+  await list.getByRole("link").first().click();
+  await expect(page).toHaveURL(/\/clients\/[^/]+$/);
+  await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+
+  await page.goBack();
+  await expect(page).toHaveURL(/sort=fullName(:|%3A)asc/);
+  await expect(list.getByRole("row").first()).toBeVisible();
+  await expect
+    .poll(async () => Math.abs((await list.evaluate((el) => el.scrollTop)) - scrollBefore))
+    .toBeLessThan(2);
+  expect(await page.evaluate(() => window.__mocks?.getRequestLog().length)).toBe(requestsBefore);
+});
+
+test("ссылка с параметрами открывает то же состояние", async ({ page }) => {
+  await page.goto("/clients?status=LEAD&sort=commissionKopecks:asc");
+  await expect(page.locator('.ant-select-selection-item[title="Лид"]')).toBeVisible();
+
+  const lastParams = await page.evaluate(() => window.__mocks?.getRequestLog().at(-1)?.params);
+  expect(lastParams).toMatchObject({ status: "LEAD", sort: "commissionKopecks:asc" });
+});
+
+test("смена сортировки возвращает список к началу", async ({ page }) => {
+  await page.goto("/clients");
+  const list = page.locator(LIST_SELECTOR);
+  await expect(list.getByRole("row").first()).toBeVisible();
+
+  await list.evaluate((el) => {
+    el.scrollTop = 1400;
+  });
+  await expect.poll(() => list.evaluate((el) => el.scrollTop)).toBeGreaterThan(1000);
+
+  await page.getByRole("button", { name: "Комиссия агента" }).click();
+  await expect.poll(() => list.evaluate((el) => el.scrollTop)).toBe(0);
+});
