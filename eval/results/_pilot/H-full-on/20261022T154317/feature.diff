+import { SettingOutlined } from "@ant-design/icons";
+import { Button, Checkbox, Flex, Popover } from "antd";
+
+export type HideableColumn = { id: string; label: string };
+
+export type ColumnSettingsProps = {
+  columns: readonly HideableColumn[];
+  hidden: readonly string[];
+  onToggle: (id: string, visible: boolean) => void;
+  onReset: () => void;
+};
+
+export const ColumnSettings = ({ columns, hidden, onToggle, onReset }: ColumnSettingsProps) => {
+  const content = (
+    <Flex vertical gap="small">
+      {columns.map((column) => (
+        <Checkbox
+          key={column.id}
+          checked={!hidden.includes(column.id)}
+          onChange={(event) => {
+            onToggle(column.id, event.target.checked);
+          }}
+        >
+          {column.label}
+        </Checkbox>
+      ))}
+      <Button type="link" onClick={onReset}>
+        По умолчанию
+      </Button>
+    </Flex>
+  );
+
+  return (
+    <Popover trigger="click" placement="bottomRight" title="Колонки" content={content}>
+      <Button icon={<SettingOutlined aria-hidden />}>Настроить колонки</Button>
+    </Popover>
+  );
+};
