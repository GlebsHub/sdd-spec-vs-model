+import { getRouteApi } from "@tanstack/react-router";
+import { useMemo } from "react";
+import { hasActiveFilters, nextSort, parseClientsSearch, resolveSort, toListParams } from "@/entities/client";
+import type { ClientSortField, ClientStatus } from "@/entities/client";
+
+const routeApi = getRouteApi("/clients");
+
+/**
+ * Фильтры и сортировка раздела. Единственный источник истины — параметры адресной строки:
+ * чтение через `useSearch`, запись через `navigate`. Состояние нигде не дублируется.
+ */
+export const useClientsSearch = () => {
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+
+  const params = useMemo(() => toListParams(search), [search]);
+  const sort = useMemo(() => resolveSort(search.sort), [search.sort]);
+
+  return {
+    search,
+    params,
+    sort,
+    hasFilters: hasActiveFilters(search),
+    /** Текстовый поиск пишется с `replace`, чтобы набор текста не засорял историю. */
+    setQuery: (q: string | undefined) => {
+      void navigate({ search: (prev) => ({ ...prev, q }), replace: true });
+    },
+    setStatuses: (status: ClientStatus[]) => {
+      void navigate({ search: (prev) => ({ ...prev, status: parseClientsSearch({ status }).status }) });
+    },
+    setPeriod: (from: string | undefined, to: string | undefined) => {
+      void navigate({ search: (prev) => ({ ...prev, from, to }) });
+    },
+    toggleSort: (field: ClientSortField) => {
+      void navigate({ search: (prev) => ({ ...prev, sort: nextSort(resolveSort(prev.sort), field) }) });
+    },
+    /** Сбрасывает поиск, статус и период. Сортировка сохраняется. */
+    resetFilters: () => {
+      void navigate({ search: (prev) => ({ sort: prev.sort }) });
+    },
+  };
+};
