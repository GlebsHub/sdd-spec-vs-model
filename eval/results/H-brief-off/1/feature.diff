@@ -0,0 +1,194 @@
+import { screen, waitFor, within } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { MOCK_SCENARIO, getRequestLog, setMockScenario } from "@/mocks";
+import { renderApp } from "@/test";
+
+const lastParams = () => getRequestLog().at(-1)?.params ?? {};
+
+const findTable = () => screen.findByRole("table", { name: "Мои клиенты" });
+
+describe("таблица клиентов", () => {
+  it("показывает колонки и данные первой страницы с сортировкой по дате", async () => {
+    await renderApp({ url: "/clients" });
+    const table = await findTable();
+
+    for (const header of ["ФИО", "Телефон", "Статус", "Дата регистрации", "Комиссия агента"]) {
+      expect(within(table).getByRole("columnheader", { name: header })).toBeInTheDocument();
+    }
+    expect(await screen.findByText("Клиентов: 10000")).toBeInTheDocument();
+    expect(lastParams()).toMatchObject({ limit: "50", sort: "registeredAt:desc" });
+
+    const [, newest] = within(table).getAllByRole("row");
+    expect(newest).toHaveTextContent("Пополнил");
+    expect(newest).toHaveTextContent(/12\s345,67\s₽/);
+  });
+
+  it("поиск по ФИО отправляет q после паузы и пишет его в URL", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await findTable();
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "Иванов");
+
+    await waitFor(() => {
+      expect(lastParams().q).toBe("Иванов");
+    });
+    expect(router.state.location.search).toMatchObject({ q: "Иванов" });
+  });
+
+  it("поиск короче двух символов не отправляется на сервер", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await findTable();
+    const requestsBefore = getRequestLog().length;
+
+    await user.type(screen.getByRole("textbox", { name: "Поиск по ФИО" }), "И");
+
+    await waitFor(() => {
+      expect(router.state.location.search).toMatchObject({ q: "И" });
+    });
+    expect(getRequestLog()).toHaveLength(requestsBefore);
+    expect(lastParams()).not.toHaveProperty("q");
+  });
+
+  it("фильтр по статусу отправляет status и пишет его в URL", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await findTable();
+
+    await user.click(screen.getByRole("combobox", { name: "Статус" }));
+    await user.click(await screen.findByRole("option", { name: "Лид" }));
+
+    await waitFor(() => {
+      expect(lastParams().status).toBe("LEAD");
+    });
+    expect(router.state.location.search).toMatchObject({ status: "LEAD" });
+  });
+
+  it("сортировка по комиссии отправляет sort и переключает направление повторным кликом", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await findTable();
+
+    await user.click(screen.getByRole("button", { name: "Комиссия агента" }));
+    await waitFor(() => {
+      expect(lastParams().sort).toBe("commissionKopecks:asc");
+    });
+
+    await user.click(screen.getByRole("button", { name: "Комиссия агента" }));
+    await waitFor(() => {
+      expect(lastParams().sort).toBe("commissionKopecks:desc");
+    });
+    expect(router.state.location.search).toMatchObject({ sort: "commissionKopecks:desc" });
+  });
+
+  it("фильтр по дате регистрации отправляет dateFrom и dateTo", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await findTable();
+
+    await user.type(screen.getByPlaceholderText("Регистрация с"), "01.09.2026");
+    await user.type(screen.getByPlaceholderText("по"), "30.09.2026{Enter}");
+
+    await waitFor(() => {
+      expect(lastParams()).toMatchObject({ dateFrom: "2026-09-01", dateTo: "2026-09-30" });
+    });
+  });
+
+  it("ссылка с параметрами открывает то же состояние", async () => {
+    await renderApp({ url: "/clients?status=LEAD,FUNDED&sort=commissionKopecks:asc&dateFrom=2026-09-01" });
+    await findTable();
+
+    expect(lastParams()).toMatchObject({
+      status: "LEAD,FUNDED",
+      sort: "commissionKopecks:asc",
+      dateFrom: "2026-09-01",
+    });
+    expect(screen.getByRole("button", { name: "Сбросить" })).toBeEnabled();
+  });
+
+  it("некорректные параметры адреса заменяются значениями по умолчанию", async () => {
+    const { router } = await renderApp({ url: "/clients?status=BOGUS&sort=zzz&dateFrom=2026-02-30" });
+    await findTable();
+
+    expect(lastParams()).toMatchObject({ sort: "registeredAt:desc" });
+    expect(lastParams()).not.toHaveProperty("status");
+    expect(lastParams()).not.toHaveProperty("dateFrom");
+    expect(router.state.location.search).toEqual({});
+  });
+
+  it("«Сбросить» очищает параметры поиска и фильтров", async () => {
+    const { user, router } = await renderApp({ url: "/clients?q=Иванов&status=LEAD" });
+    await findTable();
+
+    await user.click(screen.getByRole("button", { name: "Сбросить" }));
+
+    await waitFor(() => {
+      expect(router.state.location.search).toEqual({});
+    });
+    expect(screen.getByRole("textbox", { name: "Поиск по ФИО" })).toHaveValue("");
+  });
+
+  it("пока загружается первая страница, показывается индикатор загрузки", async () => {
+    setMockScenario({ delayMs: 200 });
+    await renderApp({ url: "/clients" });
+
+    expect(document.querySelector("[aria-busy='true']")).not.toBeNull();
+    await findTable();
+  });
+
+  it("пустой ответ без фильтров показывает «Клиентов пока нет»", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp({ url: "/clients" });
+
+    expect(await screen.findByText("Клиентов пока нет")).toBeInTheDocument();
+  });
+
+  it("пустой ответ с фильтрами показывает «Ничего не найдено»", async () => {
+    await renderApp({ url: "/clients?q=ъъ" });
+
+    expect(await screen.findByText("Ничего не найдено")).toBeInTheDocument();
+  });
+
+  it("ошибка первой страницы показывает повтор, который загружает данные", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorFirstPage, failTimes: null });
+    const { user } = await renderApp({ url: "/clients" });
+
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+
+    setMockScenario({ scenario: MOCK_SCENARIO.default });
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+
+    expect(await findTable()).toBeInTheDocument();
+  });
+
+  it("скрытая колонка исчезает и остаётся скрытой после перемонтирования", async () => {
+    const first = await renderApp({ url: "/clients" });
+    await findTable();
+
+    await first.user.click(screen.getByRole("button", { name: "Колонки" }));
+    await first.user.click(await screen.findByRole("checkbox", { name: "Статус" }));
+
+    expect(screen.queryByRole("columnheader", { name: "Статус" })).not.toBeInTheDocument();
+    first.unmount();
+
+    await renderApp({ url: "/clients" });
+    await findTable();
+    expect(screen.queryByRole("columnheader", { name: "Статус" })).not.toBeInTheDocument();
+    expect(screen.getByRole("columnheader", { name: "Телефон" })).toBeInTheDocument();
+  });
+
+  it("переход на карточку и «назад» возвращают фильтры и загруженные строки из кэша", async () => {
+    const { user, router } = await renderApp({ url: "/clients?q=Иванов&sort=fullName:asc" });
+    const table = await findTable();
+
+    const [firstClientLink] = within(table).getAllByRole("link");
+    if (!firstClientLink) {
+      throw new Error("В таблице нет ссылок на карточки клиентов");
+    }
+    await user.click(firstClientLink);
+    expect(await screen.findByRole("heading", { name: "Карточка клиента" })).toBeInTheDocument();
+    const requestsBeforeBack = getRequestLog().length;
+
+    await user.click(screen.getByRole("button", { name: "Назад" }));
