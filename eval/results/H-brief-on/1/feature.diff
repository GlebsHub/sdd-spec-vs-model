@@ -0,0 +1,46 @@
+import { useState } from "react";
+import type { ClientColumnId } from "@/entities/client";
+import { useCurrentAgent } from "@/shared/lib/session";
+import { CLIENT_COLUMN_IDS } from "@/entities/client";
+import { readColumnSettings, writeColumnSettings } from "./columnSettings";
+import type { ColumnSettings } from "./columnSettings";
+
+export const useColumnSettings = () => {
+  const { id: agentId } = useCurrentAgent();
+  const [settings, setSettings] = useState<ColumnSettings>(() => readColumnSettings(agentId));
+
+  const commit = (next: ColumnSettings) => {
+    setSettings(next);
+    writeColumnSettings(agentId, next);
+  };
+
+  const setColumnVisible = (id: ClientColumnId, visible: boolean) => {
+    const others = settings.hidden.filter((hiddenId) => hiddenId !== id);
+    const hidden = visible ? others : [...others, id];
+    if (hidden.length >= CLIENT_COLUMN_IDS.length) {
+      return;
+    }
+    commit({ ...settings, hidden });
+  };
+
+  const moveColumn = (id: ClientColumnId, delta: -1 | 1) => {
+    const from = settings.order.indexOf(id);
+    const to = from + delta;
+    if (from < 0 || to < 0 || to >= settings.order.length) {
+      return;
+    }
+    const order = settings.order.filter((columnId) => columnId !== id);
+    order.splice(to, 0, id);
+    commit({ ...settings, order });
+  };
+
+  return {
+    columnOrder: settings.order,
+    hiddenColumns: settings.hidden,
+    columnVisibility: Object.fromEntries(settings.hidden.map((id) => [id, false] as const)),
+    setColumnVisible,
+    moveColumn,
+  };
+};
+
+export type ColumnSettingsState = ReturnType<typeof useColumnSettings>;
