+import { act, renderHook } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import { setCurrentAgentId } from "@/shared/lib/session";
+import { useColumnVisibility } from "./useColumnVisibility";
+
+const COLUMN_IDS = ["phoneMasked", "status", "registeredAt", "commissionKopecks", "productsCount"];
+const DEFAULT_HIDDEN = ["productsCount"];
+
+const renderVisibility = () => renderHook(() => useColumnVisibility({ columnIds: COLUMN_IDS, defaultHidden: DEFAULT_HIDDEN }));
+
+describe("видимость колонок клиентов", () => {
+  it("без сохранённых настроек использует значения по умолчанию", () => {
+    const { result } = renderVisibility();
+    expect(result.current.hidden).toEqual(DEFAULT_HIDDEN);
+  });
+
+  it("сохраняет выбор и восстанавливает его при новом монтировании", () => {
+    setCurrentAgentId("agent-1");
+    const first = renderVisibility();
+    act(() => {
+      first.result.current.setVisible("productsCount", true);
+    });
+    act(() => {
+      first.result.current.setVisible("status", false);
+    });
+    first.unmount();
+
+    const second = renderVisibility();
+    expect(second.result.current.hidden).toEqual(["status"]);
+  });
+
+  it("настройки разных агентов не пересекаются", () => {
+    setCurrentAgentId("agent-1");
+    const first = renderVisibility();
+    act(() => {
+      first.result.current.setVisible("status", false);
+    });
+    first.unmount();
+
+    setCurrentAgentId("agent-2");
+    expect(renderVisibility().result.current.hidden).toEqual(DEFAULT_HIDDEN);
+    setCurrentAgentId("agent-1");
+  });
+
+  it("невалидные или содержащие неизвестную колонку данные заменяются значением по умолчанию", () => {
+    window.localStorage.setItem("clients-columns:v1:agent-1", "{не json");
+    expect(renderVisibility().result.current.hidden).toEqual(DEFAULT_HIDDEN);
+
+    window.localStorage.setItem("clients-columns:v1:agent-1", JSON.stringify({ hidden: ["fullName"] }));
+    expect(renderVisibility().result.current.hidden).toEqual(DEFAULT_HIDDEN);
+  });
+
+  it("колонку ФИО (нет в списке скрываемых) скрыть нельзя", () => {
+    const { result } = renderVisibility();
+    act(() => {
+      result.current.setVisible("fullName", false);
+    });
+    expect(result.current.hidden).toEqual(DEFAULT_HIDDEN);
+  });
+
+  it("«По умолчанию» возвращает исходный набор и удаляет сохранённые настройки", () => {
+    const { result } = renderVisibility();
+    act(() => {
+      result.current.setVisible("status", false);
+    });
+    act(() => {
+      result.current.reset();
+    });
+    expect(result.current.hidden).toEqual(DEFAULT_HIDDEN);
+    expect(window.localStorage.getItem("clients-columns:v1:agent-1")).toBeNull();
+  });
+
+  it("недоступное хранилище не ломает хук: настройка действует до перезагрузки", () => {
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new Error("quota");
+    });
+    const { result } = renderVisibility();
+    act(() => {
+      result.current.setVisible("status", false);
+    });
+    expect(result.current.hidden).toEqual(["productsCount", "status"]);
+  });
+});
