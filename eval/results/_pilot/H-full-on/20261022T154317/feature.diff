@@ -0,0 +1,145 @@
+import { expect, test } from "@playwright/test";
+import type { Locator, Page } from "@playwright/test";
+
+const LIST_PATH = "/api/agent/clients";
+
+const scrollerOf = (page: Page): Locator => page.locator('[data-scroll-restoration-id="clients-list"]');
+const rowsOf = (page: Page): Locator => scrollerOf(page).locator('tbody tr[tabindex="0"]');
+
+const waitForRows = async (page: Page): Promise<void> => {
+  await expect(rowsOf(page).first()).toBeVisible();
+};
+
+const scrollToBottom = async (page: Page): Promise<void> => {
+  await scrollerOf(page).evaluate((element) => {
+    element.scrollTop = element.scrollHeight;
+  });
+};
+
+test("AC-08: прокрутка к концу догружает следующую порцию", async ({ page }) => {
+  await page.goto("/clients");
+  await waitForRows(page);
+
+  const nextPage = page.waitForResponse((response) => response.url().includes("cursor="));
+  await scrollToBottom(page);
+  expect((await nextPage).status()).toBe(200);
+});
+
+test("AC-15: в DOM остаются только видимые строки и небольшой запас", async ({ page }) => {
+  await page.goto("/clients");
+  await waitForRows(page);
+
+  for (let index = 0; index < 4; index += 1) {
+    const nextPage = page.waitForResponse((response) => response.url().includes("cursor="));
+    await scrollToBottom(page);
+    await nextPage;
+  }
+  await expect.poll(() => rowsOf(page).count()).toBeLessThanOrEqual(60);
+  expect(await rowsOf(page).count()).toBeGreaterThan(0);
+});
+
+test("AC-06: смена фильтра прокручивает таблицу к началу", async ({ page }) => {
+  await page.goto("/clients");
+  await waitForRows(page);
+  const nextPage = page.waitForResponse((response) => response.url().includes("cursor="));
+  await scrollToBottom(page);
+  await nextPage;
+
+  await page.getByRole("combobox", { name: "Статус" }).click();
+  await page.getByRole("option", { name: "Пополнил счёт" }).click();
+  await expect.poll(() => scrollerOf(page).evaluate((element) => element.scrollTop)).toBe(0);
+  await expect(page).toHaveURL(/status=FUNDED/);
+});
+
+test("AC-04: посимвольный ввод ФИО отправляет один запрос с q", async ({ page }) => {
+  const queries: string[] = [];
+  page.on("request", (request) => {
+    const url = new URL(request.url());
+    if (url.pathname === LIST_PATH && url.searchParams.has("q")) {
+      queries.push(url.searchParams.get("q") ?? "");
+    }
+  });
+
+  await page.goto("/clients");
+  await waitForRows(page);
+  await page.getByRole("textbox", { name: "Поиск по ФИО" }).pressSequentially("Иванов", { delay: 50 });
+  await expect.poll(() => queries).toEqual(["Иванов"]);
+  await page.waitForTimeout(500);
+  expect(queries).toEqual(["Иванов"]);
+});
+
+test("AC-10: ссылка с параметрами открывает то же состояние", async ({ page }) => {
+  await page.goto("/clients?status=FUNDED&sort=commissionKopecks:asc");
+  await waitForRows(page);
+  await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+  await expect(page.locator(".ant-select-selection-item", { hasText: "Пополнил счёт" })).toBeVisible();
+});
+
+test("AC-12: после перезагрузки восстанавливаются фильтры и сортировка", async ({ page }) => {
+  await page.goto("/clients?status=FUNDED&sort=commissionKopecks:asc");
+  await waitForRows(page);
+  await page.reload();
+  await waitForRows(page);
+  await expect(page).toHaveURL(/status=FUNDED/);
+  await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+});
+
+test("AC-11: карточка и «назад» восстанавливают строки, прокрутку и не делают запросов", async ({ page }) => {
+  await page.goto("/clients?sort=fullName:asc");
+  await waitForRows(page);
+  const nextPage = page.waitForResponse((response) => response.url().includes("cursor="));
+  await scrollToBottom(page);
+  await nextPage;
+  await scrollerOf(page).evaluate((element) => {
+    element.scrollTop = 1200;
+  });
+
+  const visibleIndex = await scrollerOf(page).evaluate((scroller) => {
+    const box = scroller.getBoundingClientRect();
+    const rows = [...scroller.querySelectorAll('tbody tr[tabindex="0"]')];
+    return rows.findIndex((row) => {
+      const rect = row.getBoundingClientRect();
+      return rect.top >= box.top && rect.bottom <= box.bottom;
+    });
+  });
+  const target = rowsOf(page).nth(visibleIndex);
+  await expect(target).toBeInViewport();
+  const name = await target.locator("td").first().innerText();
+  const url = page.url();
+
+  const requestsBefore: string[] = [];
+  page.on("request", (request) => {
+    if (request.url().includes(LIST_PATH)) {
+      requestsBefore.push(request.url());
+    }
+  });
+
+  await target.click();
+  await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+  await page.goBack();
+
+  await expect(page).toHaveURL(url);
+  await expect(scrollerOf(page).locator("tr", { hasText: name })).toBeInViewport();
+  expect(requestsBefore).toHaveLength(0);
+});
+
+test("AC-14: строка открывается с клавиатуры по Enter", async ({ page }) => {
+  await page.goto("/clients");
+  await waitForRows(page);
+  await rowsOf(page).first().focus();
+  await page.keyboard.press("Enter");
+  await expect(page).toHaveURL(/\/clients\/[0-9a-f-]+$/);
+});
+
+test("AC-13: скрытая колонка сохраняется после перезагрузки", async ({ page }) => {
+  await page.goto("/clients");
+  await waitForRows(page);
+  await page.getByRole("button", { name: "Настроить колонки" }).click();
+  await page.getByRole("checkbox", { name: "Статус" }).uncheck();
+  await page.keyboard.press("Escape");
+  await expect(page.getByRole("columnheader", { name: "Статус" })).toHaveCount(0);
+
+  await page.reload();
+  await waitForRows(page);
+  await expect(page.getByRole("columnheader", { name: "Статус" })).toHaveCount(0);
+});
