+import { ArrowDownOutlined, ArrowUpOutlined } from "@ant-design/icons";
+import { useElementScrollRestoration, useNavigate } from "@tanstack/react-router";
+import { flexRender, getCoreRowModel, useReactTable } from "@tanstack/react-table";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import { Button, Empty, Flex, Result, Skeleton, Typography, theme } from "antd";
+import { useEffect, useRef } from "react";
+import { getClientSort, nextSort, toClientListParams, toSortSearch, useClients } from "@/entities/clients";
+import { ClientFilters, useClientsSearchState } from "@/features/client-filters";
+import { ColumnSettingsButton, useColumnVisibility } from "@/features/client-columns";
+import { SORT_DIRECTION, isHttpError } from "@/shared/api";
+import type { Client } from "@/shared/api";
+import { CLIENTS_SCROLL_ID } from "./constants";
+import { CLIENT_COLUMNS, RIGHT_ALIGNED_COLUMNS, SORT_FIELD_BY_COLUMN } from "./columns";
+import styles from "./ClientsTable.module.css";
+
+const ROW_HEIGHT = 48;
+const OVERSCAN = 10;
+const PREFETCH_THRESHOLD = 10;
+const SKELETON_ROWS = 10;
+
+export const ClientsTable = () => {
+  const { token } = theme.useToken();
+  const navigate = useNavigate();
+  const { search, updateSearch, resetFilters, hasFilters } = useClientsSearchState();
+  const sort = getClientSort(search);
+  const list = useClients(toClientListParams(search));
+  const { visibility, setColumnVisible, resetColumnVisibility } = useColumnVisibility();
+
+  const table = useReactTable({
+    data: list.clients,
+    columns: CLIENT_COLUMNS,
+    getCoreRowModel: getCoreRowModel(),
+    getRowId: (row) => row.id,
+    manualSorting: true,
+    manualFiltering: true,
+    state: { columnVisibility: visibility },
+  });
+  const rows = table.getRowModel().rows;
+
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const restoredScroll = useElementScrollRestoration({ id: CLIENTS_SCROLL_ID });
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: OVERSCAN,
+    initialOffset: restoredScroll?.scrollY,
+    getItemKey: (index) => rows[index]?.id ?? index,
+  });
+
+  const visibleEnd = virtualizer.range?.endIndex ?? -1;
+  const { hasNextPage, isFetchingNextPage, isFetchNextPageError, fetchNextPage } = list;
+  useEffect(() => {
+    if (!hasNextPage || isFetchingNextPage || isFetchNextPageError) {
+      return;
+    }
+    if (rows.length - 1 - visibleEnd <= PREFETCH_THRESHOLD) {
+      fetchNextPage();
+    }
+  }, [hasNextPage, isFetchingNextPage, isFetchNextPageError, fetchNextPage, rows.length, visibleEnd]);
+
+  const openCard = (clientId: Client["id"]) => {
+    void navigate({ to: "/clients/$clientId", params: { clientId } });
+  };
+
+  const renderTable = () => {
+    const virtualRows = virtualizer.getVirtualItems();
+    const lastRow = virtualRows.at(-1);
+    const paddingTop = virtualRows[0]?.start ?? 0;
+    const paddingBottom = lastRow ? virtualizer.getTotalSize() - lastRow.end : 0;
+    const columnCount = table.getVisibleLeafColumns().length;
+
+    return (
+      <>
+        <table className={styles.table} aria-label="Список клиентов">
+          <thead>
+            {table.getHeaderGroups().map((group) => (
+              <tr key={group.id}>
+                {group.headers.map((header) => {
+                  const sortField = SORT_FIELD_BY_COLUMN.get(header.column.id);
+                  const isSorted = sortField !== undefined && sortField === sort.field;
+                  const ariaSort = isSorted
+                    ? sort.direction === SORT_DIRECTION.asc
+                      ? "ascending"
+                      : "descending"
+                    : undefined;
+                  const label = flexRender(header.column.columnDef.header, header.getContext());
+                  return (
+                    <th
+                      key={header.id}
+                      scope="col"
+                      aria-sort={ariaSort}
+                      className={`${styles.headerCell} ${RIGHT_ALIGNED_COLUMNS.has(header.column.id) ? styles.rightAligned : ""}`}
+                      style={{ background: token.colorBgContainer }}
+                    >
+                      {sortField === undefined ? (
+                        label
+                      ) : (
+                        <button
+                          type="button"
+                          className={styles.sortButton}
+                          onClick={() => {
+                            updateSearch({ sort: toSortSearch(nextSort(sort, sortField)) });
+                          }}
+                        >
+                          {label}
+                          {isSorted &&
+                            (sort.direction === SORT_DIRECTION.asc ? (
+                              <ArrowUpOutlined aria-hidden />
+                            ) : (
+                              <ArrowDownOutlined aria-hidden />
+                            ))}
+                        </button>
+                      )}
+                    </th>
+                  );
+                })}
+              </tr>
+            ))}
+          </thead>
+          <tbody>
+            {paddingTop > 0 && (
+              <tr aria-hidden>
+                <td colSpan={columnCount} style={{ height: paddingTop, padding: 0 }} />
+              </tr>
+            )}
+            {virtualRows.map((virtualRow) => {
+              const row = rows[virtualRow.index];
+              if (!row) {
+                return null;
+              }
+              return (
+                <tr
+                  key={row.id}
+                  tabIndex={0}
+                  className={styles.row}
+                  style={{ height: ROW_HEIGHT }}
+                  onClick={() => {
+                    openCard(row.original.id);
+                  }}
+                  onKeyDown={(event) => {
+                    if (event.key === "Enter") {
+                      openCard(row.original.id);
+                    }
+                  }}
+                >
+                  {row.getVisibleCells().map((cell) => (
+                    <td
+                      key={cell.id}
+                      className={`${styles.cell} ${RIGHT_ALIGNED_COLUMNS.has(cell.column.id) ? styles.rightAligned : ""}`}
+                    >
+                      {flexRender(cell.column.columnDef.cell, cell.getContext())}
+                    </td>
+                  ))}
+                </tr>
+              );
+            })}
+            {paddingBottom > 0 && (
+              <tr aria-hidden>
+                <td colSpan={columnCount} style={{ height: paddingBottom, padding: 0 }} />
+              </tr>
+            )}
+          </tbody>
+        </table>
+        {list.isFetchingNextPage && <div role="status">Загружаем ещё…</div>}
+        {list.isFetchNextPageError && (
+          <Flex align="center" gap="middle">
+            <Typography.Text type="danger">Не удалось загрузить клиентов</Typography.Text>
+            <Button onClick={list.fetchNextPage}>Повторить</Button>
+          </Flex>
+        )}
+      </>
+    );
+  };
+
+  const renderContent = () => {
+    if (list.isPending) {
+      return <Skeleton active title={false} paragraph={{ rows: SKELETON_ROWS }} />;
+    }
+    if (list.isError && list.total === undefined) {
+      return isHttpError(list.error, 403) ? (
+        <Result status="403" title="Раздел недоступен. Обратитесь к персональному менеджеру" />
+      ) : (
+        <Result
+          status="error"
+          title="Не удалось загрузить клиентов"
+          extra={<Button onClick={list.refetch}>Повторить</Button>}
+        />
+      );
+    }
+    if (list.total === 0) {
+      return hasFilters ? (
+        <Empty description="Ничего не найдено">
+          <Button onClick={resetFilters}>Сбросить фильтры</Button>
+        </Empty>
+      ) : (
+        <Empty description="У вас пока нет клиентов. Поделитесь реферальной ссылкой, чтобы пригласить первого" />
+      );
+    }
+    return renderTable();
+  };
+
+  return (
+    <Flex vertical gap="middle" className={styles.root}>
+      <Flex align="baseline" gap="small">
+        <Typography.Title level={2} style={{ margin: 0 }}>
+          Мои клиенты
+        </Typography.Title>
+        {list.total !== undefined && <Typography.Text type="secondary">{list.total.toLocaleString("ru-RU")}</Typography.Text>}
+      </Flex>
+      <ClientFilters />
+      <Flex justify="flex-end">
+        <ColumnSettingsButton
+          visibility={visibility}
+          onVisibleChange={setColumnVisible}
+          onReset={resetColumnVisibility}
+        />
+      </Flex>
+      <div ref={scrollRef} className={styles.scroller} data-scroll-restoration-id={CLIENTS_SCROLL_ID}>
+        {renderContent()}
+      </div>
+    </Flex>
+  );
+};
