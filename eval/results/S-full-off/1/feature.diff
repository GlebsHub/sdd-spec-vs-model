@@ -0,0 +1,143 @@
+import { expect, test } from "@playwright/test";
+import type { Locator, Page } from "@playwright/test";
+
+const SCROLLER = '[data-scroll-restoration-id="clients-table"]';
+const API_PATH = "/api/agent/clients";
+const ROW_HEIGHT = 48;
+
+const dataRows = (page: Page): Locator => page.locator("tbody [role=row]");
+
+/** Запросы списка клиентов с начала записи. */
+const trackListRequests = (page: Page): URL[] => {
+  const requests: URL[] = [];
+  page.on("request", (request) => {
+    const url = new URL(request.url());
+    if (url.pathname === API_PATH) {
+      requests.push(url);
+    }
+  });
+  return requests;
+};
+
+const cursorRequests = (requests: URL[]): number => requests.filter((url) => url.searchParams.has("cursor")).length;
+
+const scrollToBottom = (page: Page): Promise<void> =>
+  page.locator(SCROLLER).evaluate((element) => {
+    element.scrollTop = element.scrollHeight;
+  });
+
+/** Прокручивает к концу, пока не будет загружено нужное число дополнительных порций. */
+const loadPages = async (page: Page, requests: URL[], count: number): Promise<void> => {
+  await expect
+    .poll(
+      async () => {
+        await scrollToBottom(page);
+        return cursorRequests(requests);
+      },
+      { timeout: 20_000 },
+    )
+    .toBeGreaterThanOrEqual(count);
+};
+
+test.describe("Мои клиенты", () => {
+  test("прокрутка догружает порции; в DOM остаётся не больше 60 строк таблицы", async ({ page }) => {
+    const requests = trackListRequests(page);
+    await page.goto("/clients");
+    await expect(dataRows(page).first()).toBeVisible();
+    expect(await dataRows(page).count()).toBeLessThanOrEqual(60);
+
+    await loadPages(page, requests, 4);
+
+    // Загружено не меньше 250 строк, отрисованы только видимые и запас.
+    await expect.poll(() => dataRows(page).count()).toBeLessThanOrEqual(60);
+    await expect.poll(() => dataRows(page).count()).toBeGreaterThan(0);
+  });
+
+  test("ссылка с параметрами открывает то же состояние", async ({ page }) => {
+    const requests = trackListRequests(page);
+    await page.goto("/clients?status=FUNDED&sort=commissionKopecks:asc");
+
+    await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+    await expect(dataRows(page).first()).toContainText("Пополнил счёт");
+    expect(requests[0]?.searchParams.get("status")).toBe("FUNDED");
+    expect(requests[0]?.searchParams.get("sort")).toBe("commissionKopecks:asc");
+    await expect(page.getByRole("button", { name: "Сбросить фильтры" })).toBeVisible();
+  });
+
+  test("фильтры и сортировка попадают в адрес и переживают перезагрузку", async ({ page }) => {
+    await page.goto("/clients");
+    await expect(dataRows(page).first()).toBeVisible();
+
+    await page.getByRole("textbox", { name: "Поиск по ФИО" }).fill("Иванов");
+    await expect.poll(() => new URL(page.url()).searchParams.get("q")).toBe("Иванов");
+    await page.getByRole("columnheader", { name: "Комиссия" }).click();
+    await expect.poll(() => new URL(page.url()).searchParams.get("sort")).toBe("commissionKopecks:desc");
+
+    await page.reload();
+
+    await expect(page.getByRole("textbox", { name: "Поиск по ФИО" })).toHaveValue("Иванов");
+    await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "descending");
+    await expect(dataRows(page).first()).toBeVisible();
+  });
+
+  test("смена сортировки прокручивает таблицу к началу", async ({ page }) => {
+    const requests = trackListRequests(page);
+    await page.goto("/clients");
+    await expect(dataRows(page).first()).toBeVisible();
+    await loadPages(page, requests, 1);
+    await expect.poll(() => page.locator(SCROLLER).evaluate((element) => element.scrollTop)).toBeGreaterThan(0);
+
+    await page.getByRole("columnheader", { name: "ФИО" }).click();
+
+    await expect.poll(() => page.locator(SCROLLER).evaluate((element) => element.scrollTop)).toBe(0);
+  });
+
+  test("после перехода в карточку и «Назад» фильтры, строки и позиция прокрутки на месте, без повторного запроса", async ({
+    page,
+  }) => {
+    const requests = trackListRequests(page);
+    await page.goto("/clients?sort=commissionKopecks:asc");
+    await expect(dataRows(page).first()).toBeVisible();
+    await loadPages(page, requests, 2);
+
+    await page.locator(SCROLLER).evaluate((element, offset) => {
+      element.scrollTop = offset;
+    }, ROW_HEIGHT * 60);
+    // Отрисовка начинается с запаса в 10 строк выше видимой области, поэтому берём строку из видимой части.
+    const row = dataRows(page).nth(12);
+    await expect(row).toBeVisible();
+    const rowIndex = await row.getAttribute("aria-rowindex");
+    await row.click();
+    await expect(page.getByRole("heading", { name: "Карточка клиента" })).toBeVisible();
+    const requestsBefore = requests.length;
+
+    await page.getByRole("button", { name: "Назад" }).click();
+
+    await expect(page).toHaveURL(/sort=commissionKopecks:asc/);
+    await expect(page.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+    await expect(page.locator(`tbody [role=row][aria-rowindex="${rowIndex ?? ""}"]`)).toBeInViewport();
+    await page.waitForTimeout(500);
+    expect(requests.length).toBe(requestsBefore);
+  });
+
+  test("настройки колонок сохраняются после перезагрузки", async ({ page }) => {
+    await page.goto("/clients");
+    await expect(dataRows(page).first()).toBeVisible();
+
+    await page.getByRole("button", { name: "Настроить колонки" }).click();
+    await page.getByRole("checkbox", { name: "Телефон" }).click();
+    await expect(page.getByRole("columnheader", { name: "Телефон" })).toHaveCount(0);
+
+    await page.reload();
+
+    await expect(dataRows(page).first()).toBeVisible();
+    await expect(page.getByRole("columnheader", { name: "Телефон" })).toHaveCount(0);
+  });
+
+  test("комиссия выровнена по правому краю", async ({ page }) => {
+    await page.goto("/clients");
+    const cell = dataRows(page).first().getByRole("cell").nth(4);
+    await expect(cell).toBeVisible();
+    expect(await cell.evaluate((element) => getComputedStyle(element).textAlign)).toBe("end");
+  });
+});
