@@ -0,0 +1,137 @@
+import { fireEvent, screen, waitFor, within } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { MOCK_SCENARIO, getRequestLog, setMockScenario } from "@/mocks";
+import { formatMoney } from "@/shared/lib/money";
+import { renderApp } from "@/test";
+
+const SCROLLER_SELECTOR = '[data-scroll-restoration-id="clients-table"]';
+
+const requestsWith = (key: string) => getRequestLog().filter((request) => request.params[key] !== undefined);
+
+beforeEach(() => {
+  // В jsdom нет раскладки: без размеров виртуализатор не отрисует ни одной строки.
+  vi.spyOn(HTMLElement.prototype, "offsetHeight", "get").mockReturnValue(800);
+  vi.spyOn(HTMLElement.prototype, "offsetWidth", "get").mockReturnValue(1200);
+});
+
+describe("раздел «Мои клиенты»", () => {
+  it("AC-01: первая порция 50 записей по дате регистрации по убыванию и счётчик", async () => {
+    await renderApp({ url: "/clients" });
+    const table = await screen.findByRole("table", { name: "Список клиентов" });
+    expect(within(table).getAllByRole("row").length).toBeGreaterThan(1);
+    expect(getRequestLog()[0]?.params).toMatchObject({ limit: "50", sort: "registeredAt:desc" });
+    expect(await screen.findByText(/^10\s000$/)).toBeInTheDocument();
+  });
+
+  it("AC-02: колонка «Продуктов» скрыта по умолчанию, «ФИО» первая", async () => {
+    await renderApp({ url: "/clients" });
+    await screen.findByRole("table", { name: "Список клиентов" });
+    const headers = screen.getAllByRole("columnheader").map((header) => header.textContent);
+    expect(headers[0]).toBe("ФИО");
+    expect(headers.some((text) => text?.includes("Продуктов"))).toBe(false);
+  });
+
+  it("AC-03: комиссия 0 и 5 копеек в денежном формате", async () => {
+    await renderApp({ url: "/clients" });
+    expect(await screen.findByText(formatMoney(0))).toBeInTheDocument();
+    expect(await screen.findByText(formatMoney(5))).toBeInTheDocument();
+  });
+
+  it("AC-04: посимвольный ввод «Иванов» отправляет один запрос с q=Иванов", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await screen.findByRole("table", { name: "Список клиентов" });
+    await user.type(screen.getByLabelText("Поиск по ФИО"), "Иванов");
+    await waitFor(() => expect(requestsWith("q")).toHaveLength(1));
+    expect(requestsWith("q")[0]?.params.q).toBe("Иванов");
+  });
+
+  it("AC-05: фильтр статуса из адреса передаётся в запрос, кнопка сброса видна", async () => {
+    const { user } = await renderApp({ url: "/clients?status=LEAD" });
+    await screen.findByRole("table", { name: "Список клиентов" });
+    expect(getRequestLog()[0]?.params.status).toBe("LEAD");
+    await user.click(screen.getByRole("button", { name: "Сбросить фильтры" }));
+    await waitFor(() => expect(screen.queryByRole("button", { name: "Сбросить фильтры" })).not.toBeInTheDocument());
+  });
+
+  it("AC-07: сортировка переключается desc → asc и отражается в aria-sort", async () => {
+    const { user } = await renderApp({ url: "/clients" });
+    await screen.findByRole("table", { name: "Список клиентов" });
+    await user.click(screen.getByRole("button", { name: "Комиссия" }));
+    await waitFor(() => expect(requestsWith("sort").at(-1)?.params.sort).toBe("commissionKopecks:desc"));
+    await user.click(screen.getByRole("button", { name: "Комиссия" }));
+    await waitFor(() => expect(requestsWith("sort").at(-1)?.params.sort).toBe("commissionKopecks:asc"));
+    expect(screen.getByRole("columnheader", { name: /Комиссия/ })).toHaveAttribute("aria-sort", "ascending");
+  });
+
+  it("AC-09: пустой список без фильтров", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp({ url: "/clients" });
+    expect(
+      await screen.findByText("У вас пока нет клиентов. Поделитесь реферальной ссылкой, чтобы пригласить первого"),
+    ).toBeInTheDocument();
+  });
+
+  it("AC-09: пустой список с фильтрами и сброс", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    const { user } = await renderApp({ url: "/clients?q=Иванов" });
+    expect(await screen.findByText("Ничего не найдено")).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Сбросить фильтры" }));
+    await waitFor(() => expect(screen.queryByText("Ничего не найдено")).not.toBeInTheDocument());
+  });
+
+  it("AC-09: ошибка первой порции и повтор", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorFirstPage });
+    const { user } = await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+    setMockScenario({ scenario: MOCK_SCENARIO.default });
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    expect(await screen.findByRole("table", { name: "Список клиентов" })).toBeInTheDocument();
+  });
+
+  it("AC-09: 403 показывает состояние «Нет доступа»", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.forbidden });
+    await renderApp({ url: "/clients" });
+    expect(
+      await screen.findByText("Раздел недоступен. Обратитесь к персональному менеджеру"),
+    ).toBeInTheDocument();
+  });
+
+  it("AC-08 и AC-09: догрузка по прокрутке; ошибка догрузки оставляет строки", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorNextPage });
+    await renderApp({ url: "/clients" });
+    const table = await screen.findByRole("table", { name: "Список клиентов" });
+    const rowsBefore = within(table).getAllByRole("row").length;
+    const scroller = document.querySelector<HTMLElement>(SCROLLER_SELECTOR);
+    expect(scroller).not.toBeNull();
+    if (scroller) {
+      scroller.scrollTop = 48 * 45;
+      fireEvent.scroll(scroller);
+    }
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+    expect(within(table).getAllByRole("row").length).toBe(rowsBefore);
+    expect(requestsWith("cursor").length).toBeGreaterThan(0);
+  });
+
+  it("AC-14: Enter на строке открывает карточку клиента", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    const table = await screen.findByRole("table", { name: "Список клиентов" });
+    const firstRow = within(table).getAllByRole("row")[1];
+    firstRow?.focus();
+    await user.keyboard("{Enter}");
+    await waitFor(() => expect(router.state.location.pathname).toMatch(/^\/clients\/.+/));
+  });
+
+  it("AC-13: скрытая колонка остаётся скрытой после перемонтирования, «ФИО» скрыть нельзя", async () => {
+    const { user, unmount } = await renderApp({ url: "/clients" });
+    await screen.findByRole("table", { name: "Список клиентов" });
+    await user.click(screen.getByRole("button", { name: "Настроить колонки" }));
+    expect(await screen.findByRole("checkbox", { name: "ФИО" })).toBeDisabled();
+    await user.click(screen.getByRole("checkbox", { name: "Телефон" }));
+    await waitFor(() => expect(screen.queryByRole("columnheader", { name: "Телефон" })).not.toBeInTheDocument());
+    unmount();
+
+    await renderApp({ url: "/clients" });
+    await screen.findByRole("table", { name: "Список клиентов" });
+    expect(screen.queryByRole("columnheader", { name: "Телефон" })).not.toBeInTheDocument();
+  });
+});
