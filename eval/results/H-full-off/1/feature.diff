+import { infiniteQueryOptions } from "@tanstack/react-query";
+import { clientKeys } from "@/shared/api";
+import { fetchClientsPage } from "./api";
+import type { ClientListParams } from "./params";
+
+/** Данные считаются свежими 60 секунд: при возврате на список в этот срок запрос не уходит (п. 9.2). */
+export const CLIENTS_STALE_TIME = 60 * 1000;
+
+const FIRST_PAGE_CURSOR: string | undefined = undefined;
+
+export const clientQueries = {
+  list: (params: ClientListParams) =>
+    infiniteQueryOptions({
+      queryKey: clientKeys.list(params),
+      queryFn: ({ pageParam, signal }) => fetchClientsPage(params, pageParam, signal),
+      initialPageParam: FIRST_PAGE_CURSOR,
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+      staleTime: CLIENTS_STALE_TIME,
+    }),
+};
