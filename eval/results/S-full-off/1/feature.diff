+import { Button, DatePicker, Flex, Input, Select, Typography } from "antd";
+import dayjs from "dayjs";
+import type { Dayjs } from "dayjs";
+import { CLIENT_STATUS_LABEL, CLIENT_STATUS_ORDER } from "@/entities/client";
+import type { ClientStatus } from "@/entities/client";
+import styles from "./ClientsFilters.module.css";
+import { useClientsSearch } from "./useClientsSearch";
+import { useSearchInput } from "./useSearchInput";
+
+const API_DATE_FORMAT = "YYYY-MM-DD";
+const DISPLAY_DATE_FORMAT = "DD.MM.YYYY";
+const NO_STATUSES: ClientStatus[] = [];
+
+const STATUS_OPTIONS = CLIENT_STATUS_ORDER.map((status) => ({ value: status, label: CLIENT_STATUS_LABEL[status] }));
+
+const ID = {
+  search: "clients-filter-search",
+  status: "clients-filter-status",
+  periodFrom: "clients-filter-period-from",
+  periodTo: "clients-filter-period-to",
+} as const;
+
+/** `YYYY-MM-DD` разбирается как локальная календарная дата: часовой пояс не пересчитывается. */
+const toPickerValue = (date: string | undefined): Dayjs | null => (date === undefined ? null : dayjs(date));
+
+export type ClientsFiltersProps = {
+  /** Кнопку сброса можно скрыть, если то же действие уже показано в состоянии «Ничего не найдено». */
+  showReset?: boolean;
+};
+
+export const ClientsFilters = ({ showReset = true }: ClientsFiltersProps) => {
+  const { search, hasFilters, setQuery, setStatuses, setPeriod, resetFilters } = useClientsSearch();
+  const { text, change, clear } = useSearchInput(search.q, setQuery);
+
+  const handleReset = () => {
+    clear();
+    resetFilters();
+  };
+
+  return (
+    <Flex gap="middle" align="flex-end" wrap>
+      <div className={styles.field}>
+        <Typography.Text>
+          <label htmlFor={ID.search}>Поиск по ФИО</label>
+        </Typography.Text>
+        <Input
+          id={ID.search}
+          className={styles.search}
+          value={text}
+          onChange={(event) => {
+            change(event.target.value);
+          }}
+        />
+      </div>
+      <div className={styles.field}>
+        <Typography.Text>
+          <label htmlFor={ID.status}>Статус</label>
+        </Typography.Text>
+        <Select
+          id={ID.status}
+          className={styles.status}
+          mode="multiple"
+          options={STATUS_OPTIONS}
+          value={search.status ?? NO_STATUSES}
+          placeholder="Все статусы"
+          maxTagCount="responsive"
+          onChange={(values: ClientStatus[]) => {
+            setStatuses(values);
+          }}
+        />
+      </div>
+      <div className={styles.field}>
+        <Typography.Text>
+          <label htmlFor={ID.periodFrom}>Период регистрации</label>
+        </Typography.Text>
+        <DatePicker.RangePicker
+          id={{ start: ID.periodFrom, end: ID.periodTo }}
+          className={styles.period}
+          format={DISPLAY_DATE_FORMAT}
+          placeholder={["Дата с", "Дата по"]}
+          allowEmpty={[true, true]}
+          value={[toPickerValue(search.from), toPickerValue(search.to)]}
+          onChange={(dates) => {
+            setPeriod(dates?.[0]?.format(API_DATE_FORMAT), dates?.[1]?.format(API_DATE_FORMAT));
+          }}
+        />
+      </div>
+      {hasFilters && showReset ? <Button onClick={handleReset}>Сбросить фильтры</Button> : null}
+    </Flex>
+  );
+};
