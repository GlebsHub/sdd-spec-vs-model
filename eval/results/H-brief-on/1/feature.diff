+import { describe, expect, it } from "vitest";
+import { clientsSearchDefaults, toClientListParams, validateClientsSearch } from "./clientsSearch";
+
+describe("validateClientsSearch", () => {
+  it("пустой адрес даёт значения по умолчанию", () => {
+    expect(validateClientsSearch({})).toMatchObject({
+      status: clientsSearchDefaults.status,
+      sort: clientsSearchDefaults.sort,
+    });
+  });
+
+  it("сохраняет корректные значения как есть", () => {
+    expect(
+      validateClientsSearch({ q: "Иванов", status: "LEAD,FUNDED", dateFrom: "2025-01-01", dateTo: "2025-12-31", sort: "fullName:asc" }),
+    ).toEqual({ q: "Иванов", status: "LEAD,FUNDED", dateFrom: "2025-01-01", dateTo: "2025-12-31", sort: "fullName:asc" });
+  });
+
+  it("отбрасывает неизвестные и повторные статусы", () => {
+    expect(validateClientsSearch({ status: "LEAD,UNKNOWN,LEAD,FUNDED" }).status).toBe("LEAD,FUNDED");
+  });
+
+  it("заменяет некорректную сортировку значением по умолчанию", () => {
+    expect(validateClientsSearch({ sort: "phoneMasked:asc" }).sort).toBe(clientsSearchDefaults.sort);
+    expect(validateClientsSearch({ sort: "fullName:sideways" }).sort).toBe(clientsSearchDefaults.sort);
+  });
+
+  it("заменяет несуществующую дату и дату в неверном формате пустым значением", () => {
+    expect(validateClientsSearch({ dateFrom: "2026-02-30", dateTo: "01.02.2026" })).toMatchObject({
+      dateFrom: undefined,
+      dateTo: undefined,
+    });
+  });
+});
+
+describe("toClientListParams", () => {
+  it("короткий поиск не попадает в запрос", () => {
+    expect(toClientListParams(validateClientsSearch({ q: "  а " })).q).toBeUndefined();
+  });
+
+  it("поиск обрезается по краям и передаётся от двух символов", () => {
+    expect(toClientListParams(validateClientsSearch({ q: "  ив " })).q).toBe("ив");
+  });
+
+  it("пустой статус не передаётся, непустой — массивом", () => {
+    expect(toClientListParams(validateClientsSearch({})).status).toBeUndefined();
+    expect(toClientListParams(validateClientsSearch({ status: "FUNDED,LEAD" })).status).toEqual(["FUNDED", "LEAD"]);
+  });
+
+  it("сортировка по умолчанию — дата регистрации по убыванию", () => {
+    expect(toClientListParams(validateClientsSearch({})).sort).toEqual({ field: "registeredAt", direction: "desc" });
+  });
+
+  it("даты передаются только заполненными", () => {
+    const params = toClientListParams(validateClientsSearch({ dateTo: "2025-06-30" }));
+    expect(params.dateFrom).toBeUndefined();
+    expect(params.dateTo).toBe("2025-06-30");
+  });
+});
