+import { ArrowDownOutlined, ArrowUpOutlined, SettingOutlined } from "@ant-design/icons";
+import { Button, Checkbox, Flex, Popover } from "antd";
+import { CLIENT_COLUMN_TITLE } from "@/entities/client";
+import type { ColumnSettingsState } from "./useColumnSettings";
+
+export type ColumnSettingsButtonProps = {
+  settings: ColumnSettingsState;
+};
+
+export const ColumnSettingsButton = ({ settings }: ColumnSettingsButtonProps) => {
+  const { columnOrder, hiddenColumns, setColumnVisible, moveColumn } = settings;
+  const visibleCount = columnOrder.length - hiddenColumns.length;
+
+  const content = (
+    <Flex vertical gap="small">
+      {columnOrder.map((id, index) => {
+        const title = CLIENT_COLUMN_TITLE[id];
+        const isVisible = !hiddenColumns.includes(id);
+        return (
+          <Flex key={id} align="center" justify="space-between" gap="middle">
+            <Checkbox
+              checked={isVisible}
+              disabled={isVisible && visibleCount === 1}
+              onChange={(event) => {
+                setColumnVisible(id, event.target.checked);
+              }}
+            >
+              {title}
+            </Checkbox>
+            <Flex gap="small">
+              <Button
+                size="small"
+                icon={<ArrowUpOutlined aria-hidden />}
+                aria-label={`Переместить вверх: ${title}`}
+                disabled={index === 0}
+                onClick={() => {
+                  moveColumn(id, -1);
+                }}
+              />
+              <Button
+                size="small"
+                icon={<ArrowDownOutlined aria-hidden />}
+                aria-label={`Переместить вниз: ${title}`}
+                disabled={index === columnOrder.length - 1}
+                onClick={() => {
+                  moveColumn(id, 1);
+                }}
+              />
+            </Flex>
+          </Flex>
+        );
+      })}
+    </Flex>
+  );
+
+  return (
+    <Popover trigger="click" placement="bottomRight" title="Колонки таблицы" content={content}>
+      <Button icon={<SettingOutlined aria-hidden />}>Колонки</Button>
+    </Popover>
+  );
+};
