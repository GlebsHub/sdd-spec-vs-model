+import { describe, expect, it } from "vitest";
+import { hasActiveFilters, parseClientsSearch, toClientsFilters } from "./search";
+
+describe("parseClientsSearch", () => {
+  it("пустой адрес не дает параметров", () => {
+    expect(parseClientsSearch({})).toEqual({});
+  });
+
+  it("убирает пробелы по краям поиска и не пишет пустой поиск", () => {
+    expect(parseClientsSearch({ q: "  Иванов " })).toEqual({ q: "Иванов" });
+    expect(parseClientsSearch({ q: "   " })).toEqual({});
+  });
+
+  it("оставляет только известные статусы, без повторов, в каноническом порядке", () => {
+    expect(parseClientsSearch({ status: "FUNDED,LEAD,BOGUS,LEAD" })).toEqual({ status: "FUNDED,LEAD" });
+    expect(parseClientsSearch({ status: "BOGUS" })).toEqual({});
+  });
+
+  it("отбрасывает даты, которых нет в календаре, и даты неверного формата", () => {
+    expect(parseClientsSearch({ from: "2026-02-30" })).toEqual({});
+    expect(parseClientsSearch({ to: "01.02.2026" })).toEqual({});
+    expect(parseClientsSearch({ from: "2026-01-01", to: "2026-03-31" })).toEqual({ from: "2026-01-01", to: "2026-03-31" });
+  });
+
+  it("не пишет сортировку по умолчанию и отбрасывает неизвестную", () => {
+    expect(parseClientsSearch({ sort: "registeredAt:desc" })).toEqual({});
+    expect(parseClientsSearch({ sort: "bogus:asc" })).toEqual({});
+    expect(parseClientsSearch({ sort: "commissionKopecks:asc" })).toEqual({ sort: "commissionKopecks:asc" });
+  });
+
+  it("игнорирует значения не строкового типа", () => {
+    expect(parseClientsSearch({ q: 5, status: ["LEAD"], from: null, sort: {} })).toEqual({});
+  });
+});
+
+describe("toClientsFilters", () => {
+  it("поиск короче двух символов в фильтры не попадает", () => {
+    expect(toClientsFilters({ q: "И" }).q).toBeUndefined();
+    expect(toClientsFilters({ q: "Ив" }).q).toBe("Ив");
+  });
+
+  it("переводит адрес в параметры запроса с сортировкой по умолчанию", () => {
+    expect(toClientsFilters({})).toEqual({
+      q: undefined,
+      status: undefined,
+      dateFrom: undefined,
+      dateTo: undefined,
+      sort: { field: "registeredAt", direction: "desc" },
+    });
+  });
+
+  it("переводит статусы, даты и сортировку", () => {
+    expect(
+      toClientsFilters({ status: "LEAD,FUNDED", from: "2026-01-01", to: "2026-03-31", sort: "fullName:asc" }),
+    ).toEqual({
+      q: undefined,
+      status: ["LEAD", "FUNDED"],
+      dateFrom: "2026-01-01",
+      dateTo: "2026-03-31",
+      sort: { field: "fullName", direction: "asc" },
+    });
+  });
+
+  it("определяет, заданы ли фильтры; сортировка фильтром не считается", () => {
+    expect(hasActiveFilters(toClientsFilters({ sort: "fullName:asc" }))).toBe(false);
+    expect(hasActiveFilters(toClientsFilters({ q: "Иванов" }))).toBe(true);
+    expect(hasActiveFilters(toClientsFilters({ from: "2026-01-01" }))).toBe(true);
+  });
+});
diff --git a/src/entities/client/search.ts b/src/entities/client/search.ts
