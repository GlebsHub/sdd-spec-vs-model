+import { Link } from "@tanstack/react-router";
+import type { ColumnDef } from "@tanstack/react-table";
+import type { Client } from "@/shared/api";
+import { formatMoscowDate } from "@/shared/lib/date";
+import { formatMoney } from "@/shared/lib/money";
+import { ClientStatusBadge } from "./ClientStatusBadge";
+
+export const HIDEABLE_COLUMN_IDS = ["phoneMasked", "status", "registeredAt", "commissionKopecks"] as const;
+export type HideableColumnId = (typeof HIDEABLE_COLUMN_IDS)[number];
+
+/** `id` колонок совпадает с полями сортировки и ключами `localStorage`, менять нельзя. */
+export const CLIENT_COLUMNS: ColumnDef<Client>[] = [
+  {
+    id: "fullName",
+    accessorKey: "fullName",
+    header: "ФИО",
+    size: 260,
+    enableHiding: false,
+    enableSorting: true,
+    cell: ({ row }) => (
+      <Link to="/clients/$clientId" params={{ clientId: row.original.id }}>
+        {row.original.fullName}
+      </Link>
+    ),
+  },
+  {
+    id: "phoneMasked",
+    accessorKey: "phoneMasked",
+    header: "Телефон",
+    size: 160,
+    enableSorting: false,
+  },
+  {
+    id: "status",
+    accessorKey: "status",
+    header: "Статус",
+    size: 170,
+    enableSorting: false,
+    cell: ({ row }) => <ClientStatusBadge status={row.original.status} />,
+  },
+  {
+    id: "registeredAt",
+    accessorKey: "registeredAt",
+    header: "Дата регистрации",
+    size: 170,
+    enableSorting: true,
+    cell: ({ row }) => formatMoscowDate(row.original.registeredAt),
+  },
+  {
+    id: "commissionKopecks",
+    accessorKey: "commissionKopecks",
+    header: "Комиссия агента",
+    size: 180,
+    enableSorting: true,
+    cell: ({ row }) => formatMoney(row.original.commissionKopecks),
+  },
+];
