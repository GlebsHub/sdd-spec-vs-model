+  });
+
+  it("повторный клик переключает desc → asc → desc", () => {
+    const desc = nextSort(DEFAULT, "registeredAt");
+    expect(desc).toEqual({ field: "registeredAt", direction: "asc" });
+    expect(nextSort(desc, "registeredAt")).toEqual({ field: "registeredAt", direction: "desc" });
