+import { SORT_DIRECTION } from "@/entities/client";
+import type { ClientSort, ClientSortField } from "@/entities/client";
+
+/** Клик по колонке: новая колонка — по убыванию, затем переключение desc ⇄ asc. */
+export const nextSort = (current: ClientSort, field: ClientSortField): ClientSort => {
+  if (current.field !== field) {
+    return { field, direction: SORT_DIRECTION.desc };
+  }
+  return {
+    field,
+    direction: current.direction === SORT_DIRECTION.desc ? SORT_DIRECTION.asc : SORT_DIRECTION.desc,
+  };
+};
