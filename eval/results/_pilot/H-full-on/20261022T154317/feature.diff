index 0000000..3b8091f
--- /dev/null
+++ b/src/widgets/clients-table/ClientsTable.test.tsx
@@ -0,0 +1,191 @@
+import { fireEvent, screen, waitFor, within } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { MOCK_SCENARIO, getClientsDb, getRequestLog, setMockScenario } from "@/mocks";
+import { formatMoney } from "@/shared/lib/money";
+import { renderApp } from "@/test";
+
+const SCROLL_SELECTOR = '[data-scroll-restoration-id="clients-list"]';
+
+const newestFirst = () => [...getClientsDb()].sort((a, b) => b.registeredAt.localeCompare(a.registeredAt));
+
+const dataRows = () => screen.getAllByRole("row").slice(1);
+const headerTexts = () => screen.getAllByRole("columnheader").map((header) => header.textContent);
+const lastRequest = () => getRequestLog().at(-1);
+const requestsWithCursor = () => getRequestLog().filter((request) => request.params["cursor"] !== undefined);
+
+const waitForRows = () => waitFor(() => expect(dataRows().length).toBeGreaterThan(0));
+
+const setScrollTop = (element: HTMLElement, value: number) => {
+  Object.defineProperty(element, "scrollTop", { configurable: true, value });
+  fireEvent.scroll(element);
+};
+
+const scrollerElement = (): HTMLElement => {
+  const element = document.querySelector<HTMLElement>(SCROLL_SELECTOR);
+  if (!element) {
+    throw new Error("scroll container not found");
+  }
+  return element;
+};
+
+beforeEach(() => {
+  // В jsdom нет раскладки: без высоты области виртуализатор не рисует строки.
+  vi.spyOn(Element.prototype, "clientHeight", "get").mockReturnValue(600);
+});
+
+describe("таблица клиентов", () => {
+  it("AC-01: сначала скелетон, затем первая порция по дате регистрации по убыванию и общий счётчик", async () => {
+    await renderApp({ url: "/clients" });
+    expect(document.querySelector(".ant-skeleton")).not.toBeNull();
+
+    await waitForRows();
+    expect(document.querySelector(".ant-skeleton")).toBeNull();
+    expect(screen.getByText(/^10\s000$/)).toBeInTheDocument();
+    expect(within(dataRows()[0] as HTMLElement).getByText(newestFirst()[0]?.fullName ?? "")).toBeInTheDocument();
+    expect(lastRequest()?.params).toEqual({ limit: "50", sort: "registeredAt:desc" });
+  });
+
+  it("AC-02: колонки в порядке спецификации, «Продуктов» скрыта по умолчанию", async () => {
+    await renderApp({ url: "/clients" });
+    await waitForRows();
+    expect(headerTexts()).toEqual(["ФИО", "Телефон", "Статус", "Дата регистрации", "Комиссия"]);
+  });
+
+  it("AC-03: комиссия в денежном формате, включая 0 и 5 копеек; статус текстом", async () => {
+    await renderApp({ url: "/clients" });
+    await waitForRows();
+    const [first, second, third] = dataRows().map((row) => row.textContent ?? "");
+    expect(first).toContain(formatMoney(1_234_567));
+    expect(second).toContain(formatMoney(5));
+    expect(third).toContain(formatMoney(0));
+    expect(third).toContain("Зарегистрирован");
+  });
+
+  it("AC-07: сортировка переключается desc → asc → desc, направление видно в aria-sort", async () => {
+    await renderApp({ url: "/clients" });
+    await waitForRows();
+    const commission = screen.getByRole("columnheader", { name: "Комиссия" });
+    expect(commission).toHaveAttribute("aria-sort", "none");
+    expect(screen.getByRole("columnheader", { name: "Дата регистрации" })).toHaveAttribute("aria-sort", "descending");
+
+    const sortButton = within(commission).getByRole("button", { name: "Комиссия" });
+    fireEvent.click(sortButton);
+    await waitFor(() => expect(lastRequest()?.params["sort"]).toBe("commissionKopecks:desc"));
+    expect(commission).toHaveAttribute("aria-sort", "descending");
+    expect(lastRequest()?.params["cursor"]).toBeUndefined();
+
+    fireEvent.click(sortButton);
+    await waitFor(() => expect(lastRequest()?.params["sort"]).toBe("commissionKopecks:asc"));
+    expect(commission).toHaveAttribute("aria-sort", "ascending");
+  });
+
+  it("AC-08: прокрутка к концу догружает следующую порцию", async () => {
+    await renderApp({ url: "/clients" });
+    await waitForRows();
+    setScrollTop(scrollerElement(), 2000);
+    await waitFor(() => expect(requestsWithCursor()).toHaveLength(1));
+    expect(lastRequest()?.params["cursor"]).toEqual(expect.any(String));
+  });
+
+  it("AC-09: ошибка первой порции показывает «Повторить», которое загружает данные", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorFirstPage, failTimes: 1 });
+    const { user } = await renderApp({ url: "/clients" });
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    await waitForRows();
+  });
+
+  it("AC-09: ошибка догрузки сохраняет строки, «Повторить» повторяет только догрузку", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.errorNextPage, failTimes: 1 });
+    const { user } = await renderApp({ url: "/clients" });
+    await waitForRows();
+    setScrollTop(scrollerElement(), 2000);
+    expect(await screen.findByText("Не удалось загрузить клиентов")).toBeInTheDocument();
+    const loadedBefore = dataRows().length;
+    expect(loadedBefore).toBeGreaterThan(0);
+
+    await user.click(screen.getByRole("button", { name: "Повторить" }));
+    await waitFor(() => expect(requestsWithCursor()).toHaveLength(2));
+    expect(getRequestLog().filter((request) => request.params["cursor"] === undefined)).toHaveLength(1);
+  });
+
+  it("AC-09: пустой список без фильтров", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    await renderApp({ url: "/clients" });
+    expect(
+      await screen.findByText("У вас пока нет клиентов. Поделитесь реферальной ссылкой, чтобы пригласить первого"),
+    ).toBeInTheDocument();
+  });
+
+  it("AC-09: пустой список с фильтрами предлагает сбросить их и сохраняет сортировку", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.empty });
+    const { user, router } = await renderApp({ url: "/clients?q=Иванов&sort=fullName:asc" });
+    expect(await screen.findByText("Ничего не найдено")).toBeInTheDocument();
+    const [resetButton] = screen.getAllByRole("button", { name: "Сбросить фильтры" });
+    if (!resetButton) {
+      throw new Error("reset button not found");
+    }
+    await user.click(resetButton);
+    await waitFor(() => expect(router.state.location.search).toEqual({ sort: "fullName:asc" }));
+  });
+
+  it("AC-09: 403 показывает «Нет доступа»", async () => {
+    setMockScenario({ scenario: MOCK_SCENARIO.forbidden });
+    await renderApp({ url: "/clients" });
+    expect(
+      await screen.findByText("Раздел недоступен. Обратитесь к персональному менеджеру"),
+    ).toBeInTheDocument();
+  });
+
+  it("AC-10: ссылка с параметрами открывает то же состояние, некорректные значения игнорируются", async () => {
+    await renderApp({ url: "/clients?status=FUNDED&sort=commissionKopecks:asc&from=2026-01-01&to=2026-03-31" });
+    await waitForRows();
+    expect(lastRequest()?.params).toEqual({
+      limit: "50",
+      status: "FUNDED",
+      sort: "commissionKopecks:asc",
+      dateFrom: "2026-01-01",
+      dateTo: "2026-03-31",
+    });
+    expect(screen.getByRole("columnheader", { name: "Комиссия" })).toHaveAttribute("aria-sort", "ascending");
+  });
+
+  it("AC-10: некорректные параметры адреса заменяются значениями по умолчанию", async () => {
+    await renderApp({ url: "/clients?status=BAD&sort=phoneMasked:asc&from=2026-02-30" });
+    await waitForRows();
+    expect(lastRequest()?.params).toEqual({ limit: "50", sort: "registeredAt:desc" });
+  });
+
+  it("AC-14: строки фокусируются с клавиатуры, Enter открывает карточку клиента", async () => {
+    const { user, router } = await renderApp({ url: "/clients" });
+    await waitForRows();
+    const row = dataRows()[0] as HTMLElement;
+    expect(row).toHaveAttribute("tabindex", "0");
+    row.focus();
+    await user.keyboard("{Enter}");
+    expect(router.state.location.pathname).toBe(`/clients/${newestFirst()[0]?.id ?? ""}`);
+  });
+
+  it("AC-13: скрытые колонки сохраняются между сессиями, ФИО скрыть нельзя, «По умолчанию» сбрасывает", async () => {
+    const first = await renderApp({ url: "/clients" });
+    await waitForRows();
+    await first.user.click(screen.getByRole("button", { name: "Настроить колонки" }));
+    expect(screen.queryByRole("checkbox", { name: "ФИО" })).toBeNull();
+    await first.user.click(screen.getByRole("checkbox", { name: "Статус" }));
+    expect(headerTexts()).not.toContain("Статус");
+    first.unmount();
+
+    const second = await renderApp({ url: "/clients" });
+    await waitForRows();
+    expect(headerTexts()).not.toContain("Статус");
+    await second.user.click(screen.getByRole("button", { name: "Настроить колонки" }));
+    await second.user.click(await screen.findByRole("button", { name: "По умолчанию" }));
+    expect(headerTexts()).toContain("Статус");
+  });
+
+  it("AC-15: в DOM не больше 60 строк таблицы", async () => {
+    await renderApp({ url: "/clients" });
+    await waitForRows();
+    expect(dataRows().length).toBeLessThanOrEqual(60);
+  });
+});
diff --git a/src/widgets/clients-table/ClientsTable.tsx b/src/widgets/clients-table/ClientsTable.tsx
new file mode 100644
index 0000000..b05cd68
--- /dev/null
+++ b/src/widgets/clients-table/ClientsTable.tsx
@@ -0,0 +1,287 @@
+import { ArrowDownOutlined, ArrowUpOutlined } from "@ant-design/icons";
+import { getRouteApi, useElementScrollRestoration, useNavigate } from "@tanstack/react-router";
+import { flexRender, getCoreRowModel, useReactTable } from "@tanstack/react-table";
+import type { Row } from "@tanstack/react-table";
+import { useVirtualizer } from "@tanstack/react-virtual";
+import { Button, Empty, Flex, Skeleton, Typography, theme } from "antd";
+import type { ReactNode } from "react";
+import { useEffect, useRef } from "react";
+import { ColumnSettings, useColumnVisibility } from "@/features/client-columns";
+import { ClientFilters } from "@/features/client-filters";
+import { SORT_DIRECTION, hasActiveFilters, sortFromSearch, sortToSearch, toListFilters, useClients } from "@/entities/client";
+import type { Client, ClientSortField, SortState } from "@/entities/client";
+import { isHttpError } from "@/shared/api";
+import {
+  CLIENT_COLUMN_IDS,
+  CLIENT_TABLE_COLUMNS,
+  DEFAULT_HIDDEN_COLUMN_IDS,
+  HIDEABLE_COLUMNS,
+  findClientColumn,
+} from "./columns";
+import { CLIENTS_LIST_SCROLL_ID, PREFETCH_THRESHOLD, ROW_HEIGHT, VIRTUAL_OVERSCAN } from "./constants";
+import styles from "./ClientsTable.module.css";
+
+const routeApi = getRouteApi("/clients");
+
+type StatePanelProps = { message: string; action?: ReactNode };
+
+const StatePanel = ({ message, action }: StatePanelProps) => (
+  <Flex vertical align="center" justify="center" gap="middle" className={styles.state}>
+    <Typography.Text>{message}</Typography.Text>
+    {action}
+  </Flex>
+);
+
+const nextSortDirection = (current: SortState, field: ClientSortField) =>
+  current.field === field && current.direction === SORT_DIRECTION.desc ? SORT_DIRECTION.asc : SORT_DIRECTION.desc;
+
+type AriaSort = "ascending" | "descending" | "none";
+
+const ariaSortFor = (current: SortState, field: ClientSortField | undefined): AriaSort | undefined => {
+  if (field === undefined) {
+    return undefined;
+  }
+  if (current.field !== field) {
+    return "none";
+  }
+  return current.direction === SORT_DIRECTION.asc ? "ascending" : "descending";
+};
+
+export const ClientsTable = () => {
+  const { token } = theme.useToken();
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+  const openClient = useNavigate();
+  const sort = sortFromSearch(search);
+
+  const {
+    clients,
+    isPending,
+    isFirstPageError,
+    error,
+    isFetchNextPageError,
+    hasNextPage,
+    isFetchingNextPage,
+    loadNextPage,
+    retry,
+  } = useClients(toListFilters(search));
+
+  const { hidden, setVisible, reset: resetColumns } = useColumnVisibility({
+    columnIds: HIDEABLE_COLUMNS.map((column) => column.id),
+    defaultHidden: DEFAULT_HIDDEN_COLUMN_IDS,
+  });
+  const columnVisibility = Object.fromEntries(CLIENT_COLUMN_IDS.map((id) => [id, !hidden.includes(id)]));
+
+  const table = useReactTable({
+    data: clients,
+    columns: CLIENT_TABLE_COLUMNS,
+    state: { columnVisibility },
+    getCoreRowModel: getCoreRowModel(),
+    getRowId: (client) => client.id,
+    manualSorting: true,
+    manualFiltering: true,
+    manualPagination: true,
+  });
+  const rows = table.getRowModel().rows;
+  const visibleColumns = table.getVisibleLeafColumns();
+
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const restoredScroll = useElementScrollRestoration({ id: CLIENTS_LIST_SCROLL_ID });
+  const virtualizer = useVirtualizer({
+    count: rows.length,
+    getScrollElement: () => scrollRef.current,
+    estimateSize: () => ROW_HEIGHT,
+    overscan: VIRTUAL_OVERSCAN,
+    initialOffset: restoredScroll?.scrollY ?? 0,
+    getItemKey: (index) => rows[index]?.id ?? index,
+  });
+  const virtualItems = virtualizer.getVirtualItems();
+  const lastVisibleIndex = virtualizer.range?.endIndex ?? 0;
+
+  useEffect(() => {
+    if (!hasNextPage || isFetchingNextPage || isFetchNextPageError) {
+      return;
+    }
+    if (lastVisibleIndex >= clients.length - PREFETCH_THRESHOLD) {
+      void loadNextPage();
+    }
+  }, [lastVisibleIndex, clients.length, hasNextPage, isFetchingNextPage, isFetchNextPageError, loadNextPage]);
+
+  const resetFilters = () => {
+    void navigate({ search: (prev) => ({ sort: prev.sort }) });
+  };
+
+  const changeSort = (field: ClientSortField) => {
+    const direction = nextSortDirection(sort, field);
+    void navigate({ search: (prev) => ({ ...prev, sort: sortToSearch({ field, direction }) }) });
+  };
+
+  const openCard = (clientId: string) => {
+    void openClient({ to: "/clients/$clientId", params: { clientId } });
+  };
+
+  const renderHeader = () => (
+    <thead>
+      <tr>
+        {visibleColumns.map((column) => {
+          const meta = findClientColumn(column.id);
+          const sortField = meta?.sortField;
+          const ariaSort = ariaSortFor(sort, sortField);
+          const isActive = sortField !== undefined && sort.field === sortField;
+          const icon = isActive ? (sort.direction === SORT_DIRECTION.asc ? <ArrowUpOutlined aria-hidden /> : <ArrowDownOutlined aria-hidden />) : null;
+          return (
+            <th
+              key={column.id}
+              scope="col"
+              aria-sort={ariaSort}
+              className={styles.headerCell}
+              style={{ textAlign: meta?.align ?? "left", background: token.colorBgContainer, borderBottom: `1px solid ${token.colorBorderSecondary}` }}
+            >
+              {sortField === undefined ? (
+                meta?.label
+              ) : (
+                <button type="button" className={styles.sortButton} onClick={() => { changeSort(sortField); }}>
+                  {meta?.label}
+                  {icon}
+                </button>
+              )}
+            </th>
+          );
+        })}
+      </tr>
+    </thead>
+  );
+
+  const renderRow = (row: Row<Client>) => (
+    <tr
+      key={row.id}
+      tabIndex={0}
+      className={styles.row}
+      onClick={() => { openCard(row.original.id); }}
+      onKeyDown={(event) => {
+        if (event.key === "Enter") {
+          openCard(row.original.id);
+        }
+      }}
+    >
+      {row.getVisibleCells().map((cell) => (
+        <td
+          key={cell.id}
+          className={styles.cell}
+          style={{ textAlign: findClientColumn(cell.column.id)?.align ?? "left", borderBottom: `1px solid ${token.colorBorderSecondary}` }}
+        >
+          {flexRender(cell.column.columnDef.cell, cell.getContext())}
+        </td>
+      ))}
+    </tr>
+  );
+
+  const renderTableBody = () => {
+    const firstItem = virtualItems[0];
+    const lastItem = virtualItems.at(-1);
+    const paddingTop = firstItem?.start ?? 0;
+    const paddingBottom = lastItem ? virtualizer.getTotalSize() - lastItem.end : 0;
+    return (
+      <table className={styles.table} aria-label="Клиенты">
+        {renderHeader()}
+        <tbody>
+          {paddingTop > 0 && <tr aria-hidden style={{ height: paddingTop }} />}
+          {virtualItems.map((item) => {
+            const row = rows[item.index];
+            return row ? renderRow(row) : null;
+          })}
+          {paddingBottom > 0 && <tr aria-hidden style={{ height: paddingBottom }} />}
+          {isFetchingNextPage && (
+            <tr>
+              <td colSpan={visibleColumns.length} className={styles.footer}>
+                <Typography.Text type="secondary" role="status">
+                  Загружаем ещё…
+                </Typography.Text>
+              </td>
+            </tr>
+          )}
+          {isFetchNextPageError && (
+            <tr>
+              <td colSpan={visibleColumns.length} className={styles.footer}>
+                <Flex justify="center" align="center" gap="middle">
+                  <Typography.Text>Не удалось загрузить клиентов</Typography.Text>
+                  <Button
+                    onClick={() => {
+                      void loadNextPage();
+                    }}
+                  >
+                    Повторить
+                  </Button>
+                </Flex>
+              </td>
+            </tr>
+          )}
+        </tbody>
+      </table>
+    );
+  };
+
+  const renderContent = () => {
+    if (isPending) {
+      return <Skeleton active title={false} paragraph={{ rows: 10 }} />;
+    }
+    if (isFirstPageError) {
+      if (isHttpError(error, 403)) {
+        return <StatePanel message="Раздел недоступен. Обратитесь к персональному менеджеру" />;
+      }
+      return (
+        <StatePanel
+          message="Не удалось загрузить клиентов"
+          action={
+            <Button
+              onClick={() => {
+                void retry();
+              }}
+            >
+              Повторить
+            </Button>
+          }
+        />
+      );
+    }
+    if (clients.length === 0) {
+      if (hasActiveFilters(search)) {
+        return (
+          <StatePanel
+            message="Ничего не найдено"
+            action={<Button onClick={resetFilters}>Сбросить фильтры</Button>}
+          />
+        );
+      }
+      return (
+        <Empty
+          image={Empty.PRESENTED_IMAGE_SIMPLE}
+          description="У вас пока нет клиентов. Поделитесь реферальной ссылкой, чтобы пригласить первого"
+        />
+      );
+    }
+    return renderTableBody();
+  };
+
+  return (
+    <Flex vertical gap="middle" className={styles.root}>
+      <ClientFilters />
+      <Flex justify="flex-end">
+        <ColumnSettings
+          columns={HIDEABLE_COLUMNS}
+          hidden={hidden}
+          onToggle={setVisible}
+          onReset={resetColumns}
+        />
+      </Flex>
+      <div
+        ref={scrollRef}
+        className={styles.scroll}
+        data-scroll-restoration-id={CLIENTS_LIST_SCROLL_ID}
+        style={{ background: token.colorBgContainer, borderRadius: token.borderRadiusLG }}
+      >
+        {renderContent()}
+      </div>
+    </Flex>
+  );
+};
