+import { ClientListResponseSchema, http } from "@/shared/api";
+import type { ClientListResponse, ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+
+export const CLIENTS_PAGE_SIZE = 50;
+
+export type ClientListParams = {
+  q?: string;
+  status?: ClientStatus[];
+  dateFrom?: string;
+  dateTo?: string;
+  sort: { field: ClientSortField; direction: SortDirection };
+};
+
+export const fetchClientsPage = (
+  params: ClientListParams,
+  cursor: string | undefined,
+  signal: AbortSignal,
+): Promise<ClientListResponse> =>
+  http.get("/agent/clients", {
+    schema: ClientListResponseSchema,
+    signal,
+    params: {
+      limit: CLIENTS_PAGE_SIZE,
+      cursor,
+      q: params.q,
+      status: params.status?.join(","),
+      dateFrom: params.dateFrom,
+      dateTo: params.dateTo,
+      sort: `${params.sort.field}:${params.sort.direction}`,
+    },
+  });
