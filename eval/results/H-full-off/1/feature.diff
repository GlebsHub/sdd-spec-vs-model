+import { Button, DatePicker, Flex, Input, Select } from "antd";
+import dayjs from "dayjs";
+import { useEffect, useId, useState } from "react";
+import { CLIENT_STATUS_LABEL, parseStatuses, toStatusParam } from "@/entities/clients";
+import { CLIENT_STATUS } from "@/shared/api";
+import type { ClientStatus } from "@/shared/api";
+import { useClientsSearchState } from "./useClientsSearchState";
+
+const SEARCH_DEBOUNCE_MS = 300;
+const DATE_FORMAT = "YYYY-MM-DD";
+
+const STATUS_OPTIONS = Object.values(CLIENT_STATUS).map((status) => ({
+  value: status,
+  label: CLIENT_STATUS_LABEL[status],
+}));
+
+const toDayjs = (value: string | undefined) => (value === undefined ? null : dayjs(value));
+
+export const ClientFilters = () => {
+  const { search, updateSearch, resetFilters, hasFilters } = useClientsSearchState();
+  const searchId = useId();
+  const statusId = useId();
+  const periodId = useId();
+  const [searchText, setSearchText] = useState(search.q ?? "");
+  const statuses = search.status === undefined ? [] : parseStatuses(search.status);
+
+  useEffect(() => {
+    setSearchText(search.q ?? "");
+  }, [search.q]);
+
+  useEffect(() => {
+    const trimmed = searchText.trim();
+    if (trimmed === (search.q ?? "")) {
+      return;
+    }
+    const timer = window.setTimeout(() => {
+      updateSearch({ q: trimmed === "" ? undefined : trimmed }, { replace: true });
+    }, SEARCH_DEBOUNCE_MS);
+    return () => {
+      window.clearTimeout(timer);
+    };
+  }, [searchText, search.q, updateSearch]);
+
+  return (
+    <Flex wrap gap="large" align="flex-end">
+      <Flex vertical gap="small">
+        <label htmlFor={searchId}>Поиск по ФИО</label>
+        <Input
+          id={searchId}
+          allowClear
+          placeholder="Например, Иванов"
+          style={{ width: 280 }}
+          value={searchText}
+          onChange={(event) => {
+            setSearchText(event.target.value);
+          }}
+        />
+      </Flex>
+      <Flex vertical gap="small">
+        <label htmlFor={statusId}>Статус</label>
+        <Select<ClientStatus[]>
+          id={statusId}
+          mode="multiple"
+          allowClear
+          style={{ minWidth: 220 }}
+          options={STATUS_OPTIONS}
+          value={statuses}
+          onChange={(values) => {
+            updateSearch({ status: toStatusParam(values) });
+          }}
+        />
+      </Flex>
+      <Flex vertical gap="small" role="group" aria-labelledby={periodId}>
+        <span id={periodId}>Период регистрации</span>
+        <DatePicker.RangePicker
+          allowEmpty={[true, true]}
+          format="DD.MM.YYYY"
+          placeholder={["С", "По"]}
+          value={[toDayjs(search.from), toDayjs(search.to)]}
+          onChange={(dates) => {
+            updateSearch({
+              from: dates?.[0]?.format(DATE_FORMAT),
+              to: dates?.[1]?.format(DATE_FORMAT),
+            });
+          }}
+        />
+      </Flex>
+      {hasFilters && <Button onClick={resetFilters}>Сбросить фильтры</Button>}
+    </Flex>
+  );
+};
