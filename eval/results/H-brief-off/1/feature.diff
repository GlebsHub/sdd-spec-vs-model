+import { ClientListResponseSchema, http } from "@/shared/api";
+import type { ClientListResponse } from "@/shared/api";
+import type { ClientListFilters } from "./listParams";
+
+export const CLIENTS_PAGE_SIZE = 50;
+
+type FetchClientsParams = ClientListFilters & {
+  cursor: string | undefined;
+  signal: AbortSignal | undefined;
+};
+
+export const fetchClients = ({
+  q,
+  status,
+  dateFrom,
+  dateTo,
+  sort,
+  cursor,
+  signal,
+}: FetchClientsParams): Promise<ClientListResponse> =>
+  http.get("/agent/clients", {
+    schema: ClientListResponseSchema,
+    signal,
+    params: {
+      limit: CLIENTS_PAGE_SIZE,
+      cursor,
+      q,
+      status: status.length > 0 ? status.join(",") : undefined,
+      dateFrom,
+      dateTo,
+      sort: `${sort.field}:${sort.direction}`,
+    },
+  });
