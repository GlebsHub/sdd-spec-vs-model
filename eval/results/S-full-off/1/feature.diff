+import { useState } from "react";
+import { CLIENT_COLUMN_META } from "@/entities/client";
+import type { ClientColumnId } from "@/entities/client";
+import { clearColumnVisibility, defaultColumnVisibility, readColumnVisibility, writeColumnVisibility } from "./storage";
+import type { ColumnVisibility } from "./storage";
+
+/** Видимость колонок текущего агента: хранится в `localStorage`, в адресную строку не попадает. */
+export const useColumnVisibility = (agentId: string) => {
+  const [state, setState] = useState(() => ({ agentId, visibility: readColumnVisibility(agentId) }));
+
+  let current = state;
+  if (state.agentId !== agentId) {
+    current = { agentId, visibility: readColumnVisibility(agentId) };
+    setState(current);
+  }
+
+  const update = (visibility: ColumnVisibility) => {
+    setState({ agentId, visibility });
+  };
+
+  return {
+    columnVisibility: current.visibility,
+    setColumnVisible: (id: ClientColumnId, visible: boolean) => {
+      if (!CLIENT_COLUMN_META[id].hideable) {
+        return;
+      }
+      const next = { ...current.visibility, [id]: visible };
+      writeColumnVisibility(agentId, next);
+      update(next);
+    },
+    resetColumns: () => {
+      clearColumnVisibility(agentId);
+      update(defaultColumnVisibility());
+    },
+  };
+};
