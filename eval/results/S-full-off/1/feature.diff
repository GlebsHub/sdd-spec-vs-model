+import { ClientListResponseSchema, http } from "@/shared/api";
+import type { ClientListResponse } from "@/shared/api";
+import { PAGE_SIZE } from "./constants";
+import type { ClientListParams } from "./types";
+
+type FetchClientsOptions = {
+  params: ClientListParams;
+  /** Курсор следующей порции; для первой порции не передаётся. */
+  cursor?: string;
+  signal?: AbortSignal;
+};
+
+export const fetchClients = ({ params, cursor, signal }: FetchClientsOptions): Promise<ClientListResponse> =>
+  http.get("/agent/clients", {
+    schema: ClientListResponseSchema,
+    signal,
+    params: {
+      limit: PAGE_SIZE,
+      cursor,
+      q: params.q,
+      status: params.status?.join(","),
+      dateFrom: params.dateFrom,
+      dateTo: params.dateTo,
+      sort: params.sort,
+    },
+  });
