+import { useEffect, useRef } from "react";
+import { LOAD_MORE_THRESHOLD } from "./constants";
+
+type UseLoadMoreOptions = {
+  /** Индекс последней видимой строки; -1, если видимых строк нет. */
+  lastVisibleIndex: number;
+  rowCount: number;
+  hasNextPage: boolean;
+  isFetchingNextPage: boolean;
+  isNextPageError: boolean;
+  /** Показан список прежних фильтров, пока грузятся новые: догружать нечего. */
+  isStale: boolean;
+  onLoadMore: () => void;
+};
+
+/**
+ * Запрашивает следующую порцию, когда до конца загруженных строк остаётся не более 10.
+ * Условие: `hasNextPage && !isFetchingNextPage`. После ошибки догрузка идёт только по кнопке «Повторить».
+ */
+export const useLoadMore = ({
+  lastVisibleIndex,
+  rowCount,
+  hasNextPage,
+  isFetchingNextPage,
+  isNextPageError,
+  isStale,
+  onLoadMore,
+}: UseLoadMoreOptions): void => {
+  // Защита от повторного запроса для того же числа строк до того, как флаг загрузки дойдёт до компонента.
+  const requestedAtRowCount = useRef<number | null>(null);
+
+  useEffect(() => {
+    if (isFetchingNextPage) {
+      requestedAtRowCount.current = null;
+      return;
+    }
+    const canLoad = hasNextPage && !isNextPageError && !isStale && lastVisibleIndex >= 0;
+    const isNearEnd = rowCount - 1 - lastVisibleIndex <= LOAD_MORE_THRESHOLD;
+    if (!canLoad || !isNearEnd || requestedAtRowCount.current === rowCount) {
+      return;
+    }
+    requestedAtRowCount.current = rowCount;
+    onLoadMore();
+  }, [hasNextPage, isFetchingNextPage, isNextPageError, isStale, lastVisibleIndex, onLoadMore, rowCount]);
+};
