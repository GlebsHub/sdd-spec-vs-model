+import { getRouteApi } from "@tanstack/react-router";
+import { Button, DatePicker, Flex, Input, Select } from "antd";
+import dayjs from "dayjs";
+import type { Dayjs } from "dayjs";
+import { useEffect, useMemo, useState } from "react";
+import { CLIENT_STATUS_OPTIONS, hasActiveFilters, statusesFromSearch } from "@/entities/client";
+
+const routeApi = getRouteApi("/clients");
+
+const SEARCH_DEBOUNCE_MS = 300;
+const DATE_FORMAT = "YYYY-MM-DD";
+const DISPLAY_DATE_FORMAT = "DD.MM.YYYY";
+
+export const ClientFilters = () => {
+  const search = routeApi.useSearch();
+  const navigate = routeApi.useNavigate();
+  const [queryText, setQueryText] = useState(search.q ?? "");
+  const [pendingQuery, setPendingQuery] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (pendingQuery === null) {
+      return;
+    }
+    const timer = window.setTimeout(() => {
+      setPendingQuery(null);
+      void navigate({ search: (prev) => ({ ...prev, q: pendingQuery || undefined }), replace: true });
+    }, SEARCH_DEBOUNCE_MS);
+    return () => {
+      window.clearTimeout(timer);
+    };
+  }, [pendingQuery, navigate]);
+
+  useEffect(() => {
+    setQueryText((current) => (current.trim() === (search.q ?? "") ? current : (search.q ?? "")));
+  }, [search.q]);
+
+  const statuses = useMemo(() => statusesFromSearch({ status: search.status }), [search.status]);
+  const dateRange = useMemo<[Dayjs | null, Dayjs | null]>(
+    () => [search.from ? dayjs(search.from, DATE_FORMAT) : null, search.to ? dayjs(search.to, DATE_FORMAT) : null],
+    [search.from, search.to],
+  );
+
+  const handleQueryChange = (value: string) => {
+    setQueryText(value);
+    setPendingQuery(value.trim());
+  };
+
+  const handleStatusChange = (values: string[]) => {
+    void navigate({
+      search: (prev) => ({ ...prev, status: values.length > 0 ? values.join(",") : undefined }),
+    });
+  };
+
+  const handleDateChange = (values: [Dayjs | null, Dayjs | null] | null) => {
+    const [from, to] = values ?? [null, null];
+    void navigate({
+      search: (prev) => ({
+        ...prev,
+        from: from?.format(DATE_FORMAT),
+        to: to?.format(DATE_FORMAT),
+      }),
+    });
+  };
+
+  const handleReset = () => {
+    setPendingQuery(null);
+    void navigate({ search: (prev) => ({ sort: prev.sort }) });
+  };
+
+  return (
+    <Flex wrap gap="middle" align="center">
+      <Input
+        allowClear
+        aria-label="Поиск по ФИО"
+        placeholder="Поиск по ФИО"
+        style={{ width: 260 }}
+        value={queryText}
+        onChange={(event) => {
+          handleQueryChange(event.target.value);
+        }}
+      />
+      <Select
+        mode="multiple"
+        virtual={false}
+        allowClear
+        aria-label="Статус"
+        placeholder="Статус"
+        style={{ minWidth: 220 }}
+        options={CLIENT_STATUS_OPTIONS}
+        value={statuses}
+        onChange={handleStatusChange}
+      />
+      <div role="group" aria-label="Период регистрации">
+        <DatePicker.RangePicker
+          allowEmpty={[true, true]}
+          placeholder={["С", "По"]}
+          format={DISPLAY_DATE_FORMAT}
+          value={dateRange}
+          onChange={handleDateChange}
+        />
+      </div>
+      {hasActiveFilters(search) && <Button onClick={handleReset}>Сбросить фильтры</Button>}
+    </Flex>
+  );
+};
