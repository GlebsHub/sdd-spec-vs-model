+import { ClientListResponseSchema, http } from "@/shared/api";
+import type { QueryParams } from "@/shared/api";
+import type { ClientsFilters } from "./types";
+
+export const PAGE_SIZE = 50;
+const CLIENTS_PATH = "/agent/clients";
+
+const toQueryParams = (filters: ClientsFilters, cursor: string | null): QueryParams => ({
+  cursor: cursor ?? undefined,
+  limit: PAGE_SIZE,
+  q: filters.q,
+  status: filters.status?.join(","),
+  dateFrom: filters.dateFrom,
+  dateTo: filters.dateTo,
+  sort: `${filters.sort.field}:${filters.sort.direction}`,
+});
+
+export const fetchClients = (filters: ClientsFilters, cursor: string | null, signal?: AbortSignal) =>
+  http.get(CLIENTS_PATH, {
+    schema: ClientListResponseSchema,
+    params: toQueryParams(filters, cursor),
+    signal,
+  });
