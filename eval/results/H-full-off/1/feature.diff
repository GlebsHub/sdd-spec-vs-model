+import { beforeEach, describe, expect, it } from "vitest";
+import { CLIENT_COLUMN, defaultColumnVisibility } from "./columns";
+import { readColumnVisibility, writeColumnVisibility } from "./columnsStorage";
+
+const KEY = "agent-cabinet:clients-columns:v1:agent-1";
+
+describe("настройки колонок в localStorage", () => {
+  beforeEach(() => {
+    window.localStorage.clear();
+  });
+
+  it("без сохранённых данных возвращает значения по умолчанию", () => {
+    expect(readColumnVisibility("agent-1")).toEqual(defaultColumnVisibility());
+  });
+
+  it("записанные настройки читаются обратно", () => {
+    const visibility = { ...defaultColumnVisibility(), [CLIENT_COLUMN.phoneMasked]: false, [CLIENT_COLUMN.productsCount]: true };
+    writeColumnVisibility("agent-1", visibility);
+    expect(readColumnVisibility("agent-1")).toEqual(visibility);
+  });
+
+  it("настройки разделены по агентам", () => {
+    writeColumnVisibility("agent-1", { ...defaultColumnVisibility(), [CLIENT_COLUMN.phoneMasked]: false });
+    expect(readColumnVisibility("agent-2")).toEqual(defaultColumnVisibility());
+  });
+
+  it("«ФИО» не скрывается, даже если в хранилище записано false", () => {
+    window.localStorage.setItem(KEY, JSON.stringify({ columns: { fullName: false } }));
+    expect(readColumnVisibility("agent-1")[CLIENT_COLUMN.fullName]).toBe(true);
+  });
+
+  it("неизвестные колонки игнорируются", () => {
+    window.localStorage.setItem(KEY, JSON.stringify({ columns: { unknownColumn: false, phoneMasked: false } }));
+    expect(readColumnVisibility("agent-1")).toEqual({ ...defaultColumnVisibility(), [CLIENT_COLUMN.phoneMasked]: false });
+  });
+
+  it.each([
+    ["битый JSON", "{not json"],
+    ["неверная форма", JSON.stringify({ columns: "oops" })],
+  ])("при %s возвращает значения по умолчанию", (_, raw) => {
+    window.localStorage.setItem(KEY, raw);
+    expect(readColumnVisibility("agent-1")).toEqual(defaultColumnVisibility());
+  });
+});
