+import { useState } from "react";
+import { useCurrentAgent } from "@/shared/lib/session";
+import { defaultColumnVisibility } from "./columns";
+import type { ClientColumnId, ColumnVisibility } from "./columns";
+import { readColumnVisibility, writeColumnVisibility } from "./columnsStorage";
+
+export const useColumnVisibility = () => {
+  const { id: agentId } = useCurrentAgent();
+  const [visibility, setVisibility] = useState<ColumnVisibility>(() => readColumnVisibility(agentId));
+
+  const commit = (next: ColumnVisibility): void => {
+    setVisibility(next);
+    writeColumnVisibility(agentId, next);
+  };
+
+  return {
+    visibility,
+    setColumnVisible: (id: ClientColumnId, visible: boolean): void => {
+      commit({ ...visibility, [id]: visible });
+    },
+    resetColumnVisibility: (): void => {
+      commit(defaultColumnVisibility());
+    },
+  };
+};
