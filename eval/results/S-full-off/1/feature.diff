+import { useInfiniteQuery } from "@tanstack/react-query";
+import type { InfiniteData } from "@tanstack/react-query";
+import { isHttpError } from "@/shared/api";
+import type { Client, ClientListResponse } from "@/shared/api";
+import { clientQueries } from "./queries";
+import type { ClientListParams } from "./types";
+
+const selectClients = (data: InfiniteData<ClientListResponse, string | undefined>) => ({
+  clients: data.pages.flatMap((page): Client[] => page.items),
+  total: data.pages.at(-1)?.total ?? 0,
+});
+
+export const useClients = (params: ClientListParams) => {
+  const {
+    data,
+    error,
+    isError,
+    isPlaceholderData,
+    isFetchingNextPage,
+    isFetchNextPageError,
+    hasNextPage,
+    fetchNextPage,
+    refetch,
+  } = useInfiniteQuery({ ...clientQueries.list(params), select: selectClients });
+
+  const hasData = data !== undefined;
+
+  return {
+    clients: data?.clients,
+    total: data?.total,
+    /** Данных ещё нет и нет ошибки: идёт запрос первой порции. */
+    isPending: !hasData && !isError,
+    /** Ошибка первой порции: данных нет. */
+    isError: isError && !hasData,
+    isForbidden: isError && !hasData && isHttpError(error, 403),
+    /** Показанные строки относятся к прежним фильтрам, пока грузятся новые. */
+    isPlaceholderData,
+    isFetchingNextPage,
+    isNextPageError: isFetchNextPageError,
+    hasNextPage,
+    loadMore: () => {
+      void fetchNextPage();
+    },
+    retry: () => {
+      void refetch();
+    },
+  };
+};
