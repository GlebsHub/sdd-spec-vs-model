+import { describe, expect, it } from "vitest";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, SORT_DIRECTION } from "@/shared/api";
+import { CLIENTS_SEARCH_DEFAULTS, clientsSearchSchema, toClientListParams } from "./listParams";
+
+describe("параметры URL раздела клиентов", () => {
+  it("без параметров подставляются значения по умолчанию", () => {
+    expect(clientsSearchSchema.parse({})).toEqual(CLIENTS_SEARCH_DEFAULTS);
+  });
+
+  it("некорректные параметры заменяются значениями по умолчанию, а не ошибкой", () => {
+    expect(
+      clientsSearchSchema.parse({
+        q: 5,
+        status: "LEAD,UNKNOWN",
+        dateFrom: "2026-02-30",
+        dateTo: "вчера",
+        sort: "bogus:asc",
+      }),
+    ).toEqual({ ...CLIENTS_SEARCH_DEFAULTS, status: CLIENT_STATUS.LEAD });
+  });
+
+  it("статусы сортируются в каноническом порядке и не дублируются", () => {
+    const parsed = clientsSearchSchema.parse({ status: "FUNDED,LEAD,FUNDED" });
+    expect(parsed.status).toBe(`${CLIENT_STATUS.LEAD},${CLIENT_STATUS.FUNDED}`);
+  });
+
+  it("допустимая сортировка сохраняется", () => {
+    const parsed = clientsSearchSchema.parse({ sort: `${CLIENT_SORT_FIELD.fullName}:${SORT_DIRECTION.asc}` });
+    expect(parsed.sort).toBe("fullName:asc");
+  });
+
+  it("преобразует параметры в фильтры запроса: поиск обрезается, короткий не отправляется", () => {
+    const filters = toClientListParams({ ...CLIENTS_SEARCH_DEFAULTS, q: "  Иванов  " });
+    expect(filters.q).toBe("Иванов");
+
+    expect(toClientListParams({ ...CLIENTS_SEARCH_DEFAULTS, q: " И " }).q).toBeUndefined();
+  });
+
+  it("статусы и даты переходят в фильтры, пустые значения становятся undefined или пустым списком", () => {
+    const filters = toClientListParams({
+      ...CLIENTS_SEARCH_DEFAULTS,
+      status: `${CLIENT_STATUS.LEAD},${CLIENT_STATUS.INACTIVE}`,
+      dateFrom: "2026-09-01",
+    });
+    expect(filters).toEqual({
+      q: undefined,
+      status: [CLIENT_STATUS.LEAD, CLIENT_STATUS.INACTIVE],
+      dateFrom: "2026-09-01",
+      dateTo: undefined,
+      sort: { field: CLIENT_SORT_FIELD.registeredAt, direction: SORT_DIRECTION.desc },
+    });
+    expect(toClientListParams(CLIENTS_SEARCH_DEFAULTS).status).toEqual([]);
+  });
+});
