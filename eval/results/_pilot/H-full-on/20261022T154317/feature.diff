+
+describe("параметры адреса раздела клиентов", () => {
+  it("без параметров возвращает пустой объект: значения по умолчанию в адрес не пишутся", () => {
+    expect(parseClientsSearch({})).toEqual({});
+  });
+
+  it("сортировка по умолчанию не попадает в адрес, другая сортировка сохраняется", () => {
+    expect(parseClientsSearch({ sort: "registeredAt:desc" })).toEqual({});
+    expect(parseClientsSearch({ sort: "commissionKopecks:asc" })).toEqual({ sort: "commissionKopecks:asc" });
+  });
+
+  it("некорректные значения отбрасываются, а не ломают разбор", () => {
+    expect(
+      parseClientsSearch({
+        q: 42,
+        status: "LEAD,UNKNOWN,FUNDED,LEAD",
+        from: "2026-02-30",
+        to: "2026-03-31",
+        sort: "phoneMasked:asc",
+      }),
+    ).toEqual({ status: "LEAD,FUNDED", to: "2026-03-31" });
+  });
+
+  it("полностью неверный статус и сортировка дают значения по умолчанию", () => {
+    expect(parseClientsSearch({ status: "BOGUS", sort: "registeredAt:up" })).toEqual({});
+  });
+
+  it("пробелы по краям поиска убираются, пустой поиск не сохраняется", () => {
+    expect(parseClientsSearch({ q: "  Иванов " }).q).toBe("Иванов");
+    expect(parseClientsSearch({ q: "   " })).toEqual({});
+  });
+});
+
+describe("перевод адреса в параметры запроса", () => {
+  it("поиск короче 2 символов не попадает в запрос, но остаётся в адресе", () => {
+    const search = parseClientsSearch({ q: "И" });
+    expect(search.q).toBe("И");
+    expect(toListFilters(search)).toEqual({ sort: "registeredAt:desc" });
+  });
+
+  it("from и to переходят в dateFrom и dateTo, статусы в массив", () => {
+    const search = parseClientsSearch({ q: "Иванов", status: "LEAD,FUNDED", from: "2026-01-01", to: "2026-03-31" });
+    expect(toListFilters(search)).toEqual({
+      q: "Иванов",
+      status: ["LEAD", "FUNDED"],
+      dateFrom: "2026-01-01",
+      dateTo: "2026-03-31",
+      sort: "registeredAt:desc",
+    });
+  });
+
+  it("сортировка по умолчанию читается без адресного значения", () => {
+    expect(sortFromSearch({})).toEqual({ field: "registeredAt", direction: "desc" });
+    expect(sortFromSearch({ sort: "fullName:asc" })).toEqual({ field: "fullName", direction: "asc" });
+  });
+
+  it("состояние сортировки по умолчанию не пишется в адрес", () => {
+    expect(sortToSearch({ field: "registeredAt", direction: "desc" })).toBeUndefined();
+    expect(sortToSearch({ field: "registeredAt", direction: "asc" })).toBe("registeredAt:asc");
+  });
+});
diff --git a/src/entities/client/searchParams.ts b/src/entities/client/searchParams.ts
new file mode 100644
index 0000000..d897842
--- /dev/null
+++ b/src/entities/client/searchParams.ts
@@ -0,0 +1,121 @@
+import { z } from "zod";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS, SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/shared/api";
+
+export const MIN_QUERY_LENGTH = 2;
+
+export type SortState = { field: ClientSortField; direction: SortDirection };
+
+const DEFAULT_SORT_STATE: SortState = { field: CLIENT_SORT_FIELD.registeredAt, direction: SORT_DIRECTION.desc };
+
+const formatSort = ({ field, direction }: SortState): string => `${field}:${direction}`;
+
+export const DEFAULT_SORT = formatSort(DEFAULT_SORT_STATE);
+
+/** Параметры адреса в виде строк: так их видно в ссылке. Значения по умолчанию отсутствуют. */
+export type ClientsSearch = {
+  q?: string;
+  status?: string;
+  from?: string;
+  to?: string;
+  sort?: string;
+};
+
+/** Параметры списка, от которых зависит ответ. Из них строится query-ключ. */
+export type ClientListFilters = {
+  q?: string;
+  status?: ClientStatus[];
+  dateFrom?: string;
+  dateTo?: string;
+  sort: string;
+};
+
+const SearchInputSchema = z.object({
+  q: z.string().optional().catch(undefined),
+  status: z.string().optional().catch(undefined),
+  from: z.string().optional().catch(undefined),
+  to: z.string().optional().catch(undefined),
+  sort: z.string().optional().catch(undefined),
+});
+
+const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
+
+const isCalendarDate = (value: string): boolean => {
+  if (!DATE_RE.test(value)) {
+    return false;
+  }
+  const date = new Date(`${value}T00:00:00.000Z`);
+  return !Number.isNaN(date.getTime()) && date.toISOString().slice(0, 10) === value;
+};
+
+const isStatus = (value: string): value is ClientStatus => Object.hasOwn(CLIENT_STATUS, value);
+const isSortField = (value: string): value is ClientSortField => Object.hasOwn(CLIENT_SORT_FIELD, value);
+const isDirection = (value: string): value is SortDirection => Object.hasOwn(SORT_DIRECTION, value);
+
+const parseSort = (raw: string): SortState | undefined => {
+  const [field = "", direction = "", ...extra] = raw.split(":");
+  if (!isSortField(field) || !isDirection(direction) || extra.length > 0) {
+    return undefined;
+  }
+  return { field, direction };
+};
+
+const sortToSearch = (state: SortState): string | undefined => {
+  const text = formatSort(state);
+  return text === DEFAULT_SORT ? undefined : text;
+};
+
+const parseStatuses = (raw: string | undefined): ClientStatus[] =>
+  [...new Set((raw ?? "").split(",").filter(isStatus))];
+
+const normalizeSearchText = (raw: string | undefined): string | undefined => {
+  const trimmed = raw?.trim();
+  return trimmed ? trimmed : undefined;
+};
+
+const normalizeDate = (raw: string | undefined): string | undefined =>
+  raw !== undefined && isCalendarDate(raw) ? raw : undefined;
+
+/**
+ * Разбирает параметры адреса. Некорректные значения отбрасываются и не приводят к ошибке страницы.
+ * Значения по умолчанию в результат не попадают.
+ */
+export const parseClientsSearch = (raw: unknown): ClientsSearch => {
+  const input = SearchInputSchema.parse(raw);
+  const statuses = parseStatuses(input.status);
+  const parsedSort = input.sort === undefined ? undefined : parseSort(input.sort);
+  // Роутер сливает результат с сырым адресом, поэтому отброшенные ключи нужно явно вернуть как undefined.
+  return {
+    q: normalizeSearchText(input.q),
+    status: statuses.length > 0 ? statuses.join(",") : undefined,
+    from: normalizeDate(input.from),
+    to: normalizeDate(input.to),
+    sort: parsedSort === undefined ? undefined : sortToSearch(parsedSort),
+  };
+};
+
+export const statusesFromSearch = (search: ClientsSearch): ClientStatus[] => parseStatuses(search.status);
+
+export const sortFromSearch = (search: ClientsSearch): SortState =>
+  (search.sort === undefined ? undefined : parseSort(search.sort)) ?? DEFAULT_SORT_STATE;
+
+export { sortToSearch };
+
+/** Текст поиска, который уходит в запрос: от 2 символов. */
+export const queryFromSearch = (search: ClientsSearch): string | undefined =>
+  search.q !== undefined && search.q.length >= MIN_QUERY_LENGTH ? search.q : undefined;
+
+export const toListFilters = (search: ClientsSearch): ClientListFilters => {
+  const q = queryFromSearch(search);
+  const statuses = statusesFromSearch(search);
+  return {
+    ...(q !== undefined && { q }),
+    ...(statuses.length > 0 && { status: statuses }),
+    ...(search.from !== undefined && { dateFrom: search.from }),
+    ...(search.to !== undefined && { dateTo: search.to }),
+    sort: search.sort ?? DEFAULT_SORT,
+  };
+};
+
+export const hasActiveFilters = (search: ClientsSearch): boolean =>
+  search.q !== undefined || search.status !== undefined || search.from !== undefined || search.to !== undefined;
