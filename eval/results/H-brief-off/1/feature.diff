+import { act, renderHook } from "@testing-library/react";
+import { describe, expect, it, vi } from "vitest";
+import { useColumnVisibility } from "./useColumnVisibility";
+
+const STORAGE_KEY = "agent-cabinet:clients-columns:v1:agent-1";
+const ALL_VISIBLE = { phoneMasked: true, status: true, registeredAt: true, commissionKopecks: true };
+
+describe("видимость колонок", () => {
+  it("по умолчанию видны все колонки", () => {
+    const { result } = renderHook(() => useColumnVisibility("agent-1"));
+    expect(result.current.columnVisibility).toEqual(ALL_VISIBLE);
+  });
+
+  it("скрытые колонки читаются из localStorage", () => {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify({ hidden: ["status"] }));
+    const { result } = renderHook(() => useColumnVisibility("agent-1"));
+    expect(result.current.columnVisibility.status).toBe(false);
+    expect(result.current.columnVisibility.phoneMasked).toBe(true);
+  });
+
+  it("неизвестная колонка в сохранённых данных даёт значение по умолчанию", () => {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify({ hidden: ["status", "unknownColumn"] }));
+    const { result } = renderHook(() => useColumnVisibility("agent-1"));
+    expect(result.current.columnVisibility).toEqual(ALL_VISIBLE);
+  });
+
+  it("битый JSON даёт значение по умолчанию", () => {
+    window.localStorage.setItem(STORAGE_KEY, "{не json");
+    const { result } = renderHook(() => useColumnVisibility("agent-1"));
+    expect(result.current.columnVisibility).toEqual(ALL_VISIBLE);
+  });
+
+  it("недоступное хранилище не ломает хук", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new DOMException("denied", "SecurityError");
+    });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new DOMException("denied", "SecurityError");
+    });
+    const { result } = renderHook(() => useColumnVisibility("agent-1"));
+    expect(() => {
+      act(() => {
+        result.current.setColumnVisible("status", false);
+      });
+    }).not.toThrow();
+    expect(result.current.columnVisibility.status).toBe(false);
+  });
+
+  it("настройка сохраняется отдельно для каждого агента", () => {
+    const first = renderHook(() => useColumnVisibility("agent-1"));
+    act(() => {
+      first.result.current.setColumnVisible("registeredAt", false);
+    });
+    first.unmount();
+
+    expect(renderHook(() => useColumnVisibility("agent-1")).result.current.columnVisibility.registeredAt).toBe(false);
+    expect(renderHook(() => useColumnVisibility("agent-2")).result.current.columnVisibility.registeredAt).toBe(true);
+  });
+
+  it("ФИО нельзя скрыть", () => {
+    const { result } = renderHook(() => useColumnVisibility("agent-1"));
+    act(() => {
+      result.current.setColumnVisible("fullName", false);
+    });
+    expect(window.localStorage.getItem(STORAGE_KEY)).toBeNull();
+    expect(result.current.columnVisibility).not.toHaveProperty("fullName");
+  });
+});
