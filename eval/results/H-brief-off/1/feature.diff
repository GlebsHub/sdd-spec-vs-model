+import { infiniteQueryOptions } from "@tanstack/react-query";
+import { clientKeys } from "@/shared/api";
+import { fetchClients } from "./api";
+import type { ClientListFilters } from "./listParams";
+
+/** Дольше, чем типичный уход на карточку и «назад»: тогда список возвращается из кэша без запроса. */
+const LIST_STALE_TIME = 5 * 60 * 1000;
+
+const initialPageParam: string | undefined = undefined;
+
+export const clientQueries = {
+  list: (filters: ClientListFilters) =>
+    infiniteQueryOptions({
+      queryKey: clientKeys.list(filters),
+      queryFn: ({ pageParam, signal }) => fetchClients({ ...filters, cursor: pageParam, signal }),
+      initialPageParam,
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+      staleTime: LIST_STALE_TIME,
+    }),
+};
