index 0000000..f19442b
--- /dev/null
+++ b/src/app/searchParams.ts
@@ -0,0 +1,27 @@
+/**
+ * Сериализация параметров адресной строки.
+ * Значения — строки, массивы пишутся через запятую, `,` и `:` не экранируются:
+ * `?status=LEAD,FUNDED&sort=commissionKopecks:asc` (спецификация, п. 9.1).
+ * Разбор значений (типы, значения по умолчанию, мусор) выполняет `validateSearch` маршрута.
+ */
+
+const encode = (value: string): string => encodeURIComponent(value).replace(/%2C/gi, ",").replace(/%3A/gi, ":");
+
+export const parseSearch = (searchStr: string): Record<string, unknown> => {
+  const result: Record<string, unknown> = {};
+  for (const [key, value] of new URLSearchParams(searchStr)) {
+    result[key] = value;
+  }
+  return result;
+};
+
+export const stringifySearch = (search: Record<string, unknown>): string => {
+  const parts: string[] = [];
+  for (const [key, value] of Object.entries(search)) {
+    const text = Array.isArray(value) ? value.map(String).join(",") : typeof value === "string" ? value : undefined;
+    if (text !== undefined && text !== "") {
+      parts.push(`${encodeURIComponent(key)}=${encode(text)}`);
+    }
+  }
+  return parts.length > 0 ? `?${parts.join("&")}` : "";
+};
