+import { infiniteQueryOptions } from "@tanstack/react-query";
+import { clientKeys } from "@/shared/api";
+import { fetchClientsPage } from "./api";
+import type { ClientListParams } from "./api";
+
+const LIST_STALE_TIME = 5 * 60 * 1000;
+
+export const clientQueries = {
+  list: (agentId: string, params: ClientListParams) =>
+    infiniteQueryOptions({
+      queryKey: clientKeys.list({ agentId, ...params }),
+      queryFn: ({ pageParam, signal }) => fetchClientsPage(params, pageParam, signal),
+      initialPageParam: undefined as string | undefined,
+      getNextPageParam: (lastPage) => lastPage.nextCursor ?? undefined,
+      staleTime: LIST_STALE_TIME,
+    }),
+};
