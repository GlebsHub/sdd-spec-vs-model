+++ b/src/widgets/clients-table/useColumnVisibility.ts
@@ -0,0 +1,52 @@
+import { useState } from "react";
+import { z } from "zod";
+import { HIDEABLE_COLUMN_IDS } from "./columns";
+import type { HideableColumnId } from "./columns";
+
+const STORAGE_KEY_PREFIX = "agent-cabinet:clients-columns:v1";
+
+const StoredColumnsSchema = z.object({
+  hidden: z.array(z.enum(HIDEABLE_COLUMN_IDS)),
+});
+
+const isHideableColumnId = (id: string): id is HideableColumnId =>
+  (HIDEABLE_COLUMN_IDS as readonly string[]).includes(id);
+
+const readHiddenColumns = (storageKey: string): HideableColumnId[] => {
+  try {
+    const raw = window.localStorage.getItem(storageKey);
+    if (raw === null) {
+      return [];
+    }
+    const parsed = StoredColumnsSchema.safeParse(JSON.parse(raw));
+    return parsed.success ? parsed.data.hidden : [];
+  } catch {
+    return [];
+  }
+};
+
+const writeHiddenColumns = (storageKey: string, hidden: HideableColumnId[]): void => {
+  try {
+    window.localStorage.setItem(storageKey, JSON.stringify({ hidden }));
+  } catch {
+    // Хранилище недоступно: настройка действует до перезагрузки страницы.
+  }
+};
+
+export const useColumnVisibility = (agentId: string) => {
+  const storageKey = `${STORAGE_KEY_PREFIX}:${agentId}`;
+  const [hidden, setHidden] = useState<HideableColumnId[]>(() => readHiddenColumns(storageKey));
+
+  const setColumnVisible = (id: string, visible: boolean) => {
+    if (!isHideableColumnId(id)) {
+      return;
+    }
+    const next = visible ? hidden.filter((item) => item !== id) : [...hidden.filter((item) => item !== id), id];
+    setHidden(next);
+    writeHiddenColumns(storageKey, next);
+  };
+
+  const columnVisibility = Object.fromEntries(HIDEABLE_COLUMN_IDS.map((id) => [id, !hidden.includes(id)]));
+
+  return { columnVisibility, setColumnVisible };
+};
