+import { SearchOutlined } from "@ant-design/icons";
+import { Button, DatePicker, Flex, Input, Select } from "antd";
+import dayjs from "dayjs";
+import { useEffect, useRef, useState } from "react";
+import { CLIENT_STATUS, CLIENT_STATUS_LABEL, hasActiveFilters, toClientsFilters } from "@/entities/client";
+import type { ClientStatus, ClientsSearch } from "@/entities/client";
+
+const SEARCH_DEBOUNCE_MS = 300;
+const DATE_FORMAT_URL = "YYYY-MM-DD";
+const DATE_FORMAT_VIEW = "DD.MM.YYYY";
+
+const STATUS_OPTIONS = Object.values(CLIENT_STATUS).map((status) => ({
+  value: status,
+  label: CLIENT_STATUS_LABEL[status],
+}));
+
+export type ClientsFiltersProps = {
+  search: ClientsSearch;
+  onSearchChange: (patch: Partial<ClientsSearch>) => void;
+  onReset: () => void;
+};
+
+export const ClientsFilters = ({ search, onSearchChange, onReset }: ClientsFiltersProps) => {
+  const filters = toClientsFilters(search);
+  const [text, setText] = useState(search.q ?? "");
+  const [syncedQuery, setSyncedQuery] = useState(search.q);
+  const timerRef = useRef<number | undefined>(undefined);
+
+  // Адрес мог измениться извне (например, «Сбросить фильтры»); свой ввод не перезаписываем.
+  if (search.q !== syncedQuery) {
+    setSyncedQuery(search.q);
+    if ((search.q ?? "") !== text.trim()) {
+      setText(search.q ?? "");
+    }
+  }
+
+  useEffect(() => () => window.clearTimeout(timerRef.current), []);
+
+  const handleTextChange = (value: string) => {
+    setText(value);
+    window.clearTimeout(timerRef.current);
+    timerRef.current = window.setTimeout(() => {
+      onSearchChange({ q: value.trim() || undefined });
+    }, SEARCH_DEBOUNCE_MS);
+  };
+
+  const handleStatusChange = (values: ClientStatus[]) => {
+    onSearchChange({ status: values.length > 0 ? [...values].sort().join(",") : undefined });
+  };
+
+  const handleDateChange = (dates: [dayjs.Dayjs | null, dayjs.Dayjs | null] | null) => {
+    onSearchChange({
+      from: dates?.[0]?.format(DATE_FORMAT_URL),
+      to: dates?.[1]?.format(DATE_FORMAT_URL),
+    });
+  };
+
+  return (
+    <Flex wrap gap="middle" align="center">
+      <Input
+        aria-label="Поиск по ФИО"
+        placeholder="Поиск по ФИО"
+        prefix={<SearchOutlined aria-hidden />}
+        allowClear
+        value={text}
+        onChange={(event) => {
+          handleTextChange(event.target.value);
+        }}
+        style={{ width: 240 }}
+      />
+      <Select
+        aria-label="Статус"
+        mode="multiple"
+        placeholder="Статус"
+        allowClear
+        virtual={false}
+        options={STATUS_OPTIONS}
+        value={filters.status ?? []}
+        onChange={handleStatusChange}
+        style={{ minWidth: 240 }}
+      />
+      <DatePicker.RangePicker
+        aria-label="Период регистрации"
+        placeholder={["Регистрация с", "Регистрация по"]}
+        allowEmpty={[true, true]}
+        format={DATE_FORMAT_VIEW}
+        value={[search.from ? dayjs(search.from) : null, search.to ? dayjs(search.to) : null]}
+        onChange={handleDateChange}
+      />
+      {hasActiveFilters(filters) && (
+        <Button
+          type="link"
+          onClick={() => {
+            window.clearTimeout(timerRef.current);
+            onReset();
+          }}
+        >
+          Сбросить фильтры
+        </Button>
+      )}
+    </Flex>
+  );
+};
