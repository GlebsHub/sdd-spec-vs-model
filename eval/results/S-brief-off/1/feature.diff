+import { describe, expect, it } from "vitest";
+import { toClientListParams } from "./params";
+import { ClientsSearchSchema } from "./schema";
+
+const parse = (raw: unknown) => ClientsSearchSchema.parse(raw);
+
+describe("схема параметров URL /clients", () => {
+  it("пустой адрес даёт значения по умолчанию", () => {
+    expect(parse({})).toEqual({ q: "", status: [], sort: "registeredAt", dir: "desc" });
+  });
+
+  it("мусор на входе заменяется значениями по умолчанию, страница не падает", () => {
+    const result = parse({ q: { a: 1 }, status: 5, dateFrom: "вчера", dateTo: 20250101, sort: "hack", dir: "up" });
+    expect(result).toEqual({ q: "", status: [], sort: "registeredAt", dir: "desc" });
+  });
+
+  it("корректные значения сохраняются", () => {
+    const result = parse({
+      q: "Иванов",
+      status: ["FUNDED"],
+      dateFrom: "2025-01-01",
+      dateTo: "2025-12-31",
+      sort: "fullName",
+      dir: "asc",
+    });
+    expect(result).toEqual({
+      q: "Иванов",
+      status: ["FUNDED"],
+      dateFrom: "2025-01-01",
+      dateTo: "2025-12-31",
+      sort: "fullName",
+      dir: "asc",
+    });
+  });
+
+  describe("поиск", () => {
+    it("обрезает пробелы", () => {
+      expect(parse({ q: "  Иванов " }).q).toBe("Иванов");
+    });
+
+    it("короче двух символов считается пустым", () => {
+      expect(parse({ q: " а " }).q).toBe("");
+    });
+
+    it("число из адреса (?q=123) превращается в строку", () => {
+      expect(parse({ q: 123 }).q).toBe("123");
+    });
+  });
+
+  describe("статусы", () => {
+    it("принимает список через запятую и приводит к порядку воронки без повторов", () => {
+      expect(parse({ status: "FUNDED,LEAD,FUNDED" }).status).toEqual(["LEAD", "FUNDED"]);
+    });
+
+    it("принимает массив", () => {
+      expect(parse({ status: ["INACTIVE", "ACCOUNT_OPENED"] }).status).toEqual(["ACCOUNT_OPENED", "INACTIVE"]);
+    });
+
+    it("неизвестный статус делает весь параметр некорректным", () => {
+      expect(parse({ status: "LEAD,FOO" }).status).toEqual([]);
+      expect(parse({ status: "" }).status).toEqual([]);
+    });
+  });
+
+  describe("даты", () => {
+    it("несуществующая дата отбрасывается", () => {
+      expect(parse({ dateFrom: "2025-02-30" }).dateFrom).toBeUndefined();
+    });
+
+    it("допустима только одна граница", () => {
+      expect(parse({ dateFrom: "2025-01-01" })).toMatchObject({ dateFrom: "2025-01-01", dateTo: undefined });
+    });
+
+    it("диапазон с началом позже конца сбрасывается целиком", () => {
+      const result = parse({ dateFrom: "2025-12-31", dateTo: "2025-01-01" });
+      expect(result.dateFrom).toBeUndefined();
+      expect(result.dateTo).toBeUndefined();
+    });
+  });
+});
+
+describe("toClientListParams", () => {
+  it("пустые фильтры не попадают в параметры запроса", () => {
+    expect(toClientListParams(parse({}))).toEqual({ sort: { field: "registeredAt", direction: "desc" } });
+  });
+
+  it("переносит фильтры и сортировку", () => {
+    const params = toClientListParams(
+      parse({ q: "Иванов", status: "LEAD", dateFrom: "2025-01-01", sort: "commissionKopecks", dir: "asc" }),
+    );
+    expect(params).toEqual({
+      q: "Иванов",
+      status: ["LEAD"],
+      dateFrom: "2025-01-01",
+      sort: { field: "commissionKopecks", direction: "asc" },
+    });
+  });
+});
diff --git a/src/features/client-filters/schema.ts b/src/features/client-filters/schema.ts
new file mode 100644
index 0000000..4c6ee1b
--- /dev/null
+++ b/src/features/client-filters/schema.ts
@@ -0,0 +1,53 @@
+import type { SearchSchemaInput } from "@tanstack/react-router";
+import { z } from "zod";
+import { CLIENT_SORT_FIELD, CLIENT_STATUS_ORDER, ClientStatusSchema, MIN_QUERY_LENGTH, SORT_DIRECTION } from "@/entities/client";
+import type { ClientSortField, ClientStatus, SortDirection } from "@/entities/client";
+import type { ClientsSearch, ClientsSearchInput } from "./types";
+
+export const DEFAULT_SORT_FIELD = CLIENT_SORT_FIELD.registeredAt;
+export const DEFAULT_SORT_DIRECTION = SORT_DIRECTION.desc;
+
+/** Роутер разбирает значения URL как JSON, поэтому `?q=123` приходит числом. */
+const QuerySchema = z
+  .union([z.string(), z.number()])
+  .transform((value) => String(value).trim())
+  .transform((value) => (value.length >= MIN_QUERY_LENGTH ? value : ""))
+  .catch("");
+
+const StatusListSchema = z
+  .preprocess((value) => (typeof value === "string" ? value.split(",") : value), z.array(ClientStatusSchema))
+  .transform((statuses) => CLIENT_STATUS_ORDER.filter((status) => statuses.includes(status)))
+  .catch([]);
+
+const DateSchema = z.iso.date().optional().catch(undefined);
+
+/**
+ * Параметры URL страницы `/clients`. Любое некорректное значение заменяется значением по умолчанию.
+ * Диапазон дат с `dateFrom` позже `dateTo` считается некорректным целиком.
+ */
+export const ClientsSearchSchema = z
+  .object({
+    q: QuerySchema,
+    status: StatusListSchema,
+    dateFrom: DateSchema,
+    dateTo: DateSchema,
+    sort: z.enum(CLIENT_SORT_FIELD).catch(DEFAULT_SORT_FIELD),
+    dir: z.enum(SORT_DIRECTION).catch(DEFAULT_SORT_DIRECTION),
+  })
+  .transform((search) =>
+    search.dateFrom !== undefined && search.dateTo !== undefined && search.dateFrom > search.dateTo
+      ? { ...search, dateFrom: undefined, dateTo: undefined }
+      : search,
+  );
+
+/** Значения по умолчанию, которые не пишутся в URL. Даты не заданы по умолчанию и просто отсутствуют. */
+export const CLIENTS_SEARCH_DEFAULTS: { q: string; status: ClientStatus[]; sort: ClientSortField; dir: SortDirection } = {
+  q: "",
+  status: [],
+  sort: DEFAULT_SORT_FIELD,
+  dir: DEFAULT_SORT_DIRECTION,
+};
+
+/** `SearchSchemaInput` делает все параметры необязательными в типах ссылок и `navigate`. */
+export const validateClientsSearch = (search: ClientsSearchInput & SearchSchemaInput): ClientsSearch =>
+  ClientsSearchSchema.parse(search);
