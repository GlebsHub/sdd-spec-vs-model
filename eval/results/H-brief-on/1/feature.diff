+++ b/src/widgets/clients-table/columns.tsx
@@ -0,0 +1,54 @@
+import { createColumnHelper } from "@tanstack/react-table";
+import { Button } from "antd";
+import { CLIENT_COLUMN, CLIENT_SORT_FIELD } from "@/entities/client";
+import type { Client, ClientColumnId, ClientSortField } from "@/entities/client";
+import { formatMoney } from "@/shared/lib/money";
+import { ClientStatusTag } from "./ClientStatusTag";
+
+export const SORT_FIELD_BY_COLUMN: Partial<Record<ClientColumnId, ClientSortField>> = {
+  [CLIENT_COLUMN.fullName]: CLIENT_SORT_FIELD.fullName,
+  [CLIENT_COLUMN.registeredAt]: CLIENT_SORT_FIELD.registeredAt,
+  [CLIENT_COLUMN.commission]: CLIENT_SORT_FIELD.commissionKopecks,
+};
+
+export const COLUMN_TRACK: Record<ClientColumnId, string> = {
+  [CLIENT_COLUMN.fullName]: "minmax(200px, 2fr)",
+  [CLIENT_COLUMN.phone]: "minmax(140px, 1fr)",
+  [CLIENT_COLUMN.status]: "minmax(150px, 1fr)",
+  [CLIENT_COLUMN.registeredAt]: "minmax(120px, 1fr)",
+  [CLIENT_COLUMN.commission]: "minmax(140px, 1fr)",
+};
+
+/** Дата приходит ISO-строкой; показывается календарная дата, по которой работает фильтр. */
+const formatCalendarDate = (isoDateTime: string): string => {
+  const [year, month, day] = isoDateTime.slice(0, 10).split("-");
+  return `${day ?? ""}.${month ?? ""}.${year ?? ""}`;
+};
+
+/** Идентификаторы колонок задаются только здесь, из CLIENT_COLUMN, поэтому приведение безопасно. */
+export const asClientColumnId = (id: string): ClientColumnId => id as ClientColumnId;
+
+const helper = createColumnHelper<Client>();
+
+export const clientColumns = [
+  helper.accessor("fullName", {
+    id: CLIENT_COLUMN.fullName,
+    cell: (info) => <Button type="link">{info.getValue()}</Button>,
+  }),
+  helper.accessor("phoneMasked", {
+    id: CLIENT_COLUMN.phone,
+    cell: (info) => info.getValue(),
+  }),
+  helper.accessor("status", {
+    id: CLIENT_COLUMN.status,
+    cell: (info) => <ClientStatusTag status={info.getValue()} />,
+  }),
+  helper.accessor("registeredAt", {
+    id: CLIENT_COLUMN.registeredAt,
+    cell: (info) => formatCalendarDate(info.getValue()),
+  }),
+  helper.accessor("commissionKopecks", {
+    id: CLIENT_COLUMN.commission,
+    cell: (info) => formatMoney(info.getValue()),
+  }),
+];
