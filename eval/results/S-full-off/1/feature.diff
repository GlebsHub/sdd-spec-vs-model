+import { describe, expect, it } from "vitest";
+import { hasActiveFilters, nextSort, parseClientsSearch, resolveSort, toListParams } from "./search";
+
+describe("parseClientsSearch (AC-10)", () => {
+  it("пустой адрес даёт значения по умолчанию", () => {
+    expect(parseClientsSearch({})).toEqual({});
+    expect(parseClientsSearch(undefined)).toEqual({});
+  });
+
+  it("разбирает корректные параметры", () => {
+    expect(
+      parseClientsSearch({
+        q: "Иванов",
+        status: "LEAD,FUNDED",
+        from: "2026-01-01",
+        to: "2026-03-31",
+        sort: "commissionKopecks:asc",
+      }),
+    ).toEqual({
+      q: "Иванов",
+      status: ["LEAD", "FUNDED"],
+      from: "2026-01-01",
+      to: "2026-03-31",
+      sort: "commissionKopecks:asc",
+    });
+  });
+
+  it("игнорирует мусор и не бросает", () => {
+    expect(
+      parseClientsSearch({
+        q: 42,
+        status: "BOGUS",
+        from: "2026-13-45",
+        to: "вчера",
+        sort: "unknown:asc",
+      }),
+    ).toEqual({});
+    expect(parseClientsSearch({ sort: "fullName:sideways" })).toEqual({});
+    expect(parseClientsSearch({ sort: "fullName:asc:extra" })).toEqual({});
+    expect(parseClientsSearch({ from: "2026-02-30" })).toEqual({});
+  });
+
+  it("поиск короче двух символов после trim не применяется", () => {
+    expect(parseClientsSearch({ q: "и" })).toEqual({});
+    expect(parseClientsSearch({ q: "  и  " })).toEqual({});
+    expect(parseClientsSearch({ q: "  Ив  " })).toEqual({ q: "Ив" });
+  });
+
+  it("неизвестные статусы отбрасываются, известные остаются в порядке спецификации без дублей", () => {
+    expect(parseClientsSearch({ status: "FUNDED,BOGUS,LEAD,FUNDED" }).status).toEqual(["LEAD", "FUNDED"]);
+  });
+
+  it("сортировка по умолчанию трактуется как «не задана»", () => {
+    expect(parseClientsSearch({ sort: "registeredAt:desc" })).toEqual({});
+    expect(parseClientsSearch({ sort: "registeredAt:asc" })).toEqual({ sort: "registeredAt:asc" });
+  });
+});
+
+describe("toListParams", () => {
+  it("переименовывает from/to в dateFrom/dateTo", () => {
+    expect(toListParams({ q: "Иван", status: ["LEAD"], from: "2026-01-01", to: "2026-02-01", sort: "fullName:asc" })).toEqual({
+      q: "Иван",
+      status: ["LEAD"],
+      dateFrom: "2026-01-01",
+      dateTo: "2026-02-01",
+      sort: "fullName:asc",
+    });
+  });
+});
+
+describe("hasActiveFilters (AC-05)", () => {
+  it("сортировка фильтром не считается", () => {
+    expect(hasActiveFilters({})).toBe(false);
+    expect(hasActiveFilters({ sort: "fullName:asc" })).toBe(false);
+  });
+
+  it("любой из фильтров делает их активными", () => {
+    expect(hasActiveFilters({ q: "Иван" })).toBe(true);
+    expect(hasActiveFilters({ status: ["LEAD"] })).toBe(true);
+    expect(hasActiveFilters({ from: "2026-01-01" })).toBe(true);
+    expect(hasActiveFilters({ to: "2026-01-01" })).toBe(true);
+  });
+});
+
+describe("nextSort (AC-07)", () => {
+  it("не отсортированная колонка → desc", () => {
+    expect(nextSort(resolveSort(undefined), "commissionKopecks")).toBe("commissionKopecks:desc");
+  });
+
+  it("desc → asc, asc → desc", () => {
+    expect(nextSort(resolveSort("commissionKopecks:desc"), "commissionKopecks")).toBe("commissionKopecks:asc");
+    expect(nextSort(resolveSort("commissionKopecks:asc"), "commissionKopecks")).toBe("commissionKopecks:desc");
+  });
+
+  it("сортировка по умолчанию не пишется в URL", () => {
+    expect(nextSort(resolveSort("registeredAt:asc"), "registeredAt")).toBeUndefined();
+    expect(nextSort(resolveSort("fullName:asc"), "registeredAt")).toBeUndefined();
+  });
+
+  it("по умолчанию отсортировано по дате регистрации по убыванию", () => {
+    expect(resolveSort(undefined)).toEqual({ field: "registeredAt", direction: "desc" });
+    expect(nextSort(resolveSort(undefined), "registeredAt")).toBe("registeredAt:asc");
+  });
+});
diff --git a/src/entities/client/search.ts b/src/entities/client/search.ts
new file mode 100644
index 0000000..3c53a93
--- /dev/null
+++ b/src/entities/client/search.ts
@@ -0,0 +1,40 @@
+import { SORT_DIRECTION } from "@/shared/api";
+import type { ClientSortField, SortDirection } from "@/shared/api";
+import { DEFAULT_SORT } from "./constants";
+import { ClientsSearchSchema, toSortParam } from "./schema";
+import type { ClientListParams, ClientsSearch } from "./types";
+
+export type ResolvedSort = { field: ClientSortField; direction: SortDirection };
+
+/** Разбор параметров адресной строки. Не бросает: мусор превращается в «не задано». */
+export const parseClientsSearch = (raw: unknown): ClientsSearch => ClientsSearchSchema.parse(raw ?? {});
+
+/** Параметры адресной строки → параметры запроса API: `from → dateFrom`, `to → dateTo`. */
+export const toListParams = ({ q, status, from, to, sort }: ClientsSearch): ClientListParams => ({
+  q,
+  status,
+  dateFrom: from,
+  dateTo: to,
+  sort,
+});
+
+/** Задан ли хотя бы один фильтр. Сортировка фильтром не считается. */
+export const hasActiveFilters = ({ q, status, from, to }: ClientsSearch): boolean =>
+  q !== undefined || status !== undefined || from !== undefined || to !== undefined;
+
+/** Сортировка из URL; `sort` в схеме уже проверен, поэтому разбор строки безопасен. */
+export const resolveSort = (sort: ClientsSearch["sort"]): ResolvedSort => {
+  if (sort === undefined) {
+    return DEFAULT_SORT;
+  }
+  const [field, direction] = sort.split(":") as [ClientSortField, SortDirection]; // формат гарантирует ClientsSearchSchema
+  return { field, direction };
+};
+
+/** Сортировка после клика по заголовку: не отсортирована → desc, desc → asc, asc → desc (спецификация, п. 6). */
+export const nextSort = (current: ResolvedSort, field: ClientSortField): ClientsSearch["sort"] => {
+  const direction =
+    current.field === field && current.direction === SORT_DIRECTION.desc ? SORT_DIRECTION.asc : SORT_DIRECTION.desc;
+  const isDefault = field === DEFAULT_SORT.field && direction === DEFAULT_SORT.direction;
+  return isDefault ? undefined : toSortParam(field, direction);
+};
