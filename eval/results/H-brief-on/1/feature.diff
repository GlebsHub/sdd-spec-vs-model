+import { useInfiniteQuery, keepPreviousData } from "@tanstack/react-query";
+import { useCurrentAgent } from "@/shared/lib/session";
+import { clientQueries } from "./queries";
+import type { ClientListParams } from "./api";
+
+export const useClients = (params: ClientListParams) => {
+  const { id: agentId } = useCurrentAgent();
+  const { data, isPending, isError, hasNextPage, isFetchingNextPage, isFetchNextPageError, fetchNextPage, refetch } =
+    useInfiniteQuery({
+      ...clientQueries.list(agentId, params),
+      placeholderData: keepPreviousData,
+    });
+
+  const clients = data?.pages.flatMap((page) => page.items) ?? [];
+  const total = data?.pages[0]?.total;
+
+  return {
+    clients,
+    total,
+    isPending,
+    isError,
+    hasNextPage,
+    isFetchingNextPage,
+    isFetchNextPageError,
+    fetchNextPage: () => fetchNextPage(),
+    retry: () => refetch(),
+  };
+};
